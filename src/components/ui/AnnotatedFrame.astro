---
/*
  AnnotatedFrame — annotated imagery (signature element 2).
  Registration ticks, SVG bounding boxes that draw in, mono labels,
  caption bar, optional crosshair coordinate readout (B2) and optional
  thermal reveal (B1) when a thermal variant is supplied.
  Honesty: callers must pass captions labeled DEMONSTRATION ANALYSIS.
*/
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import type { Annotation, FrameMeta } from '../../lib/annotations';
import { boxPerimeter } from '../../lib/annotations';

interface Props {
  image: ImageMetadata;
  alt: string;
  annotations?: Annotation[];
  meta: FrameMeta;
  /** Optional thermal layer for the B1 scan reveal */
  thermalImage?: ImageMetadata;
  /** Enable pointer coordinate readout */
  crosshair?: boolean;
  loading?: 'eager' | 'lazy';
  class?: string;
}

const {
  image,
  alt,
  annotations = [],
  meta,
  thermalImage,
  crosshair = false,
  loading = 'lazy',
  class: className = '',
} = Astro.props;

const VW = 1000;
const VH = Math.round((VW * image.height) / image.width);
---

<figure class={`m-0 ${className}`}>
  <div
    class={`relative ${thermalImage ? 'thermal-reveal' : ''} ${crosshair ? 'cursor-crosshair' : ''}`}
    data-frame
    data-geo={meta.geo ? JSON.stringify(meta.geo) : undefined}
  >
    <Picture
      src={image}
      alt={alt}
      formats={['avif', 'webp']}
      widths={[480, 800, 1200, 1600]}
      sizes="(max-width: 768px) 100vw, (max-width: 1360px) 90vw, 1280px"
      loading={loading}
      fetchpriority={loading === 'eager' ? 'high' : 'auto'}
      class="w-full"
    />

    {thermalImage && (
      <div class="thermal-layer">
        <Picture
          src={thermalImage}
          alt=""
          formats={['avif', 'webp']}
          widths={[480, 800, 1200, 1600]}
          sizes="(max-width: 768px) 100vw, (max-width: 1360px) 90vw, 1280px"
          loading={loading}
          class="w-full h-full object-cover"
        />
      </div>
    )}
    {thermalImage && <div class="scan-line" aria-hidden="true"></div>}

    <!-- Registration ticks + annotation overlay -->
    <svg
      class="absolute inset-0 w-full h-full pointer-events-none"
      viewBox={`0 0 ${VW} ${VH}`}
      preserveAspectRatio="none"
      aria-hidden="true"
    >
      <!-- Corner registration ticks -->
      <g class="annotation-tick">
        <path d={`M 8 28 V 8 H 28`} />
        <path d={`M ${VW - 28} 8 H ${VW - 8} V 28`} />
        <path d={`M ${VW - 8} ${VH - 28} V ${VH - 8} H ${VW - 28}`} />
        <path d={`M 28 ${VH - 8} H 8 V ${VH - 28}`} />
      </g>
      {annotations.map((a, i) => {
        const x = (a.x / 100) * VW;
        const y = (a.y / 100) * VH;
        const w = (a.w / 100) * VW;
        const h = (a.h / 100) * VH;
        const labelY = a.labelAt === 'bottom' ? y + h + 22 : y - 10;
        const conf = a.confidence != null ? ` · CONF ${a.confidence.toFixed(2)}` : '';
        return (
          <g style={`--annotation-delay: ${0.3 + i * 0.35}s; --box-perimeter: ${boxPerimeter(a, VW, VH)}`}>
            <rect class="annotation-box" x={x} y={y} width={w} height={h} />
            <text
              class="annotation-label"
              x={x}
              y={labelY}
              fill="var(--signal)"
              font-family="JetBrains Mono, monospace"
              font-size="15"
              letter-spacing="1"
            >
              {a.label}{conf}
            </text>
          </g>
        );
      })}
    </svg>

    {crosshair && (
      <span
        class="absolute hidden mono-label text-signal bg-surface-0/85 px-2 py-1 pointer-events-none whitespace-nowrap z-10"
        data-coord-readout
        aria-hidden="true"
      ></span>
    )}
  </div>

  <figcaption class="flex flex-wrap items-center justify-between gap-2 border-x border-b border-rule px-4 py-2.5">
    <span class="mono-label text-ink-3">{meta.caption}</span>
    {annotations.length > 0 && (
      <span class="mono-label text-ink-3">{annotations.length} FINDING{annotations.length > 1 ? 'S' : ''}</span>
    )}
  </figcaption>
</figure>

{crosshair && (
  <script>
    // B2: crosshair coordinate readout — pointer position mapped to geo bounds.
    document.querySelectorAll<HTMLElement>('[data-frame][data-geo]').forEach((frame) => {
      const readout = frame.querySelector<HTMLElement>('[data-coord-readout]');
      if (!readout) return;
      const geo = JSON.parse(frame.dataset.geo!);
      const show = (clientX: number, clientY: number) => {
        const r = frame.getBoundingClientRect();
        const px = Math.min(Math.max((clientX - r.left) / r.width, 0), 1);
        const py = Math.min(Math.max((clientY - r.top) / r.height, 0), 1);
        const lat = geo.latTop + (geo.latBottom - geo.latTop) * py;
        const lon = geo.lonLeft + (geo.lonRight - geo.lonLeft) * px;
        readout.textContent = `${Math.abs(lat).toFixed(4)}°${lat >= 0 ? 'N' : 'S'} ${Math.abs(lon).toFixed(4)}°${lon >= 0 ? 'E' : 'W'}`;
        readout.style.left = `${Math.min(px * 100, 78)}%`;
        readout.style.top = `${Math.min(py * 100 + 4, 92)}%`;
        readout.classList.remove('hidden');
      };
      frame.addEventListener('pointermove', (e) => show(e.clientX, e.clientY));
      frame.addEventListener('pointerleave', () => readout.classList.add('hidden'));
    });
  </script>
)}

<script>
  // Arm thermal reveals when they enter the viewport (plays once).
  const frames = document.querySelectorAll('.thermal-reveal:not([data-armed])');
  if (frames.length) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            e.target.setAttribute('data-armed', '');
            io.unobserve(e.target);
          }
        }
      },
      { threshold: 0.35 }
    );
    frames.forEach((f) => io.observe(f));
  }
</script>
