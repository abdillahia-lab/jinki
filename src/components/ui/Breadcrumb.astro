---
/*
  Breadcrumb — mono trail under the nav, with BreadcrumbList JSON-LD.
*/
interface Item {
  label: string;
  href?: string;
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://jinki.ai/' },
    ...items.map((item, i) => ({
      '@type': 'ListItem',
      position: i + 2,
      name: item.label,
      ...(item.href ? { item: `https://jinki.ai${item.href}` } : {}),
    })),
  ],
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />

<nav aria-label="Breadcrumb" class="max-w-brief mx-auto px-5 sm:px-8 lg:px-12 2xl:px-16 pt-24 md:pt-28">
  <ol class="list-none m-0 p-0 flex flex-wrap items-center gap-2 mono-label text-ink-3">
    <li><a href="/" class="no-underline text-ink-3 hover:text-ink transition-colors">HOME</a></li>
    {items.map((item) => (
      <li class="flex items-center gap-2">
        <span aria-hidden="true">/</span>
        {item.href ? (
          <a href={item.href} class="no-underline text-ink-3 hover:text-ink transition-colors">{item.label.toUpperCase()}</a>
        ) : (
          <span aria-current="page" class="text-signal">{item.label.toUpperCase()}</span>
        )}
      </li>
    ))}
  </ol>
</nav>
