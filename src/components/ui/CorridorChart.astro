---
/*
  CorridorChart — the Mid-Atlantic operating area drawn in aeronautical
  sectional style: the DC SFRA ring (real airspace Jinki is certified to
  navigate), the FRZ core, NoVA data-center cluster marks, corridor
  bounds. Hand-built SVG, ~all true geography (simplified geometry).
*/
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<figure class={`m-0 ${className}`}>
  <div class="border border-rule rounded-panel overflow-hidden bg-surface-1">
    <svg viewBox="0 0 800 520" class="w-full block" role="img" aria-label="Operating area chart: Mid-Atlantic corridor with the Washington DC Special Flight Rules Area ring, flight restricted zone, and Northern Virginia data center cluster">
      <!-- graticule -->
      <g stroke="var(--rule)" stroke-width="0.5">
        {Array.from({ length: 9 }, (_, i) => <line x1={i * 100} y1="0" x2={i * 100} y2="520" />)}
        {Array.from({ length: 6 }, (_, i) => <line x1="0" y1={i * 100} x2="800" y2={i * 100} />)}
      </g>

      <!-- Potomac river suggestion -->
      <path d="M 470 90 C 460 150 480 190 455 240 C 430 290 460 340 440 400 C 430 430 450 470 445 520"
        fill="none" stroke="var(--rule-strong)" stroke-width="1.2" stroke-dasharray="1 4" />

      <!-- DC SFRA — 30nm ring (real boundary, simplified to circle on DCA) -->
      <circle cx="470" cy="240" r="190" fill="none" stroke="var(--signal-dim)" stroke-width="1.5" stroke-dasharray="8 5" />
      <!-- FRZ — inner ~13-15nm ring -->
      <circle cx="470" cy="240" r="85" fill="rgba(255,79,0,0.05)" stroke="var(--signal-dim)" stroke-width="1" />
      <text x="470" y="180" text-anchor="middle" fill="var(--signal)" font-family="JetBrains Mono, monospace" font-size="11" letter-spacing="1.5">FRZ</text>
      <text x="470" y="64" text-anchor="middle" fill="var(--signal)" font-family="JetBrains Mono, monospace" font-size="11" letter-spacing="1.5">DC SFRA · 30 NM</text>

      <!-- DCA center mark -->
      <g stroke="var(--signal)" stroke-width="1.2">
        <line x1="465" y1="240" x2="475" y2="240" />
        <line x1="470" y1="235" x2="470" y2="245" />
      </g>
      <text x="482" y="244" fill="var(--ink-3)" font-family="JetBrains Mono, monospace" font-size="9" letter-spacing="1">DCA</text>

      <!-- NoVA data-center cluster (Ashburn / Sterling / Manassas) -->
      <g fill="var(--ink-1)">
        <rect x="296" y="156" width="7" height="7" />
        <rect x="312" y="148" width="7" height="7" />
        <rect x="306" y="170" width="7" height="7" />
        <rect x="284" y="164" width="7" height="7" />
        <rect x="318" y="166" width="7" height="7" />
      </g>
      <text x="310" y="138" text-anchor="middle" fill="var(--ink-2)" font-family="JetBrains Mono, monospace" font-size="10" letter-spacing="1">ASHBURN CLUSTER</text>

      <g fill="var(--ink-1)">
        <rect x="262" y="304" width="7" height="7" />
        <rect x="278" y="312" width="7" height="7" />
        <rect x="270" y="324" width="7" height="7" />
      </g>
      <text x="276" y="294" text-anchor="middle" fill="var(--ink-2)" font-family="JetBrains Mono, monospace" font-size="10" letter-spacing="1">MANASSAS</text>

      <!-- Corridor operating bounds -->
      <path d="M 120 60 L 380 40 L 420 120 L 400 300 L 350 420 L 150 460 L 90 300 Z"
        fill="rgba(255,79,0,0.025)" stroke="var(--rule-strong)" stroke-width="1.2" />
      <text x="135" y="92" fill="var(--ink-3)" font-family="JetBrains Mono, monospace" font-size="10" letter-spacing="1.5">OPERATING CORRIDOR</text>

      <!-- Compass rose (minimal) -->
      <g transform="translate(730, 70)">
        <line x1="0" y1="22" x2="0" y2="-22" stroke="var(--rule-strong)" stroke-width="1" />
        <path d="M 0 -22 L -5 -10 L 5 -10 Z" fill="var(--signal)" />
        <text x="0" y="-30" text-anchor="middle" fill="var(--ink-3)" font-family="JetBrains Mono, monospace" font-size="10">N</text>
      </g>

      <!-- Scale bar -->
      <g transform="translate(610, 480)">
        <line x1="0" y1="0" x2="120" y2="0" stroke="var(--ink-3)" stroke-width="1.2" />
        <line x1="0" y1="-4" x2="0" y2="4" stroke="var(--ink-3)" stroke-width="1.2" />
        <line x1="120" y1="-4" x2="120" y2="4" stroke="var(--ink-3)" stroke-width="1.2" />
        <text x="60" y="16" text-anchor="middle" fill="var(--ink-3)" font-family="JetBrains Mono, monospace" font-size="9" letter-spacing="1">30 NM</text>
      </g>
    </svg>
  </div>
  <figcaption class="flex flex-wrap items-center justify-between gap-2 border-x border-b border-rule px-4 py-2.5">
    <span class="mono-label text-ink-3">OPERATING AREA · MID-ATLANTIC · DC SFRA AUTHORIZATION HELD</span>
    <span class="mono-label text-ink-3">GEOMETRY SIMPLIFIED</span>
  </figcaption>
</figure>
