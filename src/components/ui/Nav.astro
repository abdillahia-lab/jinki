---
/*
  Nav — one system. Sticky header + native <dialog> full-screen sheet.
  Desktop: wordmark, links, NIGHT/DAY OPS toggle, primary pill.
  Mobile: wordmark + INDEX button -> numbered Manifest sheet.
  Replaces 889-line Nav + MobileBottomNav + MobileSheet.
*/
const verticals = [
  { index: '01', href: '/verticals/data-centers', label: 'Data Centers' },
  { index: '02', href: '/verticals/energy-grid', label: 'Energy Grid' },
  { index: '03', href: '/verticals/security', label: 'Security' },
  { index: '04', href: '/verticals/agriculture', label: 'Agriculture' },
  { index: '05', href: '/verticals/real-estate', label: 'Real Estate' },
];
const services = [
  { index: '01', href: '/services/intelligence-scan', label: 'Intelligence Scan' },
  { index: '02', href: '/services/deployment', label: 'Autonomous Deployment' },
];
const topLinks = [
  { href: '/sample-report', label: 'Sample Report' },
  { href: '/about', label: 'About' },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => currentPath === href || currentPath.startsWith(href + '/');
const inVerticals = verticals.some((v) => isActive(v.href));
const inServices = services.some((s) => isActive(s.href));
---

<header
  class="sticky top-0 z-nav bg-surface-0/95 backdrop-blur-sm border-b border-rule"
  style="view-transition-name: site-nav;"
  data-nav
>
  <nav class="max-w-brief mx-auto px-5 sm:px-8 lg:px-12 2xl:px-16 h-16 flex items-center justify-between gap-6" aria-label="Main">
    <a href="/" class="flex items-center gap-2.5 no-underline" aria-label="Jinki — home">
      <svg width="22" height="22" viewBox="0 0 32 32" fill="none" aria-hidden="true">
        <circle cx="16" cy="16" r="2.5" fill="currentColor" class="text-signal" />
        <path d="M 16 8 A 8 8 0 1 1 8.5 20" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" class="text-ink" />
        <path d="M 22 4.5 A 14 14 0 0 1 22 27.5" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" class="text-ink-3" />
      </svg>
      <span class="font-display font-medium text-lg text-ink tracking-tight">Jinki</span>
    </a>

    <!-- Desktop links -->
    <ul class="hidden lg:flex items-center gap-7 list-none m-0 p-0">
      <li class="relative group">
        <button
          class={`bg-transparent border-0 cursor-pointer font-sans text-caption py-2 flex items-center gap-1.5 transition-colors ${inVerticals ? 'text-ink' : 'text-ink-2 hover:text-ink'}`}
          aria-expanded="false" aria-haspopup="menu" data-dropdown="verticals"
        >
          Verticals
          <svg width="9" height="6" viewBox="0 0 9 6" fill="none" aria-hidden="true" class="transition-transform group-hover:rotate-180">
            <path d="M1 1l3.5 3.5L8 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
          </svg>
          {inVerticals && <span class="absolute -bottom-px left-0 right-0 h-0.5 thermal-band"></span>}
        </button>
        <div class="absolute top-full left-0 pt-2 opacity-0 invisible translate-y-1 group-hover:opacity-100 group-hover:visible group-hover:translate-y-0 group-focus-within:opacity-100 group-focus-within:visible group-focus-within:translate-y-0 transition-all duration-200">
          <ul class="list-none m-0 p-2 min-w-64 bg-surface-1 border border-rule rounded-panel shadow-overlay" role="menu">
            {verticals.map((v) => (
              <li role="none">
                <a role="menuitem" href={v.href} class="flex items-baseline gap-3 px-3 py-2.5 no-underline rounded-panel transition-colors hover:bg-surface-2">
                  <span class="mono-label text-ink-3 tabular">{v.index}</span>
                  <span class="text-caption text-ink">{v.label}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </li>
      <li class="relative group">
        <button
          class={`bg-transparent border-0 cursor-pointer font-sans text-caption py-2 flex items-center gap-1.5 transition-colors ${inServices ? 'text-ink' : 'text-ink-2 hover:text-ink'}`}
          aria-expanded="false" aria-haspopup="menu" data-dropdown="services"
        >
          Services
          <svg width="9" height="6" viewBox="0 0 9 6" fill="none" aria-hidden="true" class="transition-transform group-hover:rotate-180">
            <path d="M1 1l3.5 3.5L8 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
          </svg>
          {inServices && <span class="absolute -bottom-px left-0 right-0 h-0.5 thermal-band"></span>}
        </button>
        <div class="absolute top-full left-0 pt-2 opacity-0 invisible translate-y-1 group-hover:opacity-100 group-hover:visible group-hover:translate-y-0 group-focus-within:opacity-100 group-focus-within:visible group-focus-within:translate-y-0 transition-all duration-200">
          <ul class="list-none m-0 p-2 min-w-64 bg-surface-1 border border-rule rounded-panel shadow-overlay" role="menu">
            {services.map((s) => (
              <li role="none">
                <a role="menuitem" href={s.href} class="flex items-baseline gap-3 px-3 py-2.5 no-underline rounded-panel transition-colors hover:bg-surface-2">
                  <span class="mono-label text-ink-3 tabular">{s.index}</span>
                  <span class="text-caption text-ink">{s.label}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </li>
      {topLinks.map((l) => (
        <li class="relative">
          <a href={l.href} class={`no-underline font-sans text-caption py-2 transition-colors ${isActive(l.href) ? 'text-ink' : 'text-ink-2 hover:text-ink'}`}>
            {l.label}
            {isActive(l.href) && <span class="absolute -bottom-px left-0 right-0 h-0.5 thermal-band"></span>}
          </a>
        </li>
      ))}
    </ul>

    <div class="flex items-center gap-3">
      <button
        class="hidden md:block bg-transparent border-0 cursor-pointer mono-label text-ink-3 hover:text-ink transition-colors py-2"
        data-theme-toggle aria-live="polite"
      >
        <span data-theme-label>NIGHT OPS</span>
      </button>
      <a
        href="#lead-gen"
        class="hidden sm:inline-flex items-center h-10 px-5 rounded-pill bg-btn text-btn-fg no-underline font-sans text-caption font-medium hover:opacity-90 transition-opacity"
        data-event="cta-assessment:nav"
      >
        Request assessment
      </a>
      <button
        class="lg:hidden bg-transparent border border-rule-strong rounded-panel cursor-pointer mono-label text-ink px-3.5 h-10 min-w-11"
        data-sheet-open aria-haspopup="dialog"
      >
        INDEX
      </button>
    </div>
  </nav>
</header>

<!-- Mobile sheet: native dialog, numbered Manifest -->
<dialog
  data-sheet
  class="m-0 p-0 w-full max-w-none h-dvh max-h-none bg-surface-0 text-ink border-0 backdrop:bg-surface-0/80"
>
  <div class="flex flex-col h-full px-5 sm:px-8 pt-4 pb-8 overflow-y-auto">
    <div class="flex items-center justify-between h-12 mb-8">
      <span class="font-display font-medium text-lg">Jinki</span>
      <button class="bg-transparent border border-rule-strong rounded-panel cursor-pointer mono-label text-ink px-3.5 h-10 min-w-11" data-sheet-close>
        CLOSE
      </button>
    </div>
    <nav aria-label="Mobile">
      <p class="mono-label text-ink-3 mb-3">VERTICALS</p>
      <ul class="list-none m-0 p-0 mb-8">
        {verticals.map((v) => (
          <li class="folio-rule">
            <a href={v.href} class="flex items-baseline gap-4 py-4 no-underline min-h-12">
              <span class="mono-label text-signal tabular">{v.index}</span>
              <span class="font-display font-medium text-h3 text-ink">{v.label}</span>
            </a>
          </li>
        ))}
      </ul>
      <p class="mono-label text-ink-3 mb-3">SERVICES</p>
      <ul class="list-none m-0 p-0 mb-8">
        {services.map((s) => (
          <li class="folio-rule">
            <a href={s.href} class="flex items-baseline gap-4 py-4 no-underline min-h-12">
              <span class="mono-label text-signal tabular">{s.index}</span>
              <span class="font-display font-medium text-h3 text-ink">{s.label}</span>
            </a>
          </li>
        ))}
      </ul>
      <ul class="list-none m-0 p-0 mb-10">
        {topLinks.map((l) => (
          <li class="folio-rule">
            <a href={l.href} class="block py-4 no-underline font-display font-medium text-h3 text-ink min-h-12">{l.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="mt-auto flex flex-col gap-4">
      <button class="bg-transparent border-0 cursor-pointer mono-label text-ink-3 text-left p-0" data-theme-toggle>
        <span data-theme-label>NIGHT OPS</span>
      </button>
      <a href="#lead-gen" data-sheet-close-link class="inline-flex items-center justify-center h-12 rounded-pill bg-btn text-btn-fg no-underline font-sans text-caption font-medium">
        Request assessment
      </a>
    </div>
  </div>
</dialog>

<script>
  // Theme toggle: DAY OPS / NIGHT OPS
  const setLabels = () => {
    const t = document.documentElement.getAttribute('data-theme');
    document.querySelectorAll('[data-theme-label]').forEach((el) => {
      el.textContent = t === 'light' ? 'DAY OPS' : 'NIGHT OPS';
    });
  };
  setLabels();
  document.querySelectorAll('[data-theme-toggle]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const next = document.documentElement.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
      document.documentElement.setAttribute('data-theme', next);
      try { localStorage.setItem('jinki-theme', next); } catch {}
      setLabels();
    });
  });

  // Mobile sheet
  const sheet = document.querySelector<HTMLDialogElement>('[data-sheet]');
  if (sheet) {
    document.querySelector('[data-sheet-open]')?.addEventListener('click', () => sheet.showModal());
    sheet.querySelectorAll('[data-sheet-close], [data-sheet-close-link], a').forEach((el) =>
      el.addEventListener('click', () => sheet.close())
    );
    sheet.addEventListener('click', (e) => { if (e.target === sheet) sheet.close(); });
  }
</script>
