---
/*
  MissionPlayer — the mission loop performed live.
  Desktop + capable hardware: three.js scene (dynamic import, idle+IO
  gated), scrubbed by scroll through a 280vh section; drag orbits.
  Touch: same scene, autoplay loop. Low-capability / reduced-motion /
  no-WebGL: static annotated fallback (pure CSS/SVG) — never a hole.
*/
const PHASES = [
  { key: 'FLY', title: 'Approach & flight plan', sub: 'Autonomous path over every structure' },
  { key: 'SEE', title: 'Radiometric capture', sub: '±0.5°C thermal painted in one pass' },
  { key: 'FIND', title: 'AI detection', sub: 'Anomalies classified and severity-ranked' },
  { key: 'REPORT', title: 'The report', sub: 'Work-order-ready, 48-hour target' },
];
---

<section aria-label="Watch a mission" class="mission-host" data-mission-host>
  <div class="mission-sticky">
    <div class="max-w-brief mx-auto px-5 sm:px-8 lg:px-12 2xl:px-16 pt-6">
      <div class="folio-rule rule-draw flex items-baseline justify-between gap-4 pt-3 mb-6">
        <span class="mono-label text-ink-3"><span class="text-signal">02</span>&nbsp;/&nbsp;THE MISSION</span>
        <span class="flex items-baseline gap-5">
          <span class="mono-label text-ink-3" data-mission-phase-label>SCROLL TO RUN THE MISSION</span>
          <a href="#verticals" class="mono-label text-ink-3 no-underline hover:text-ink transition-colors" data-mission-skip>SKIP ↓</a>
        </span>
      </div>
    </div>

    <div class="mission-stage max-w-brief mx-auto px-5 sm:px-8 lg:px-12 2xl:px-16">
      <div class="relative border border-rule rounded-panel overflow-hidden bg-surface-0" data-mission-frame>
        <canvas class="mission-canvas w-full h-full block" data-mission-canvas></canvas>
        <div class="absolute inset-0 pointer-events-none" data-mission-labels></div>

        <!-- Static fallback (visible until/unless 3D arms) -->
        <div class="mission-fallback absolute inset-0" data-mission-fallback>
          <svg viewBox="0 0 1200 560" class="w-full h-full" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
            <rect width="1200" height="560" fill="var(--surface-0)" />
            <g stroke="var(--rule)" stroke-width="0.5">
              {Array.from({ length: 24 }, (_, i) => <line x1={i * 50} y1="0" x2={i * 50} y2="560" />)}
              {Array.from({ length: 12 }, (_, i) => <line x1="0" y1={i * 50} x2="1200" y2={i * 50} />)}
            </g>
            <!-- isometric halls -->
            <g stroke="var(--rule-strong)" stroke-width="1.2" fill="var(--surface-2)">
              <path d="M 380 330 L 620 270 L 800 320 L 560 385 Z" />
              <path d="M 380 330 L 380 295 L 620 237 L 620 270 Z" fill="var(--surface-3)" />
              <path d="M 620 270 L 620 237 L 800 286 L 800 320 Z" fill="var(--surface-1)" />
            </g>
            <!-- flight path -->
            <path d="M 150 120 C 350 80, 520 120, 600 180 C 680 240, 760 230, 900 200" fill="none" stroke="var(--signal)" stroke-width="1.5" stroke-dasharray="6 6" opacity="0.8" />
            <circle cx="900" cy="200" r="5" fill="var(--signal)" />
            <!-- finding -->
            <rect x="610" y="290" width="60" height="34" fill="none" stroke="var(--signal)" stroke-width="1.5" />
            <text x="610" y="280" fill="var(--signal)" font-family="JetBrains Mono, monospace" font-size="15" letter-spacing="1">SEV-1 · ΔT +14.2°C</text>
          </svg>
        </div>

        <!-- Report card (REPORT phase) -->
        <div class="mission-report border border-rule rounded-panel bg-surface-0/95 p-5" data-mission-report hidden>
          <p class="mono-label text-signal mb-3 max-w-none">MISSION COMPLETE — THE DELIVERABLE</p>
          <dl class="m-0 grid grid-cols-[auto_1fr] gap-x-5 gap-y-1.5 font-mono text-caption">
            <dt class="text-ink-3">FINDINGS</dt><dd class="m-0 text-ink tabular">3 · 1 SEV-1 · 2 SEV-2</dd>
            <dt class="text-ink-3">COVERAGE</dt><dd class="m-0 text-ink">100% ROOFTOP, SINGLE PASS</dd>
            <dt class="text-ink-3">DELIVERY</dt><dd class="m-0 text-ink tabular">T+48H · WORK-ORDER READY</dd>
          </dl>
          <a href="/sample-report" class="mono-label text-ink link-draw no-underline inline-block mt-4" data-event="cta-sample:mission">READ THE SAMPLE REPORT →</a>
        </div>
      </div>

      <!-- Phase rail -->
      <ol class="list-none m-0 p-0 grid grid-cols-2 md:grid-cols-4 border-x border-b border-rule" data-mission-rail>
        {PHASES.map((p, i) => (
          <li class="mission-phase px-4 py-3 border-r border-rule last:border-r-0" data-phase-chip={i}>
            <span class="mono-label text-ink-3 block" data-phase-key>{String(i + 1).padStart(2, '0')} · {p.key}</span>
            <span class="block font-mono text-caption text-ink-2 mt-1">{p.title}</span>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .mission-host { position: relative; height: 220vh; }
  .mission-sticky { position: sticky; top: 4rem; }
  .mission-stage [data-mission-frame] { aspect-ratio: 16 / 8.5; max-height: min(62vh, 640px); width: 100%; }
  .mission-canvas { opacity: 0; transition: opacity 0.6s ease; }
  [data-mission-frame].is-3d .mission-canvas { opacity: 1; }
  [data-mission-frame].is-3d .mission-fallback { opacity: 0; pointer-events: none; transition: opacity 0.6s ease; }
  .mission-report {
    position: absolute; right: 1rem; bottom: 1rem; max-width: 22rem;
    backdrop-filter: blur(4px);
  }
  .mission-phase[data-active] [data-phase-key] { color: var(--signal); }
  .mission-phase[data-active] { background: var(--surface-1); }
  :global(.mission-label) {
    position: absolute; transform: translate(-50%, -100%);
    font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.1em;
    color: var(--signal); background: color-mix(in srgb, var(--surface-0) 85%, transparent);
    border: 1px solid var(--signal-dim); border-radius: 3px;
    padding: 0.2rem 0.45rem; white-space: nowrap;
    transition: opacity 0.3s ease;
  }
  @media (max-width: 767px) {
    .mission-host { height: auto; }
    .mission-sticky { position: static; }
    .mission-report { position: static; max-width: none; margin-top: 0; border-top: 0; border-radius: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .mission-host { height: auto; }
    .mission-sticky { position: static; }
  }
</style>

<script>
  const host = document.querySelector<HTMLElement>('[data-mission-host]');
  if (host) {
    const frame = host.querySelector<HTMLElement>('[data-mission-frame]')!;
    const canvas = host.querySelector<HTMLCanvasElement>('[data-mission-canvas]')!;
    const labels = host.querySelector<HTMLElement>('[data-mission-labels]')!;
    const phaseLabel = host.querySelector<HTMLElement>('[data-mission-phase-label]')!;
    const report = host.querySelector<HTMLElement>('[data-mission-report]')!;
    const chips = [...host.querySelectorAll<HTMLElement>('[data-phase-chip]')];

    const REDUCED = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const TOUCH = matchMedia('(pointer: coarse)').matches;
    const capable =
      !REDUCED &&
      (navigator.hardwareConcurrency ?? 4) >= 4 &&
      ((navigator as any).deviceMemory ?? 4) >= 4 &&
      !!document.createElement('canvas').getContext('webgl2');

    const PHASE_TEXT = ['PHASE 01 · FLY', 'PHASE 02 · SEE', 'PHASE 03 · FIND', 'PHASE 04 · REPORT'];

    if (capable) {
      const start = () => {
        import('../../scripts/mission').then(({ createMission }) => {
          const api = createMission(canvas, labels);
          frame.classList.add('is-3d');
          api.setPhaseCallback((p) => {
            phaseLabel.textContent = PHASE_TEXT[p];
            chips.forEach((c, i) => (i === p ? c.setAttribute('data-active', '') : c.removeAttribute('data-active')));
            report.hidden = p !== 3;
          });
          if (TOUCH) {
            // autoplay loop, 22s
            let t0 = performance.now();
            const tick = (t: number) => {
              api.setProgress(((t - t0) / 22000) % 1);
              requestAnimationFrame(tick);
            };
            requestAnimationFrame(tick);
          } else {
            // Scrub with inertia + phase snapping via ScrollTrigger (W1);
            // raw-scroll fallback if the motion chunk fails.
            import('../../scripts/motion').then(({ ScrollTrigger }) => {
              ScrollTrigger.create({
                trigger: host,
                start: 'top top',
                end: 'bottom bottom',
                scrub: 0.8,
                snap: {
                  snapTo: [0, 0.3, 0.62, 0.85, 1],
                  duration: { min: 0.2, max: 0.6 },
                  ease: 'power1.inOut',
                },
                onUpdate: (self) => api.setProgress(self.progress),
              });
            }).catch(() => {
              const onScroll = () => {
                const r = host.getBoundingClientRect();
                const total = r.height - innerHeight;
                api.setProgress(Math.max(0, Math.min(1, -r.top / total)));
              };
              addEventListener('scroll', onScroll, { passive: true });
              onScroll();
            });
          }
        }).catch(() => {/* fallback stays */});
      };
      const io = new IntersectionObserver((es) => {
        if (es.some((e) => e.isIntersecting)) {
          io.disconnect();
          'requestIdleCallback' in window ? requestIdleCallback(start, { timeout: 2000 }) : setTimeout(start, 200);
        }
      }, { rootMargin: '400px' });
      io.observe(host);
    } else {
      // static fallback: walk the phase rail on intersection
      phaseLabel.textContent = 'MISSION OVERVIEW';
      chips[2]?.setAttribute('data-active', '');
    }
  }
</script>
