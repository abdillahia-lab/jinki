---
/*
  Field Note — single post on the Intelligence Brief system.
  Folio header (date · read time · share), display title, lede,
  left-hung prose column. No sidebar, no reactions, no chrome.
*/
import Base from '../../layouts/Base.astro';
import Nav from '../../components/ui/Nav.astro';
import Footer from '../../components/ui/Footer.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import Section from '../../components/ui/Section.astro';
import CTABlock from '../../components/ui/CTABlock.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const words = (post.body ?? '').split(/\s+/).filter(Boolean).length;
const readingTime = Math.max(2, Math.round(words / 220));

// Dates parse as UTC midnight — UTC getters avoid the off-by-a-day shift.
const d = post.data.date;
const folioDate = `${d.getUTCFullYear()}.${String(d.getUTCMonth() + 1).padStart(2, '0')}.${String(d.getUTCDate()).padStart(2, '0')}`;

const currentUrl = `https://jinki.ai/blog/${post.id}`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.description,
  author: { '@type': 'Person', name: post.data.author, url: 'https://jinki.ai/about' },
  publisher: {
    '@type': 'Organization',
    name: 'Jinki Aerial Intelligence',
    url: 'https://jinki.ai',
    logo: { '@type': 'ImageObject', url: 'https://jinki.ai/images/jinki-logo.png' },
  },
  image: post.data.image ? `https://jinki.ai${post.data.image}` : 'https://jinki.ai/images/og/og-default.png',
  datePublished: post.data.date.toISOString(),
  url: currentUrl,
  mainEntityOfPage: currentUrl,
};
---

<Base
  title={`${post.data.title} — Jinki Field Notes`}
  description={post.data.description}
  ogImage={post.data.image ?? '/images/og/og-default.png'}
  jsonLd={jsonLd}
>
  <Nav />
  <Breadcrumb items={[{ label: 'Field Notes', href: '/blog' }, { label: post.data.title }]} />
  <main id="main-content">

    <!-- POST -->
    <section aria-label="Field note" class="pt-10 md:pt-16">
      <div class="max-w-brief mx-auto px-5 sm:px-8 lg:px-12 2xl:px-16">
        <div class="folio-rule rule-draw flex items-baseline justify-between gap-4 pt-3 mb-10">
          <span class="mono-label text-ink-3">
            <time datetime={post.data.date.toISOString()} class="tabular">{folioDate}</time>
            &nbsp;·&nbsp;{String(readingTime).padStart(2, '0')} MIN READ
          </span>
          <button
            type="button"
            data-share
            hidden
            class="mono-label text-ink-3 hover:text-ink transition-colors bg-transparent border-0 p-0 cursor-pointer"
          >SHARE</button>
        </div>

        <h1 class="text-h1 font-display font-medium text-ink max-w-[24ch] rise">
          {post.data.title}
        </h1>

        {post.data.description && (
          <p class="text-lede text-ink-2 mt-6 max-w-[56ch] rise">{post.data.description}</p>
        )}

        <article class="prose-brief max-w-prose mt-12 md:mt-16">
          <Content />
        </article>
      </div>
    </section>

    <Section label="Engage" spacing="compact">
      <CTABlock
        title="Put this intelligence on your facility."
        body="Severity-ranked findings, 48-hour turnaround, a mutual NDA before we see your site."
        primary={{ label: 'Request Q3 assessment', href: '/#lead-gen', event: 'cta-assessment:post' }}
        secondary={{ label: 'See the sample report', href: '/sample-report', kind: 'secondary', event: 'cta-sample:post' }}
      />
    </Section>

  </main>
  <Footer />
</Base>

<style>
  /* Markdown output is unscoped — every selector goes through :global(). */
  .prose-brief :global(h2) {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--text-h2);
    line-height: 1.08;
    letter-spacing: -0.03em;
    border-top: 1px solid var(--rule-strong);
    padding-top: 0.875rem;
    margin: 3rem 0 1rem;
  }
  .prose-brief :global(h3) {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--text-h3);
    line-height: 1.25;
    letter-spacing: -0.015em;
    margin: 2.25rem 0 0.75rem;
  }
  .prose-brief :global(p) {
    color: var(--ink-2);
    max-width: 68ch;
    margin-bottom: 1.25rem;
  }
  .prose-brief :global(a) {
    color: var(--ink-1);
    text-decoration: underline 1px var(--signal-dim);
    text-underline-offset: 3px;
    background-image: linear-gradient(currentColor, currentColor);
    background-size: 0% 1px;
    background-position: 0 100%;
    background-repeat: no-repeat;
    transition: background-size 0.2s var(--ease-settle);
  }
  .prose-brief :global(a:hover),
  .prose-brief :global(a:focus-visible) {
    background-size: 100% 1px;
  }
  .prose-brief :global(ul),
  .prose-brief :global(ol) {
    padding-left: 1.25rem;
    margin-bottom: 1.25rem;
  }
  .prose-brief :global(li) {
    color: var(--ink-2);
    margin-bottom: 0.375rem;
  }
  .prose-brief :global(blockquote) {
    border-left: 2px solid var(--signal-dim);
    padding-left: 1rem;
    color: var(--ink-2);
    font-style: italic;
    margin: 1.5rem 0;
  }
  .prose-brief :global(code) {
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    background: var(--surface-2);
    padding: 0.1em 0.35em;
    border-radius: 2px;
  }
  .prose-brief :global(pre) {
    background: var(--surface-1);
    border: 1px solid var(--rule);
    border-radius: var(--radius-panel);
    padding: 1rem;
    overflow-x: auto;
    margin-bottom: 1.25rem;
  }
  .prose-brief :global(pre code) {
    background: none;
    padding: 0;
  }
  .prose-brief :global(img) {
    border: 1px solid var(--rule);
    border-radius: var(--radius-panel);
    margin: 1.5rem 0;
  }
  .prose-brief :global(hr) {
    border: none;
    border-top: 1px solid var(--rule);
    margin: 2.5rem 0;
  }
</style>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-share]');
  if (btn && 'share' in navigator) {
    btn.hidden = false;
    btn.addEventListener('click', () => {
      navigator.share({ title: document.title, url: location.href }).catch(() => {});
    });
  }
</script>
