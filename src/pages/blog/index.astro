---
/*
  Field Notes — the blog as a manifest, not a magazine.
  Folio rows: mono date, display title, description, read-time datum.
  No bylines (single-operator company), no cards, no thumbnails.
*/
import Base from '../../layouts/Base.astro';
import Nav from '../../components/ui/Nav.astro';
import Footer from '../../components/ui/Footer.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import Section from '../../components/ui/Section.astro';
import CTABlock from '../../components/ui/CTABlock.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const fmtDate = (d: Date) =>
  `${d.getUTCFullYear()}.${String(d.getUTCMonth() + 1).padStart(2, '0')}.${String(d.getUTCDate()).padStart(2, '0')}`;

const readTime = (body?: string) =>
  Math.max(2, Math.round((body ?? '').split(/\s+/).filter(Boolean).length / 220));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'Jinki Field Notes',
  description:
    'Insights on aerial intelligence, autonomous systems, thermal analytics, and infrastructure monitoring.',
  publisher: { '@type': 'Organization', name: 'Jinki Aerial Intelligence', url: 'https://jinki.ai' },
};
---

<Base
  title="Blog — Jinki Aerial Intelligence"
  description="Insights on aerial intelligence, autonomous systems, and industry trends from the Jinki team."
  ogImage="/images/og/og-default.png"
  jsonLd={jsonLd}
>
  <Nav />
  <Breadcrumb items={[{ label: 'Field Notes' }]} />
  <main id="main-content">

    <!-- HERO -->
    <section aria-label="Field notes" class="pt-10 md:pt-16">
      <div class="max-w-brief mx-auto px-5 sm:px-8 lg:px-12 2xl:px-16">
        <div class="folio-rule rule-draw flex items-baseline justify-between gap-4 pt-3 mb-12">
          <span class="mono-label text-ink-3"><span class="text-signal">FN</span>&nbsp;/&nbsp;FIELD NOTES</span>
          <span class="mono-label text-ink-3 tabular">{String(posts.length).padStart(2, '0')} ENTRIES</span>
        </div>
        <h1 class="text-display font-display font-medium text-ink max-w-[18ch] rise">
          Notes from the field.
        </h1>
        <p class="text-lede text-ink-2 mt-8 max-w-[58ch] rise">
          Working notes from flying critical infrastructure — thermal physics,
          inspection method, and the discipline of turning imagery into decisions.
        </p>
      </div>
    </section>

    <!-- MANIFEST -->
    <Section label="All field notes" cv>
      {posts.length === 0 && <p class="text-body text-ink-3">No entries yet.</p>}
      <ul class="list-none m-0 p-0" role="list">
        {posts.map((post) => (
          <li class="folio-rule rule-draw">
            <a
              href={`/blog/${post.id}`}
              class="group grid grid-cols-1 lg:grid-cols-12 lg:items-baseline gap-x-6 gap-y-2 py-6 md:py-7 px-2 -mx-2 no-underline transition-colors duration-200 hover:bg-surface-1 focus-visible:bg-surface-1"
            >
              <time
                datetime={post.data.date.toISOString()}
                class="mono-label text-ink-3 tabular transition-colors duration-200 group-hover:text-signal lg:col-span-2"
              >
                {fmtDate(post.data.date)}
              </time>
              <span class="font-display font-medium text-h3 text-ink transition-transform duration-200 group-hover:translate-x-2 lg:col-span-5">
                {post.data.title}
              </span>
              <span class="text-body text-ink-2 lg:col-span-3 lg:col-start-8">
                {post.data.description}
              </span>
              <span class="mono-label text-ink-3 tabular whitespace-nowrap lg:col-span-1 lg:col-start-12 lg:text-right">
                {String(readTime(post.body)).padStart(2, '0')} MIN
              </span>
            </a>
          </li>
        ))}
        <li class="folio-rule" aria-hidden="true"></li>
      </ul>
    </Section>

    <Section label="Engage" spacing="compact">
      <CTABlock
        title="Put these notes to work."
        body="Two fields, one business day, a mutual NDA before we see your site."
        primary={{ label: 'Request Q3 assessment', href: '/#lead-gen', event: 'cta-assessment:blog' }}
      />
    </Section>

  </main>
  <Footer />
</Base>
