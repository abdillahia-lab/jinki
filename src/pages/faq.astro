---
/*
  FAQ — the questions prospects ask before engaging.
  Four folio sections, native-details accordions, one FAQPage schema.
*/
import Base from '../layouts/Base.astro';
import Nav from '../components/ui/Nav.astro';
import Footer from '../components/ui/Footer.astro';
import Breadcrumb from '../components/ui/Breadcrumb.astro';
import Section from '../components/ui/Section.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import Accordion from '../components/ui/Accordion.astro';
import LeadForm from '../components/ui/LeadForm.astro';

const groups = [
  {
    index: '01',
    label: 'GENERAL',
    title: 'What Jinki is.',
    items: [
      {
        q: 'What is Jinki?',
        a: 'Jinki is an aerial intelligence firm that turns aerial data into prioritized maintenance recommendations for critical infrastructure — <a href="/verticals/data-centers">data centers</a>, <a href="/verticals/energy-grid">power grids</a>, <a href="/verticals/security">perimeters</a>, and <a href="/verticals/agriculture">agricultural operations</a>. We deliver actionable intelligence, not raw data.',
      },
      {
        q: 'What is a Facility Intelligence Scan?',
        a: 'A one-time aerial assessment that delivers a prioritized report with thermal, structural, and environmental findings — typically within 48 hours of the mission. <a href="/services/intelligence-scan">Learn more about Intelligence Scans</a>.',
      },
      {
        q: 'What industries does Jinki serve?',
        a: 'Jinki provides aerial intelligence for <a href="/verticals/data-centers">data centers</a>, <a href="/verticals/energy-grid">energy and utility infrastructure</a>, <a href="/verticals/security">perimeter security</a>, and <a href="/verticals/agriculture">agricultural operations</a> across the Mid-Atlantic United States.',
      },
      {
        q: 'Where does Jinki operate?',
        a: 'Jinki currently serves facilities in the Mid-Atlantic United States, with a focus on the Northern Virginia data center corridor — the world\'s largest concentration of data center capacity.',
      },
    ],
  },
  {
    index: '02',
    label: 'OPERATIONS',
    title: 'How missions run.',
    items: [
      {
        q: 'What equipment does Jinki use?',
        a: 'Jinki operates a piloted aerial platform with radiometric thermal sensors for assessment missions, and an autonomous aerial platform with an on-site dock station for persistent monitoring — with capacity for up to 200 missions per month.',
      },
      {
        q: 'What is radiometric thermal imaging?',
        a: 'Unlike standard thermal cameras that show relative heat patterns, radiometric sensors capture precise temperature values at every pixel (±0.5°C accuracy). This enables quantitative analysis — identifying components operating outside specification before they fail.',
      },
      {
        q: 'How is autonomous monitoring different from one-time assessments?',
        a: 'One-time <a href="/services/intelligence-scan">Intelligence Scans</a> provide a comprehensive facility snapshot. <a href="/services/deployment">Autonomous Deployment</a> adds a permanently stationed platform that flies recurring missions — building thermal baselines over time and flagging degradation velocity trends.',
      },
      {
        q: 'Why do data centers need aerial intelligence?',
        a: 'Data centers generate enormous heat loads. Rooftop cooling infrastructure — chillers, CRAHs, condensers — develops thermal anomalies that signal degradation weeks before failure. Aerial thermal inspection identifies these signatures without roof access or operational disruption.',
      },
      {
        q: 'What does an aerial thermal scan reveal at a data center?',
        a: 'Common findings include hot spots on cooling equipment, HVAC bypass or short-cycling, rooftop membrane degradation, electrical connection anomalies, and water intrusion signatures. Each finding is severity-ranked with recommended remediation.',
      },
      {
        q: 'Does aerial inspection require shutting down operations?',
        a: 'No. Aerial operations are completely non-invasive — no roof access, no scaffolding, no operational disruption. Your facility continues normal operations throughout the assessment.',
      },
    ],
  },
  {
    index: '03',
    label: 'DATA & SECURITY',
    title: 'Where your data lives.',
    items: [
      {
        q: 'How is my facility data protected?',
        a: 'All data is encrypted with AES-256 at rest and TLS 1.3 in transit. Every engagement begins with a mutual NDA. Controls are built on NIST 800-53; a SOC 2 Type I audit is on our roadmap. <a href="/data-security">View our full security architecture</a>.',
      },
      {
        q: 'Who has access to my facility imagery?',
        a: 'Access is strictly limited to authorized Jinki analysts assigned to your engagement. All team members undergo background checks. Data is never shared with third parties without explicit written consent.',
      },
      {
        q: 'How long is data retained?',
        a: 'Data retention follows your contract terms. By default, raw imagery is retained for 90 days after report delivery. Extended retention is available for clients using autonomous monitoring with trend analysis.',
      },
    ],
  },
  {
    index: '04',
    label: 'ENGAGEMENT',
    title: 'How engagements start.',
    items: [
      {
        q: 'What does the engagement process look like?',
        a: 'Submit a request and we aim to respond within one business day. A scoping call follows to understand your facility and objectives, then a written proposal. After mission execution, your prioritized intelligence report is targeted within 48 hours.',
      },
      {
        q: 'How much does an Intelligence Scan cost?',
        a: 'Pricing depends on facility size, complexity, and sensor requirements. <a href="#lead-gen">Request a quote</a> — we aim to respond within one business day.',
      },
      {
        q: 'Do you require long-term contracts?',
        a: 'No. Intelligence Scans are available as one-time engagements. Autonomous Deployment involves a service agreement for the stationed platform, but there are no hidden long-term lock-ins.',
      },
    ],
  },
];

const totalQuestions = groups.reduce((n, g) => n + g.items.length, 0);
---

<Base
  title="FAQ — Jinki Aerial Intelligence"
  description="Frequently asked questions about Jinki's aerial intelligence services — operations, radiometric thermal imaging, data security, and the engagement process."
>
  <Nav />
  <Breadcrumb items={[{ label: 'FAQ' }]} />
  <main id="main-content">

    <!-- HERO -->
    <section aria-label="Frequently asked questions" class="pt-10 md:pt-16">
      <div class="max-w-brief mx-auto px-5 sm:px-8 lg:px-12 2xl:px-16">
        <div class="folio-rule rule-draw flex items-baseline justify-between gap-4 pt-3 mb-12">
          <span class="mono-label text-ink-3"><span class="text-signal">FQ</span>&nbsp;/&nbsp;QUESTIONS</span>
          <span class="mono-label text-ink-3">{String(totalQuestions).padStart(2, '0')} QUESTIONS · 04 SECTIONS</span>
        </div>
        <h1 class="text-display font-display font-medium text-ink max-w-[18ch] rise">
          Asked <em class="not-italic text-signal">before engaging.</em>
        </h1>
        <p class="text-lede text-ink-2 max-w-prose mt-10 rise">
          The questions operators ask before their first mission — what we fly, what we find,
          and where your data lives. Anything missing,
          <a href="#lead-gen" class="text-ink link-draw no-underline">ask the founder directly</a> —
          responses targeted within one business day.
        </p>
        <!-- Jump row (C3): get to your section without scrolling blind -->
        <nav aria-label="Question sections" class="mt-8 rise">
          <ul class="list-none m-0 p-0 flex flex-wrap gap-2">
            {groups.map((g) => (
              <li>
                <a href={`#faq-${g.index}`} class="inline-flex items-center h-9 px-4 rounded-pill border border-rule-strong no-underline font-mono text-caption text-ink-2 transition-colors hover:border-signal hover:text-ink">
                  {g.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </section>

    <!-- FAQ GROUPS -->
    {groups.map((group, i) => (
      <Section id={`faq-${group.index}`} label={group.label.toLowerCase()} cv>
        <SectionHeader
          index={group.index}
          label={group.label}
          datum={`${String(group.items.length).padStart(2, '0')} QUESTIONS`}
          title={group.title}
        />
        <Accordion items={group.items} jsonLd={i === 0} />
      </Section>
    ))}

    <LeadForm context="/faq" />

  </main>
  <Footer />
</Base>
