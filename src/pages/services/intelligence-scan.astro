  @media (prefers-reduced-motion: reduce) {
    .audit-hero svg animate, .audit-hero svg animateMotion { display: none; }
    .wheel-ring-svg animate, .wheel-ring-svg animateMotion { display: none; }
    .step-card, .report-tab { transition: none !important; }
    .wheel-ring-animated, .wheel-ring-progress { animation: none !important; }
    .sample-report-cta { transition: none !important; }
