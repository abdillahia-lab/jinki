    margin-bottom: 24px;
  }

  .gradient-text-cyan {
    color: var(--accent);
  }

  .omega-hero-subtitle {
    font-family: var(--font-body);
    font-size: clamp(1rem, 1.2vw + 0.5rem, 1.125rem);
    line-height: 1.75;
    color: var(--text-secondary);
    max-width: 540px;
    margin-bottom: 32px;
  }

  .omega-hero-actions {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .omega-cta {
    font-family: var(--font-headline);
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    padding: 0.875rem 2rem;
    border-radius: 12px;
    color: #fff;
    text-decoration: none;
  }

  .omega-cta-secondary {
    font-family: var(--font-headline);
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .omega-cta-secondary:hover { color: var(--accent); }

  /* ===== SCAN INTERFACE ===== */
  .scan-interface {
    width: 100%;
    max-width: 560px;
    margin: 0 auto;
    background: #060a10;
    border-radius: 12px;
    border: 1px solid color-mix(in srgb, var(--accent) 12%, transparent);
    overflow: hidden;
    box-shadow: 0 4px 40px rgba(0,0,0,0.5), 0 0 80px color-mix(in srgb, var(--accent) 3%, transparent);
  }
  .si-toolbar {
    display: flex; justify-content: space-between; align-items: center;
    padding: 8px 16px;
    background: color-mix(in srgb, var(--accent) 3%, transparent);
    border-bottom: 1px solid color-mix(in srgb, var(--accent) 8%, transparent);
    font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.08em;
    color: color-mix(in srgb, var(--accent) 50%, transparent);
  }
  .si-toolbar-left, .si-toolbar-right { display: flex; align-items: center; gap: 8px; }
  .si-rec-dot { width: 6px; height: 6px; border-radius: 50%; background: #FF3C3C; animation: siRecBlink 1s steps(2) infinite; }
  @keyframes siRecBlink { 0% { opacity: 1; } 50% { opacity: 0; } }
  .si-rec-label { color: #FF6B6B; font-weight: 700; font-size: 0.6rem; }
  .si-divider { width: 1px; height: 10px; background: color-mix(in srgb, var(--accent) 12%, transparent); }
  .si-mode { color: color-mix(in srgb, var(--accent) 40%, transparent); }
  .si-coord { color: color-mix(in srgb, var(--accent) 35%, transparent); }
  .si-alt { color: color-mix(in srgb, var(--accent) 45%, transparent); font-weight: 600; }

  .si-viewport { position: relative; background: #04080e; }

  /* ========== HUD stage — aerial photo + scan-line + finding pins ========== */
  .si-hud-stage {
    position: relative;
    width: 100%;
    aspect-ratio: 600 / 420;
    overflow: hidden;
  }

  .si-hud-base {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  /* Sample watermark — upper-left, low opacity, non-interactive */
  .si-hud-sample {
    position: absolute;
    top: 10px;
    left: 14px;
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    color: rgba(255, 255, 255, 0.45);
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.8);
    pointer-events: none;
    user-select: none;
  }

  /* Scan-line: a glowing gradient band sweeping top to bottom every 8s */
  .si-hud-scanline {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 64px;
    pointer-events: none;
    background: linear-gradient(to bottom,
      transparent 0%,
      color-mix(in srgb, var(--accent) 12%, transparent) 55%,
      color-mix(in srgb, var(--accent) 42%, transparent) 94%,
      color-mix(in srgb, var(--accent) 72%, transparent) 100%
    );
    mix-blend-mode: screen;
    animation: si-hud-scanline-sweep 8s linear infinite;
    will-change: transform, opacity;
  }
  @keyframes si-hud-scanline-sweep {
    0%   { transform: translateY(-64px); opacity: 0; }
    6%   { opacity: 1; }
    94%  { opacity: 1; }
    100% { transform: translateY(calc(100% + 64px)); opacity: 0; }
  }

  /* Finding pins — absolute-positioned dots with pulsing ring + callout */
  .si-hud-pin {
    position: absolute;
    width: 14px;
    height: 14px;
    transform: translate(-50%, -50%);
    --sev: var(--accent);
  }
  .si-hud-pin--critical { --sev: #FF3B30; }
  .si-hud-pin--warning  { --sev: #FFBD2E; }
  .si-hud-pin--moderate { --sev: #FF8C00; }
  .si-hud-pin--info     { --sev: #00E5FF; }

  .si-hud-pin-dot {
    position: absolute;
    inset: 3px;
    border-radius: 50%;
    background: var(--sev);
    box-shadow:
      0 0 8px var(--sev),
      0 0 16px color-mix(in srgb, var(--sev) 45%, transparent);
    animation: si-hud-pin-breathe 2s ease-in-out infinite;
  }
  @keyframes si-hud-pin-breathe {
    0%, 100% { transform: scale(1); opacity: 1; }
    50%      { transform: scale(1.25); opacity: 0.85; }
  }

  .si-hud-pin-ring {
    position: absolute;
    inset: 0;
    border: 1px solid var(--sev);
    border-radius: 50%;
    opacity: 0.65;
    animation: si-hud-pin-ring 2.5s ease-out infinite;
  }
  @keyframes si-hud-pin-ring {
    0%   { transform: scale(0.75); opacity: 0.7; }
    100% { transform: scale(2.6);  opacity: 0; }
  }

  .si-hud-pin-callout {
    position: absolute;
    top: 50%;
    left: calc(100% + 10px);
    transform: translateY(-50%);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 5px 9px;
    background: rgba(8, 12, 16, 0.75);
    border: 1px solid color-mix(in srgb, var(--sev) 45%, transparent);
    border-radius: 5px;
    white-space: nowrap;
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    pointer-events: none;
  }
  /* Right-side pins flip the callout to the left of the pin */
  .si-hud-pin--left .si-hud-pin-callout {
    left: auto;
    right: calc(100% + 10px);
  }
  .si-hud-pin-sev {
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--sev);
  }
  .si-hud-pin-val {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    color: rgba(255, 255, 255, 0.85);
  }

  @media (prefers-reduced-motion: reduce) {
    .si-hud-scanline  { animation: none; opacity: 0.35; }
    .si-hud-pin-dot   { animation: none; }
    .si-hud-pin-ring  { animation: none; opacity: 0.4; transform: scale(1.8); }
  }

  /* Thermal scale */
  .si-thermal-scale {
    position: absolute; right: 12px; top: 50%; transform: translateY(-50%);
    display: flex; flex-direction: column; align-items: center; gap: 4px;
  }
  .si-scale-gradient {
    width: 8px; height: 120px; border-radius: 4px;
    background: linear-gradient(to bottom, #FF3C3C, #FF8C00, #FFB400, var(--accent-tertiary), var(--accent), #1a3040);
    opacity: 0.7;
  }
  .si-scale-labels {
    display: flex; flex-direction: column; gap: 0; height: 120px; justify-content: space-between;
    position: absolute; left: 14px; top: 0;
  }
  .si-scale-labels span { font-family: var(--font-mono); font-size: 0.45rem; color: rgba(255,255,255,0.25); white-space: nowrap; }

  /* Bottom findings panel */
  .si-bottom-panel {
    display: flex; justify-content: space-between; align-items: center;
    padding: 12px 16px;
    background: color-mix(in srgb, var(--accent) 2%, transparent);
    border-top: 1px solid color-mix(in srgb, var(--accent) 8%, transparent);
  }
  .si-finding-pills { display: flex; gap: 8px; flex-wrap: wrap; }
  .si-pill {
    display: flex; align-items: center; gap: 4px;
    font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.05em;
    padding: 3px 8px; border-radius: 4px;
  }
  .si-pill-dot { width: 5px; height: 5px; border-radius: 50%; }
  .si-pill-crit { color: rgba(255,107,107,0.8); background: rgba(255,60,60,0.08); }
  .si-pill-crit .si-pill-dot { background: #FF3C3C; }
  .si-pill-warn { color: rgba(255,208,96,0.8); background: rgba(255,180,0,0.06); }
  .si-pill-warn .si-pill-dot { background: #FFB400; }
  .si-pill-mod { color: rgba(255,176,96,0.7); background: rgba(255,140,0,0.06); }
  .si-pill-mod .si-pill-dot { background: #FF8C00; }
  .si-pill-info { color: color-mix(in srgb, var(--accent) 50%, transparent); background: color-mix(in srgb, var(--accent) 4%, transparent); }
  .si-pill-info .si-pill-dot { background: var(--accent); }
  .si-summary { display: flex; flex-direction: column; align-items: flex-end; }
  .si-total { font-family: var(--font-mono); font-size: 0.7rem; color: rgba(255,255,255,0.6); font-weight: 700; }
  .si-est { font-family: var(--font-mono); font-size: 0.6rem; color: color-mix(in srgb, var(--accent) 40%, transparent); }

  @media (max-width: 640px) {
    .scan-interface { max-width: 100%; }
    .si-toolbar { padding: 8px 12px; font-size: 0.45rem; }
    .si-toolbar-right { display: none; }
    .si-finding-pills { gap: 4px; }
    .si-pill { font-size: 0.45rem; padding: 2px 5px; }
    .si-thermal-scale { display: none; }
  }

  /* Legacy — keep for any remaining references */
  .mission-center-icon {
    position: relative;
    z-index: 2;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--accent) 8%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent) 20%, transparent);
    display: flex;
    align-items: center;
    justify-content: center;
    animation: glow-pulse 4s ease-in-out infinite;
  }

  .mission-stat-badge {
    position: absolute;
    display: flex;
    flex-direction: column;
    gap: 2px;
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(8px);
    padding: 8px 12px;
    border-radius: 8px;
    border: 1px solid color-mix(in srgb, var(--accent) 12%, transparent);
    z-index: 2;
  }

  .badge-tl { top: 16px; left: 16px; }
  .badge-tr { top: 16px; right: 16px; }
  .badge-bl { bottom: 16px; left: 16px; }
  .badge-br { bottom: 16px; right: 16px; }

  .mission-stat-label {
    font-family: var(--font-mono);
    font-size: 8px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--text-tertiary);
  }

  .mission-stat-val {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    color: var(--accent);
    letter-spacing: 0.05em;
  }

  .status-ready {
    color: #27C93F;
  }

  .mission-scan-line {
    position: absolute;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--accent), transparent);
    opacity: 0.3;
    animation: scan-move 5s ease-in-out infinite;
    z-index: 1;
  }

  @keyframes scan-move {
    0%, 100% { top: 10%; }
    50% { top: 90%; }
  }

  /* ================ SECTIONS ================ */
  .omega-section {
    padding: 5rem clamp(20px, 5vw, 80px);
  }

  @media (min-width: 768px) {
    .omega-section { padding: 7rem clamp(20px, 5vw, 80px); }
  }

  .omega-section-inner {
    max-width: var(--container-max);
    margin: 0 auto;
  }

  .omega-section-header {
    margin-bottom: 56px;
  }

  .omega-section-header h2 {
    font-family: var(--font-headline);
    font-size: clamp(1.75rem, 3vw + 0.5rem, 2.75rem);
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.15;
    margin-top: 8px;
  }

  .omega-section-subtitle {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    color: var(--text-secondary);
    line-height: 1.7;
    max-width: 640px;
    margin-top: 16px;
  }

  /* ================ PROCESS WHEEL ================ */
  .process-wheel-container {
    position: relative;
  }

  .process-wheel {
    display: none;
    position: relative;
    width: 480px;
    height: 480px;
    margin: 0 auto 40px;
  }

  @media (min-width: 768px) {
    .process-wheel { display: block; }
    .process-mobile-list { display: none !important; }
  }

  .wheel-ring-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .wheel-center {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 140px;
    height: 140px;
    border-radius: 50%;
    background: var(--surface-container-low);
    border: 2px solid color-mix(in srgb, var(--accent) 15%, transparent);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
    box-shadow: 0 0 40px color-mix(in srgb, var(--accent) 10%, transparent);
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .wheel-center-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    text-align: center;
  }

  .wheel-center-icon {
    color: var(--accent);
    font-size: 28px;
  }

  .wheel-center-step {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.15em;
    color: var(--accent);
  }

  .wheel-center-title {
    font-family: var(--font-headline);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--text-primary);
    max-width: 100px;
    line-height: 1.2;
  }

  .wheel-node {
    position: absolute;
    width: 72px;
    height: 72px;
    margin-left: -36px;
    margin-top: -36px;
    border-radius: 50%;
    background: var(--surface-container);
    border: 2px solid var(--glass-border);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    cursor: pointer;
    transition: border-color 0.3s ease, background 0.3s ease, box-shadow 0.3s var(--ease-out-premium), transform 0.3s var(--ease-out-premium);
    z-index: 3;
  }

  .wheel-node:hover,
  .wheel-node.active {
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 8%, transparent);
    box-shadow: 0 0 24px color-mix(in srgb, var(--accent) 20%, transparent);
    transform: scale(1.1);
  }

  .wheel-node.active {
    border-width: 2px;
  }

  .wheel-node-num {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--accent);
    letter-spacing: 0.1em;
  }

  .wheel-node-label {
    font-family: var(--font-label);
    font-size: 8px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-secondary);
    text-align: center;
    line-height: 1.1;
    max-width: 60px;
  }

  .wheel-outer-label {
    font-family: var(--font-label);
    font-size: 2.6px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    fill: var(--text-tertiary);
    opacity: 0.5;
    transition: opacity 0.3s ease;
  }

  :global([data-theme="light"]) .wheel-outer-label {
    fill: var(--text-tertiary);
    opacity: 0.6;
  }

  .wheel-detail-panel {
    display: none;
    text-align: center;
    max-width: 560px;
    margin: 0 auto;
  }

  @media (min-width: 768px) {
    .wheel-detail-panel { display: block; }
  }

  .wheel-detail-desc {
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--text-secondary);
    line-height: 1.7;
    transition: opacity 0.3s ease;
  }

  /* Mobile process list */
  .process-mobile-list {
    display: flex;
    flex-direction: column;
  }

  @media (min-width: 768px) {
    .process-mobile-list { display: none; }
  }

  .process-mobile-item {
    display: flex;
    gap: 20px;
    padding: 20px 0;
  }

  .process-mobile-marker {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex-shrink: 0;
  }

  .process-mobile-step {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--accent);
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 2px solid var(--accent);
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--accent-glow);
  }

  .process-mobile-connector {
    width: 2px;
    flex: 1;
    background: linear-gradient(to bottom, var(--accent), transparent);
    min-height: 24px;
  }

  .process-mobile-icon-wrap {
    width: 36px;
    height: 36px;
    border-radius: 12px;
    background: var(--accent-glow);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 12px;
    color: var(--accent);
  }

  .process-mobile-body h3 {
    font-family: var(--font-headline);
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 8px;
  }

  .process-mobile-body p {
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.7;
  }

  /* ================ FINDINGS GALLERY ================ */
  .findings-gallery {
    position: relative;
  }

  .findings-carousel {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
  }

  @media (min-width: 600px) {
    .findings-carousel { grid-template-columns: repeat(2, 1fr); }
  }

  @media (min-width: 1024px) {
    .findings-carousel { grid-template-columns: repeat(4, 1fr); }
  }

  .finding-card {
    background: var(--surface-container-low);
    border: 1px solid var(--glass-border);
    border-radius: 16px;
    overflow: hidden;
    transition: transform 0.4s var(--ease-out-premium),
                box-shadow 0.4s var(--ease-out-premium),
                border-color 0.4s ease;
  }

  .finding-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.2), 0 0 20px color-mix(in srgb, var(--accent) 5%, transparent);
    border-color: color-mix(in srgb, var(--accent) 15%, transparent);
  }

  .finding-image-area {
    position: relative;
    aspect-ratio: 4 / 3;
    background: linear-gradient(135deg, #0a0c10, #141820);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  /* Unified finding-card visual: same real aerial photo, cropped to a
     different region per finding type via background-position. One pulsing
     severity pin at center, one mono-text readout in the bottom-left.
     Replaces: .finding-visual / .thermal-grid / .thermal-cell / .t-cool/warm
     / .t-hot / .t-critical / .thermal-crosshair / .thermal-readout /
     .thermal-temp / .thermal-label / .structural-svg / .structural-badge /
     .structural-rating / .structural-label / .radar-container / .radar-svg /
     .radar-sweep / .efficiency-svg / .efficiency-readout / .efficiency-loss /
     .efficiency-label (all removed). */
  .finding-crop {
    position: absolute;
    inset: 0;
    background-image: url('/images/dc-rooftop-aerial.webp');
    background-size: 220%;
    background-repeat: no-repeat;
    /* background-position is set inline per-card */
    --sev-color: var(--accent);
  }
  .finding-crop::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(4, 8, 14, 0.15) 0%, rgba(4, 8, 14, 0.55) 100%);
    pointer-events: none;
  }

  .finding-pin {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 18px;
    height: 18px;
    transform: translate(-50%, -50%);
    z-index: 1;
  }
  .finding-pin-dot {
    position: absolute;
    inset: 4px;
    border-radius: 50%;
    background: var(--sev-color);
    box-shadow:
      0 0 10px var(--sev-color),
      0 0 20px color-mix(in srgb, var(--sev-color) 45%, transparent);
    animation: si-hud-pin-breathe 2s ease-in-out infinite;
  }
  .finding-pin-ring {
    position: absolute;
    inset: 0;
    border: 1.5px solid var(--sev-color);
    border-radius: 50%;
    opacity: 0.7;
    animation: si-hud-pin-ring 2.5s ease-out infinite;
  }

  .finding-readout {
    position: absolute;
    bottom: 12px;
    left: 12px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 5px 10px;
    background: rgba(8, 12, 16, 0.72);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 5px;
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    z-index: 2;
  }
  .finding-readout-sev {
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .finding-readout-val {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    color: rgba(255, 255, 255, 0.85);
  }

  .finding-sample-mark {
    position: absolute;
    top: 10px;
    right: 12px;
    font-family: var(--font-mono);
    font-size: 0.5rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    color: rgba(255, 255, 255, 0.45);
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.8);
    pointer-events: none;
    user-select: none;
    z-index: 2;
  }

  @media (prefers-reduced-motion: reduce) {
    .finding-pin-dot  { animation: none; }
    .finding-pin-ring { animation: none; opacity: 0.4; transform: scale(1.8); }
  }

  .finding-severity-badge {
    position: absolute;
    top: 10px;
    left: 10px;
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 4px 12px;
    border-radius: 8px;
    border: 1px solid;
  }

  .finding-category-badge {
    position: absolute;
    top: 10px;
    right: 10px;
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 4px 12px;
    border-radius: 8px;
    background: rgba(0, 0, 0, 0.5);
    color: var(--text-secondary);
    backdrop-filter: blur(4px);
  }

  .finding-info {
    padding: 16px;
  }

  .finding-info h3 {
    font-family: var(--font-headline);
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 8px;
    line-height: 1.3;
  }

  .finding-meta {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .finding-meta-item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-tertiary);
  }

  .findings-nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    margin-top: 32px;
  }

  @media (min-width: 1024px) {
    .findings-nav { display: none; }
  }

  .findings-nav-btn {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--surface-container);
    border: 1px solid var(--glass-border);
    color: var(--text-secondary);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: border-color 0.2s ease, color 0.2s ease;
  }

  .findings-nav-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .findings-dots {
    display: flex;
    gap: 8px;
  }

  .findings-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--glass-border);
    border: none;
    cursor: pointer;
    transition: background 0.2s ease, box-shadow 0.3s var(--ease-out-premium), transform 0.3s var(--ease-out-premium);
  }

  .findings-dot.active {
    background: var(--accent);
    box-shadow: 0 0 8px var(--accent-glow);
  }

  /* ================ COMPARISON ================ */
  .comparison-container {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }

  @media (min-width: 768px) {
    .comparison-container {
      grid-template-columns: 1fr auto 1fr;
      gap: 0;
    }
  }

  .comparison-side {
    background: var(--surface-container-low);
    border: 1px solid var(--glass-border);
    border-radius: 16px;
    overflow: hidden;
    transition: transform 0.4s var(--ease-out-premium),
                box-shadow 0.4s var(--ease-out-premium);
  }

  .comparison-side:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-elevated);
  }

  .comparison-header-bar {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px 24px;
  }

  .comparison-header-bar h3 {
    font-family: var(--font-headline);
    font-size: 0.9375rem;
    font-weight: 700;
  }

  .traditional-bar {
    background: rgba(255, 59, 48, 0.08);
    border-bottom: 1px solid rgba(255, 59, 48, 0.15);
    color: #FF6B6B;
  }

  .traditional-bar h3 { color: #FF6B6B; }

  .jinki-bar {
    background: color-mix(in srgb, var(--accent) 6%, transparent);
    border-bottom: 1px solid color-mix(in srgb, var(--accent) 15%, transparent);
    color: var(--accent);
  }

  .jinki-bar h3 { color: var(--accent); }

  .comparison-list {
    list-style: none;
    padding: 20px 24px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .comparison-list li {
    display: flex;
    gap: 12px;
    align-items: flex-start;
  }

  .cmp-icon {
    font-size: 18px;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .comparison-negative .cmp-icon { color: #FF6B6B; }
  .comparison-positive .cmp-icon { color: #27C93F; }

  .comparison-list li strong {
    display: block;
    font-family: var(--font-headline);
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 2px;
  }

  .comparison-list li span {
    font-size: 0.8125rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .comparison-divider {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 20px;
  }

  .comparison-vs {
    font-family: var(--font-headline);
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--text-tertiary);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    background: var(--surface-dim);
    padding: 8px 16px;
    border-radius: 16px;
    border: 1px solid var(--glass-border);
  }

  @media (max-width: 767px) {
    .comparison-divider {
      padding: 0;
    }
  }

  .report-disclaimer {
    display: flex;
    align-items: center;
    gap: 8px;
    justify-content: center;
    font-family: var(--font-body);
    font-size: 0.8125rem;
    color: var(--text-tertiary);
    margin-top: 16px;
  }
  .report-disclaimer .material-symbols-outlined {
    font-size: 16px;
    font-variation-settings: 'FILL' 1;
  }

  /* ================ REPORT TABS ================ */
  .sample-report-cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 20px;
    padding: 12px 20px;
    border-radius: 10px;
    border: 1px solid color-mix(in srgb, var(--accent) 20%, transparent);
    background: color-mix(in srgb, var(--accent) 4%, transparent);
    color: var(--accent);
    font-family: var(--font-label);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease, transform 0.3s ease;
  }

  .sample-report-cta:hover {
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    border-color: color-mix(in srgb, var(--accent) 35%, transparent);
    box-shadow: 0 0 20px color-mix(in srgb, var(--accent) 10%, transparent);
    transform: translateY(-1px);
  }

  .sample-report-meta {
    color: var(--text-tertiary);
    font-weight: 500;
    font-size: 0.75rem;
    letter-spacing: 0.03em;
    text-transform: none;
  }

  :global([data-theme="light"]) .sample-report-cta {
    border-color: rgba(0, 151, 167, 0.2);
    background: rgba(0, 151, 167, 0.04);
    color: #0097A7;
  }

  :global([data-theme="light"]) .sample-report-cta:hover {
    background: rgba(0, 151, 167, 0.1);
    border-color: rgba(0, 151, 167, 0.35);
    box-shadow: 0 0 20px rgba(0, 151, 167, 0.08);
  }

  .report-tabs-container {
    background: var(--surface-container-low);
    border: 1px solid var(--glass-border);
    border-radius: 16px;
    overflow: hidden;
  }

  .report-tabs {
    display: flex;
    overflow-x: auto;
    border-bottom: 1px solid var(--glass-border);
    scrollbar-width: none;
  }

  .report-tabs::-webkit-scrollbar { display: none; }

  .report-tab {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 16px 20px;
    font-family: var(--font-label);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-tertiary);
    background: none;
    border: none;
    border-bottom: 2px solid transparent;
    cursor: pointer;
    transition: color 0.2s ease, background 0.2s ease, border-bottom-color 0.2s ease;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .report-tab:hover {
    color: var(--text-secondary);
    background: color-mix(in srgb, var(--accent) 3%, transparent);
  }

  .report-tab.active {
    color: var(--accent);
    border-bottom-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 5%, transparent);
  }

  .report-tab-label {
    font-family: inherit;
    font-size: inherit;
    font-weight: inherit;
    letter-spacing: inherit;
    color: inherit;
  }

  .report-panels {
    padding: 32px;
  }

  .report-panel {
    display: none;
  }

  .report-panel.active {
    display: block;
  }

  .report-panel-mockup {
    background: linear-gradient(135deg, #0a0c10, #141820);
    border-radius: 12px;
    border: 1px solid var(--glass-border);
    overflow: hidden;
  }

  .report-panel-header {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 16px;
    background: rgba(0, 0, 0, 0.3);
    border-bottom: 1px solid var(--glass-border);
  }

  .report-panel-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .report-panel-title {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-tertiary);
    letter-spacing: 0.05em;
    margin-left: 8px;
  }

  .report-panel-body {
    padding: 32px;
  }

  .report-panel-content-grid {
    display: grid;
