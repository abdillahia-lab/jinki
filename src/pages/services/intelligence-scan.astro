---
/*
  TEAM OMEGA — Facility Intelligence Scan | Jinki Aerial Intelligence
  Redesigned: cinematic mission-briefing aesthetic with interactive process wheel,
  findings gallery, comparison, and tabbed deliverable preview.
*/
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import LeadGen from '../../components/LeadGen.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Footer from '../../components/Footer.astro';

const process = [
  { step: '01', title: 'Scoping Call', desc: 'We learn your facility, your priorities, and your pain points. A real conversation about what matters to your operations team.', icon: 'call' },
  { step: '02', title: 'Flight Planning', desc: 'Airspace authorization, safety planning, and mission design tailored to your site geometry and inspection requirements.', icon: 'flight_takeoff' },
  { step: '03', title: 'Data Capture', desc: 'On-site aerial operations. Thermal and high-resolution visual data across every structure — typically completed in a single day.', icon: 'satellite_alt' },
  { step: '04', title: 'AI Analysis', desc: 'Our analytics pipeline processes thousands of data points: anomaly detection, severity classification, and automated damage assessment.', icon: 'model_training' },
  { step: '05', title: 'Report', desc: 'The Facility Intelligence Report: severity-ranked findings, remediation priorities, cost estimates, and suggested timelines.', icon: 'assignment' },
  { step: '06', title: 'Review & Handoff', desc: 'We walk your team through every finding. Questions answered, priorities confirmed, and a clear path forward.', icon: 'groups' },
];

---

<Layout ogImage="/images/og-audit.png" title="Facility Intelligence Scan — Jinki Aerial Intelligence" description="Comprehensive aerial assessment of your facility. One mission. One report. Clear next steps." jsonLd={{
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Facility Intelligence Scan",
  "provider": { "@type": "Organization", "name": "Jinki Aerial Intelligence" },
  "description": "Comprehensive aerial thermal and visual assessment of facility infrastructure with prioritized intelligence report delivered within 48 hours.",
  "areaServed": "Mid-Atlantic United States",
  "serviceType": "Aerial Infrastructure Inspection",
}}>
  <Nav />
  <Breadcrumb items={[{ label: "Services" }, { label: "Facility Intelligence Scan" }]} />
  <main id="main-content">

    <!-- ============ HERO — Mission Briefing ============ -->
    <section class="omega-hero" aria-label="Facility Intelligence Scan">
      <div class="omega-hero-inner">
        <div class="omega-hero-content reveal">
          <div class="omega-eyebrow">
            <span class="omega-eyebrow-line"></span>
            <span class="omega-eyebrow-text">Mission Briefing</span>
          </div>
          <h1 class="omega-hero-title">
            One Mission.<br/>
            <span class="gradient-text-cyan">Total Facility Intelligence.</span>
          </h1>
          <p class="omega-hero-subtitle">
            Jinki's Facility Intelligence Scan combines thermal diagnostics, structural assessment,
            and security evaluation into a single engagement. You receive a prioritized recommendations
            report — not raw data. Clear findings. Clear next steps.
          </p>
          <div class="omega-hero-actions">
            <a href="#lead-gen" class="btn-premium omega-cta">Request Assessment</a>
            <a href="#process" class="omega-cta-secondary">See the Process</a>
          </div>
        </div>
        <div class="omega-hero-visual reveal reveal-delay-1" aria-hidden="true">
          <div class="scan-interface">
            <!-- Top toolbar -->
            <div class="si-toolbar">
              <div class="si-toolbar-left">
                <span class="si-rec-dot"></span>
                <span class="si-rec-label">REC</span>
                <span class="si-divider"></span>
                <span class="si-mode">THERMAL + VISUAL</span>
              </div>
              <div class="si-toolbar-right">
                <span class="si-coord">38.9536°N 77.4484°W</span>
                <span class="si-divider"></span>
                <span class="si-alt">ALT 120m</span>
              </div>
            </div>

            <!-- Main scan viewport: real aerial photo + HUD annotation overlay.
                 No simulated thermal — a false-colored visible-light photo is
                 NOT a thermal image. Instead we show what a real Facility
                 Intelligence Scan deliverable looks like: the aerial photo
                 with geolocated finding pins + measurement callouts, plus
                 an always-on scan-line sweep for ambient motion. -->
            <div class="si-viewport">
              <div class="si-hud-stage">
                <img
                  src="/images/dc-rooftop-aerial.webp"
                  alt="Data center rooftop aerial view with illustrative finding annotations"
                  class="si-hud-base"
                  loading="eager"
                  decoding="async"
                  fetchpriority="high"
                />

                <!-- Animated scan-line — drops top to bottom every 8s -->
                <div class="si-hud-scanline" aria-hidden="true"></div>

                <!-- Illustrative finding pins (positions tuned visually to the photo) -->
                <div class="si-hud-pin si-hud-pin--critical" style="left: 42%; top: 24%;" aria-hidden="true">
                  <span class="si-hud-pin-ring"></span>
                  <span class="si-hud-pin-dot"></span>
                  <span class="si-hud-pin-callout">
                    <span class="si-hud-pin-sev">CRITICAL</span>
                    <span class="si-hud-pin-val">HVAC-05 · 47.3°C</span>
                  </span>
                </div>

                <div class="si-hud-pin si-hud-pin--warning" style="left: 32%; top: 60%;" aria-hidden="true">
                  <span class="si-hud-pin-ring"></span>
                  <span class="si-hud-pin-dot"></span>
                  <span class="si-hud-pin-callout">
                    <span class="si-hud-pin-sev">WARNING</span>
                    <span class="si-hud-pin-val">Membrane split · 12m</span>
                  </span>
                </div>

                <div class="si-hud-pin si-hud-pin--moderate si-hud-pin--left" style="left: 64%; top: 46%;" aria-hidden="true">
                  <span class="si-hud-pin-ring"></span>
                  <span class="si-hud-pin-dot"></span>
                  <span class="si-hud-pin-callout">
                    <span class="si-hud-pin-sev">MODERATE</span>
                    <span class="si-hud-pin-val">CT-3 · ΔT +8.2°C</span>
                  </span>
                </div>

                <div class="si-hud-pin si-hud-pin--info si-hud-pin--left" style="left: 80%; top: 28%;" aria-hidden="true">
                  <span class="si-hud-pin-ring"></span>
                  <span class="si-hud-pin-dot"></span>
                  <span class="si-hud-pin-callout">
                    <span class="si-hud-pin-sev">INFO</span>
                    <span class="si-hud-pin-val">Genset · nominal</span>
                  </span>
                </div>

                <!-- Sample watermark — buyer shouldn't mistake illustrative pins for real data -->
                <span class="si-hud-sample" aria-hidden="true">SAMPLE SCAN · ILLUSTRATIVE ANNOTATIONS</span>
              </div>

              <!-- Thermal scale bar (atmospheric chrome — orients the eye, not a claim) -->
              <div class="si-thermal-scale">
                <div class="si-scale-gradient"></div>
                <div class="si-scale-labels">
                  <span>18°C</span><span>28°</span><span>38°</span><span>48°C</span>
                </div>
              </div>
            </div>

            <!-- Bottom panel — findings summary -->
            <div class="si-bottom-panel">
              <div class="si-finding-pills">
                <span class="si-pill si-pill-crit"><span class="si-pill-dot"></span>3 Critical</span>
                <span class="si-pill si-pill-warn"><span class="si-pill-dot"></span>5 Warning</span>
                <span class="si-pill si-pill-mod"><span class="si-pill-dot"></span>4 Moderate</span>
                <span class="si-pill si-pill-info"><span class="si-pill-dot"></span>2 Info</span>
              </div>
              <div class="si-summary">
                <span class="si-total">14 findings</span>
                <span class="si-est">Est. $51,500</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ CAPABILITY ============ -->
    <section class="is-section is-capability" aria-label="Platform capabilities">
      <div class="is-inner">
        <div class="is-section-header reveal">
          <span class="is-eyebrow">Capability</span>
          <h2>What a single aerial mission captures.</h2>
        </div>

        <div class="is-capability-grid reveal">
          <div class="is-stat">
            <span class="is-stat-val">0.5°C</span>
            <span class="is-stat-lbl">Radiometric thermal sensitivity — early-stage degradation detected before operational impact.</span>
          </div>
          <div class="is-stat">
            <span class="is-stat-val">100%</span>
            <span class="is-stat-lbl">Rooftop coverage per mission — no scaffolding, no personnel on the membrane, no operational disruption.</span>
          </div>
          <div class="is-stat">
            <span class="is-stat-val">48 hr</span>
            <span class="is-stat-lbl">From mission to prioritized report — severity-ranked findings delivered within two business days.</span>
          </div>
          <div class="is-stat">
            <span class="is-stat-val">NFPA 70B</span>
            <span class="is-stat-lbl">Aligned severity classification — reports map directly to the electrical maintenance standard your team already uses.</span>
          </div>
        </div>

        <blockquote class="is-pull-quote reveal">
          &ldquo;73% of cooling system failures show detectable thermal signatures weeks before catastrophic failure.&rdquo;
          <cite>— ASHRAE / Uptime Institute</cite>
        </blockquote>
      </div>
    </section>

    <!-- ============ PROCESS ============ -->
    <section id="process" class="is-section is-process" style="background: var(--surface-dim);" aria-label="Engagement process">
      <div class="is-inner">
        <div class="is-section-header reveal">
          <span class="is-eyebrow">Engagement</span>
          <h2>Six steps. Two to three weeks end-to-end.</h2>
          <p class="is-section-lede">
            Signed Monday, flying Friday. From signed engagement to delivered report, typically inside fifteen business days.
          </p>
        </div>

        <ol class="is-process-timeline reveal">
          {process.map((step) => (
            <li class="is-step">
              <span class="is-step-num">{step.step}</span>
              <h3 class="is-step-title">{step.title}</h3>
              <p class="is-step-desc">{step.desc}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- ============ THE DELIVERABLE ============ -->
    <section class="is-section is-receive" aria-label="The deliverable">
      <div class="is-inner">
        <div class="is-section-header reveal">
          <span class="is-eyebrow">The Deliverable</span>
          <h2>Prioritized. Geolocated. Action-ready.</h2>
          <p class="is-section-lede">
            One PDF engineered for the next maintenance window — not a file dump of raw imagery. Every finding is ranked, located, and paired with a recommended action.
          </p>
        </div>

        <div class="is-receive-grid reveal">
          <div class="is-receive-item">
            <span class="material-symbols-outlined is-receive-icon" aria-hidden="true">summarize</span>
            <h3>Executive Summary</h3>
            <p>Facility health score, total findings by severity, and recommended priority actions for leadership review.</p>
          </div>
          <div class="is-receive-item">
            <span class="material-symbols-outlined is-receive-icon" aria-hidden="true">location_on</span>
            <h3>Geolocated Findings</h3>
            <p>Every anomaly mapped to a specific rooftop coordinate, with &Delta;T measurements, equipment ID, and severity rating.</p>
          </div>
          <div class="is-receive-item">
            <span class="material-symbols-outlined is-receive-icon" aria-hidden="true">roofing</span>
            <h3>Structural Assessment</h3>
            <p>Membrane condition ratings, area measurements, degradation velocity, and projected repair cost for every roof section.</p>
          </div>
          <div class="is-receive-item">
            <span class="material-symbols-outlined is-receive-icon" aria-hidden="true">verified</span>
            <h3>Compliance Package</h3>
            <p>NFPA 70B alignment, ASHRAE temperature verification, inspection certificates, and full audit trail for every data point.</p>
          </div>
        </div>

        <a href="#lead-gen" class="is-report-cta reveal">
          <span class="material-symbols-outlined" aria-hidden="true">description</span>
          <span class="is-report-cta-text">Request Sample Report</span>
          <span class="is-report-cta-meta">4-page PDF · no sales call required</span>
        </a>
      </div>
    </section>

    <!-- Cross-links to verticals -->
    <section class="reveal" style="max-width: 900px; margin: 0 auto; padding: 0 1.5rem 3rem;" aria-label="Industries we serve">
      <p style="text-align: center; font-family: var(--font-label); font-size: 0.75rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-tertiary); margin-bottom: 1rem;">Industries We Serve</p>
      <div style="display: flex; gap: 0.75rem; flex-wrap: wrap; justify-content: center;">
        <a href="/verticals/data-centers" style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.6rem 1.25rem; border-radius: 8px; border: 1px solid var(--glass-border); background: var(--glass-bg); color: var(--text-secondary); font-family: var(--font-label); font-size: 0.75rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; text-decoration: none; transition: background 0.25s ease, color 0.25s ease, border-color 0.25s ease, transform 0.25s ease;">Data Centers</a>
        <a href="/verticals/energy-grid" style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.6rem 1.25rem; border-radius: 8px; border: 1px solid var(--glass-border); background: var(--glass-bg); color: var(--text-secondary); font-family: var(--font-label); font-size: 0.75rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; text-decoration: none; transition: background 0.25s ease, color 0.25s ease, border-color 0.25s ease, transform 0.25s ease;">Energy & Grid</a>
        <a href="/verticals/security" style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.6rem 1.25rem; border-radius: 8px; border: 1px solid var(--glass-border); background: var(--glass-bg); color: var(--text-secondary); font-family: var(--font-label); font-size: 0.75rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; text-decoration: none; transition: background 0.25s ease, color 0.25s ease, border-color 0.25s ease, transform 0.25s ease;">Perimeter Security</a>
        <a href="/verticals/agriculture" style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.6rem 1.25rem; border-radius: 8px; border: 1px solid var(--glass-border); background: var(--glass-bg); color: var(--text-secondary); font-family: var(--font-label); font-size: 0.75rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; text-decoration: none; transition: background 0.25s ease, color 0.25s ease, border-color 0.25s ease, transform 0.25s ease;">Agriculture</a>
      </div>
    </section>

    <LeadGen />
  </main>
  <Footer />
</Layout>

<style>
  /* ================ HERO ================ */
  .omega-hero {
    min-height: 90vh;
    display: flex;
    align-items: center;
    padding: 140px clamp(20px, 5vw, 80px) 60px;
    background: var(--surface-container-lowest);
    position: relative;
    overflow: hidden;
  }

  .omega-hero-inner {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 60px;
    align-items: center;
    max-width: var(--container-max);
    margin: 0 auto;
    width: 100%;
  }

  .omega-eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
  }

  .omega-eyebrow-line {
    display: block;
    width: 32px;
    height: 1px;
    background: var(--accent);
  }

  .omega-eyebrow-text {
    font-family: var(--font-label);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.3em;
    color: var(--accent);
  }

  .omega-hero-title {
    font-family: var(--font-headline);
    font-size: clamp(2rem, 4vw + 0.5rem, 3.5rem);
    font-weight: 700;
    line-height: 1.1;
    color: var(--text-primary);
    margin-bottom: 24px;
  }

  .gradient-text-cyan {
    color: var(--accent);
  }

  .omega-hero-subtitle {
    font-family: var(--font-body);
    font-size: clamp(1rem, 1.2vw + 0.5rem, 1.125rem);
    line-height: 1.75;
    color: var(--text-secondary);
    max-width: 540px;
    margin-bottom: 32px;
  }

  .omega-hero-actions {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .omega-cta {
    font-family: var(--font-headline);
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    padding: 0.875rem 2rem;
    border-radius: 12px;
    color: #fff;
    text-decoration: none;
  }

  .omega-cta-secondary {
    font-family: var(--font-headline);
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .omega-cta-secondary:hover { color: var(--accent); }

  /* ===== SCAN INTERFACE ===== */
  .scan-interface {
    width: 100%;
    max-width: 560px;
    margin: 0 auto;
    background: #060a10;
    border-radius: 12px;
    border: 1px solid color-mix(in srgb, var(--accent) 12%, transparent);
    overflow: hidden;
    box-shadow: 0 4px 40px rgba(0,0,0,0.5), 0 0 80px color-mix(in srgb, var(--accent) 3%, transparent);
  }
  .si-toolbar {
    display: flex; justify-content: space-between; align-items: center;
    padding: 8px 16px;
    background: color-mix(in srgb, var(--accent) 3%, transparent);
    border-bottom: 1px solid color-mix(in srgb, var(--accent) 8%, transparent);
    font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.08em;
    color: color-mix(in srgb, var(--accent) 50%, transparent);
  }
  .si-toolbar-left, .si-toolbar-right { display: flex; align-items: center; gap: 8px; }
  .si-rec-dot { width: 6px; height: 6px; border-radius: 50%; background: #FF3C3C; animation: siRecBlink 1s steps(2) infinite; }
  @keyframes siRecBlink { 0% { opacity: 1; } 50% { opacity: 0; } }
  .si-rec-label { color: #FF6B6B; font-weight: 700; font-size: 0.6rem; }
  .si-divider { width: 1px; height: 10px; background: color-mix(in srgb, var(--accent) 12%, transparent); }
  .si-mode { color: color-mix(in srgb, var(--accent) 40%, transparent); }
  .si-coord { color: color-mix(in srgb, var(--accent) 35%, transparent); }
  .si-alt { color: color-mix(in srgb, var(--accent) 45%, transparent); font-weight: 600; }

  .si-viewport { position: relative; background: #04080e; }

  /* ========== HUD stage — aerial photo + scan-line + finding pins ========== */
  .si-hud-stage {
    position: relative;
    width: 100%;
    aspect-ratio: 600 / 420;
    overflow: hidden;
  }

  .si-hud-base {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  /* Sample watermark — upper-left, low opacity, non-interactive */
  .si-hud-sample {
    position: absolute;
    top: 10px;
    left: 14px;
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    color: rgba(255, 255, 255, 0.45);
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.8);
    pointer-events: none;
    user-select: none;
  }

  /* Scan-line: a glowing gradient band sweeping top to bottom every 8s */
  .si-hud-scanline {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 64px;
    pointer-events: none;
    background: linear-gradient(to bottom,
      transparent 0%,
      color-mix(in srgb, var(--accent) 12%, transparent) 55%,
      color-mix(in srgb, var(--accent) 42%, transparent) 94%,
      color-mix(in srgb, var(--accent) 72%, transparent) 100%
    );
    mix-blend-mode: screen;
    animation: si-hud-scanline-sweep 8s linear infinite;
    will-change: transform, opacity;
  }
  @keyframes si-hud-scanline-sweep {
    0%   { transform: translateY(-64px); opacity: 0; }
    6%   { opacity: 1; }
    94%  { opacity: 1; }
    100% { transform: translateY(calc(100% + 64px)); opacity: 0; }
  }

  /* Finding pins — absolute-positioned dots with pulsing ring + callout */
  .si-hud-pin {
    position: absolute;
    width: 14px;
    height: 14px;
    transform: translate(-50%, -50%);
    --sev: var(--accent);
  }
  .si-hud-pin--critical { --sev: #FF3B30; }
  .si-hud-pin--warning  { --sev: #FFBD2E; }
  .si-hud-pin--moderate { --sev: #FF8C00; }
  .si-hud-pin--info     { --sev: #00E5FF; }

  .si-hud-pin-dot {
    position: absolute;
    inset: 3px;
    border-radius: 50%;
    background: var(--sev);
    box-shadow:
      0 0 8px var(--sev),
      0 0 16px color-mix(in srgb, var(--sev) 45%, transparent);
    animation: si-hud-pin-breathe 2s ease-in-out infinite;
  }
  @keyframes si-hud-pin-breathe {
    0%, 100% { transform: scale(1); opacity: 1; }
    50%      { transform: scale(1.25); opacity: 0.85; }
  }

  .si-hud-pin-ring {
    position: absolute;
    inset: 0;
    border: 1px solid var(--sev);
    border-radius: 50%;
    opacity: 0.65;
    animation: si-hud-pin-ring 2.5s ease-out infinite;
  }
  @keyframes si-hud-pin-ring {
    0%   { transform: scale(0.75); opacity: 0.7; }
    100% { transform: scale(2.6);  opacity: 0; }
  }

  .si-hud-pin-callout {
    position: absolute;
    top: 50%;
    left: calc(100% + 10px);
    transform: translateY(-50%);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 5px 9px;
    background: rgba(8, 12, 16, 0.75);
    border: 1px solid color-mix(in srgb, var(--sev) 45%, transparent);
    border-radius: 5px;
    white-space: nowrap;
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    pointer-events: none;
  }
  /* Right-side pins flip the callout to the left of the pin */
  .si-hud-pin--left .si-hud-pin-callout {
    left: auto;
    right: calc(100% + 10px);
  }
  .si-hud-pin-sev {
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--sev);
  }
  .si-hud-pin-val {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    color: rgba(255, 255, 255, 0.85);
  }

  @media (prefers-reduced-motion: reduce) {
    .si-hud-scanline  { animation: none; opacity: 0.35; }
    .si-hud-pin-dot   { animation: none; }
    .si-hud-pin-ring  { animation: none; opacity: 0.4; transform: scale(1.8); }
  }

  /* Thermal scale */
  .si-thermal-scale {
    position: absolute; right: 12px; top: 50%; transform: translateY(-50%);
    display: flex; flex-direction: column; align-items: center; gap: 4px;
  }
  .si-scale-gradient {
    width: 8px; height: 120px; border-radius: 4px;
    background: linear-gradient(to bottom, #FF3C3C, #FF8C00, #FFB400, var(--accent-tertiary), var(--accent), #1a3040);
    opacity: 0.7;
  }
  .si-scale-labels {
    display: flex; flex-direction: column; gap: 0; height: 120px; justify-content: space-between;
    position: absolute; left: 14px; top: 0;
  }
