    transform-origin: 50% 50%;
  }

  @keyframes wheel-dash-spin {
    to { stroke-dashoffset: -264; }
  }

  @keyframes wheel-progress-spin {
    to { stroke-dashoffset: -264; }
  }

  /* ================ REPORT MOCKUP PAGE-TURN SHADOW ================ */
  .report-panel-mockup {
    position: relative;
  }

  .report-panel-mockup::after {
    content: '';
    position: absolute;
    top: 20px;
    right: -4px;
    bottom: 20px;
    width: 12px;
    background: linear-gradient(90deg,
      rgba(0, 0, 0, 0.15),
      rgba(0, 0, 0, 0.06) 40%,
      transparent 100%
    );
    border-radius: 0 4px 4px 0;
    pointer-events: none;
    opacity: 0.7;
  }

  .report-panel-mockup::before {
    content: '';
    position: absolute;
    top: 6px;
    right: -2px;
    bottom: 6px;
    width: 8px;
    background: linear-gradient(135deg, #0a0c10, #141820);
    border: 1px solid var(--glass-border);
    border-left: none;
    border-radius: 0 6px 6px 0;
    pointer-events: none;
    z-index: -1;
    opacity: 0.6;
  }

  :global([data-theme="light"]) .report-panel-mockup::before {
    background: linear-gradient(135deg, #e8eaed, #f0f0f0);
  }

  :global([data-theme="light"]) .report-panel-mockup::after {
