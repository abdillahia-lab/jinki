  /* ================ RESPONSIVE ================ */
  @media (max-width: 767px) {
    .omega-hero-inner {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .omega-hero {
      min-height: auto;
      padding-top: 120px;
    }

