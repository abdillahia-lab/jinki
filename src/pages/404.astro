---
/*
  404 — Signal lost. A frame requested outside the surveyed area.
  One folio rule, one display line, an empty annotation box, two exits.
*/
import Base from '../layouts/Base.astro';
import Nav from '../components/ui/Nav.astro';
import Footer from '../components/ui/Footer.astro';
import Button from '../components/ui/Button.astro';
---

<Base
  title="404 — Signal Lost | Jinki Aerial Intelligence"
  description="No finding at these coordinates. The page you requested is outside the surveyed area."
>
  <Nav />
  <main id="main-content">
    <section aria-label="Page not found" class="pt-10 md:pt-16 pb-24 md:pb-32 min-h-[70vh]">
      <div class="max-w-brief mx-auto px-5 sm:px-8 lg:px-12 2xl:px-16">
        <div class="folio-rule rule-draw flex items-baseline justify-between gap-4 pt-3 mb-12">
          <span class="mono-label text-ink-3"><span class="text-signal">404</span>&nbsp;/&nbsp;SIGNAL LOST</span>
          <span class="mono-label text-ink-3 hidden sm:block">FRAME · NOT IN ARCHIVE</span>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-x-6 gap-y-12 items-start">
          <div class="lg:col-span-7">
            <h1 class="text-display font-display font-medium text-ink max-w-[16ch] rise">
              No finding at these coordinates.
            </h1>
            <p class="mono-label-long text-signal-soft mt-8 rise">
              THE FRAME YOU REQUESTED IS OUTSIDE THE SURVEYED AREA
            </p>
            <p class="text-body text-ink-2 mt-4 max-w-prose rise">
              The address may have moved, or it was never flown. Everything we did
              survey is one hop back.
            </p>
            <div class="flex flex-wrap items-center gap-4 mt-10 rise">
              <Button href="/" event="cta-home:404">Back to base</Button>
              <Button href="/#verticals" kind="secondary" event="cta-verticals:404">Browse the verticals</Button>
            </div>
          </div>

          <div class="lg:col-span-4 lg:col-start-9 hidden lg:block rise" aria-hidden="true">
            <svg viewBox="0 0 280 200" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full text-ink-3">
              <path d="M8 24V8h16" stroke="currentColor" stroke-width="1.5" />
              <path d="M256 8h16v16" stroke="currentColor" stroke-width="1.5" />
              <path d="M272 176v16h-16" stroke="currentColor" stroke-width="1.5" />
              <path d="M24 192H8v-16" stroke="currentColor" stroke-width="1.5" />
              <rect x="40" y="40" width="200" height="120" stroke="currentColor" stroke-width="1" stroke-dasharray="4 6" opacity="0.4" />
              <path d="M140 84v16M132 92h16" stroke="currentColor" stroke-width="1" opacity="0.6" />
              <text x="140" y="126" text-anchor="middle" class="font-mono" font-size="10" letter-spacing="0.2em" fill="currentColor">NO DATA</text>
            </svg>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Base>
