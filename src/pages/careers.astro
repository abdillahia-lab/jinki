---
/*
  Careers — the hiring brief. Honest about scale: small, early, founder-led.
  Roles as folio-rule rows, doctrine on how we work, direct line to apply.
*/
import Base from '../layouts/Base.astro';
import Nav from '../components/ui/Nav.astro';
import Footer from '../components/ui/Footer.astro';
import Section from '../components/ui/Section.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import Breadcrumb from '../components/ui/Breadcrumb.astro';
import CTABlock from '../components/ui/CTABlock.astro';

const apply = (role: string) =>
  `mailto:info@jinki.ai?subject=${encodeURIComponent(`Application: ${role}`)}`;

const roles = [
  { title: 'Computer Vision Engineer', meta: 'ENGINEERING · FULL-TIME · HYBRID / NOVA', d: 'Build and tune the detection and classification models that turn radiometric thermal captures into severity-ranked findings.' },
  { title: 'Platform Engineer', meta: 'ENGINEERING · FULL-TIME · HYBRID / NOVA', d: 'Own the pipelines and infrastructure that move terabytes of capture data from the field to the findings report.' },
  { title: 'Frontend Engineer', meta: 'ENGINEERING · FULL-TIME · REMOTE', d: 'Build the client-facing interfaces that make complex aerial intelligence legible enough to schedule work orders against.' },
  { title: 'Aerial Operations Specialist', meta: 'OPERATIONS · FULL-TIME · ON-SITE / NOVA', d: 'Plan, execute, and QA autonomous and piloted aerial missions over data centers, energy facilities, and secure perimeters.' },
  { title: 'Sensor Calibration Technician', meta: 'OPERATIONS · FULL-TIME · ON-SITE / NOVA', d: 'Keep thermal, visual, and 3D mapping sensors calibrated to spec so every capture holds up in a findings report.' },
  { title: 'Enterprise Account Executive', meta: 'BUSINESS · FULL-TIME · HYBRID / NOVA', d: 'Open doors at data center operators and utilities, then carry engagements from first call to signed assessment.' },
  { title: 'Marketing Lead', meta: 'BUSINESS · FULL-TIME · HYBRID / NOVA', d: 'Own the narrative for an intelligence firm that sells findings, not flight hours, to critical-infrastructure operators.' },
  { title: 'AI Research Scientist', meta: 'RESEARCH · FULL-TIME · HYBRID / NOVA', d: 'Push multi-modal sensor fusion, predictive anomaly models, and autonomous mission planning from paper to production.' },
  { title: 'Geospatial Analyst', meta: 'RESEARCH · CONTRACT · REMOTE', d: 'Turn raw geospatial captures into orthomosaics, thermal maps, and change-detection reports clients act on.' },
];

const doctrine = [
  { t: 'Field and lab, same week', d: 'What you build flies. Models, pipelines, and interfaces ship to live missions over real facilities — you watch your work change a client\'s maintenance plan, not a metrics dashboard.' },
  { t: 'Security-first, by background', d: 'Leadership comes from enterprise security and cyber risk — CISSP, CCSP, AI governance and security (AIGP, AAISM), with roots as a senior consultant at Deloitte. Mutual NDAs, AES-256, and chain-of-custody are operating habits here, not policy documents.' },
  { t: 'Founder-direct', d: 'No recruiters, no tracking system, no ghosting. Applications land in the founder\'s inbox, interviews skip the trick questions, and you get an answer within a week of the final conversation.' },
  { t: 'Small by design', d: 'An early team carries real ownership: hard problems, direct lines, and work where every contribution moves the deliverable. We hire as engagements land — pipeline, not headcount targets.' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Careers at Jinki',
  description: 'Open roles at Jinki Aerial Intelligence — engineering, operations, business, and research positions building the intelligence layer for critical infrastructure.',
  publisher: { '@type': 'Organization', name: 'Jinki Aerial Intelligence', url: 'https://jinki.ai' },
};
---

<Base
  title="Careers — Jinki Aerial Intelligence"
  description="Join a small, founder-led team building the intelligence layer for physical infrastructure. Open roles in engineering, operations, business, and research."
  jsonLd={jsonLd}
>
  <Nav />
  <Breadcrumb items={[{ label: 'Careers' }]} />
  <main id="main-content">

    <!-- HERO -->
    <section aria-label="Careers at Jinki" class="pt-10 md:pt-16">
      <div class="max-w-brief mx-auto px-5 sm:px-8 lg:px-12 2xl:px-16">
        <div class="folio-rule rule-draw flex items-baseline justify-between gap-4 pt-3 mb-12">
          <span class="mono-label text-ink-3"><span class="text-signal">CR</span>&nbsp;/&nbsp;CAREERS</span>
          <span class="mono-label text-ink-3">NORTHERN VIRGINIA · EARLY TEAM</span>
        </div>
        <h1 class="text-display font-display font-medium text-ink max-w-[20ch] rise">
          Build the <em class="not-italic text-signal">intelligence layer</em> for physical infrastructure.
        </h1>
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-x-6 mt-10">
          <p class="text-lede text-ink-2 lg:col-span-7 rise">
            Jinki is small and early: one founder, a deliberately limited client cohort, and a
            hiring plan that follows engagements rather than headcount targets. The roles below
            are the team we're assembling as founding clients come aboard — first hires shape
            how this company works, not just what it ships.
          </p>
          <div class="lg:col-span-4 lg:col-start-9 mono-label text-ink-3 flex flex-col gap-3 mt-6 lg:mt-0 rise">
            <span>STAGE · FOUNDER-LED, PRE-SCALE</span>
            <span>HIRING · FOLLOWS ENGAGEMENTS</span>
            <span>APPLY · INFO@JINKI.AI</span>
          </div>
        </div>
      </div>
    </section>

    <!-- OPEN ROLES -->
    <Section label="Open roles" cv>
      <SectionHeader
        index="01" label="OPEN ROLES" datum="09 ROLES · ROLLING"
        title="The team we're building."
        lede="Every application goes to the founder's inbox — a short note on what you'd build beats a polished resume."
      />
      <div>
        {roles.map((role) => (
          <div class="folio-rule rule-draw grid grid-cols-1 lg:grid-cols-12 gap-x-6 gap-y-2 pt-5 pb-6">
            <div class="lg:col-span-4">
              <h3 class="text-h3 font-display font-medium text-ink">{role.title}</h3>
              <span class="mono-label text-ink-3 mt-1.5 block">{role.meta}</span>
            </div>
            <p class="text-body text-ink-2 lg:col-span-6">{role.d}</p>
            <div class="lg:col-span-2 lg:text-right">
              <a href={apply(role.title)} class="mono-label text-ink link-draw no-underline">APPLY →</a>
            </div>
          </div>
        ))}
        <div class="folio-rule rule-draw pt-5 pb-2">
          <p class="text-body text-ink-2">
            Discipline not listed?
            <a href={apply('Open application')} class="text-ink link-draw no-underline">Open application — tell us what you'd build →</a>
          </p>
        </div>
      </div>
    </Section>

    <!-- HOW WE WORK -->
    <Section label="How we work" cv>
      <SectionHeader
        index="02" label="HOW WE WORK" datum="04 COMMITMENTS"
        title="What you're signing up for."
      />
      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-6">
        {doctrine.map((item, i) => (
          <div class="folio-rule rule-draw pt-5 pb-6">
            <span class="mono-label text-signal tabular">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="text-h3 font-display font-medium text-ink mt-2 mb-2">{item.t}</h3>
            <p class="text-body text-ink-2">{item.d}</p>
          </div>
        ))}
      </div>
    </Section>

    <Section label="Apply" spacing="compact">
      <CTABlock
        title="Build the instrument with us."
        body="Send a note about what you'd build. It reaches the founder directly, and you'll hear back within a week."
        primary={{ label: 'Email the founder', href: 'mailto:info@jinki.ai', event: 'cta-apply:careers' }}
        secondary={{ label: 'Meet the founder', href: '/about', kind: 'secondary', event: 'cta-about:careers' }}
      />
    </Section>

  </main>
  <Footer />
</Base>
