---
/*
  /status — a real operations status page, pre-revenue. Everything on it
  is true: booking window, live field conditions (client-computed),
  scan-window state, build version, response commitment, security posture.
  The founding-client pitch rendered as operations.
*/
import Base from '../layouts/Base.astro';
import Nav from '../components/ui/Nav.astro';
import Footer from '../components/ui/Footer.astro';
import Section from '../components/ui/Section.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import Breadcrumb from '../components/ui/Breadcrumb.astro';
import TelemetryStrip from '../components/ui/TelemetryStrip.astro';
import CorridorChart from '../components/ui/CorridorChart.astro';
import CTABlock from '../components/ui/CTABlock.astro';

const build = new Date().toISOString().slice(0, 10);

const rows = [
  { label: 'BOOKING WINDOW', value: 'Q3 2026 ASSESSMENTS — OPEN', state: 'ok' },
  { label: 'FOUNDING COHORT', value: 'ACCEPTING — LIMITED SLOTS', state: 'ok' },
  { label: 'RESPONSE COMMITMENT', value: '< 1 BUSINESS DAY, FOUNDER-DIRECT', state: 'ok' },
  { label: 'OPERATING AUTHORITY', value: 'FAA PART 107 · DC SFRA AUTHORIZATION', state: 'ok' },
  { label: 'LIABILITY COVERAGE', value: '$5M PER OPERATION', state: 'ok' },
  { label: 'DATA POSTURE', value: 'AES-256 · TLS 1.3 · NDA BY DEFAULT · ON-PREM PROCESSING AVAILABLE', state: 'ok' },
  { label: 'PLATFORM BUILD', value: build, state: 'ok' },
];
---

<Base
  title="Operations Status — Jinki"
  description="Live operations status for Jinki Aerial Intelligence: booking window, field conditions, scan-window state, operating authority, and security posture."
>
  <Nav />
  <Breadcrumb items={[{ label: 'Status' }]} />
  <main id="main-content">

    <Section spacing="compact">
      <SectionHeader
        index="OPS" label="OPERATIONS STATUS" datum="ALL VALUES LIVE OR TRUE-AS-OF-BUILD" level={1}
        title="Systems, plainly stated."
        lede="What we're flying, when we're booking, and how we handle your data — rendered the way we'd want a vendor to show us."
      />

      <div class="folio-rule pt-4 pb-6 mb-2">
        <TelemetryStrip variant="strip" />
      </div>

      <ul class="list-none m-0 p-0">
        {rows.map((r) => (
          <li class="folio-rule flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 py-4">
            <span class="mono-label text-ink-3">{r.label}</span>
            <span class="font-mono text-caption text-ink flex items-center gap-2">
              <span class="inline-block w-2 h-2 rounded-pill bg-signal" aria-hidden="true"></span>
              {r.value}
            </span>
          </li>
        ))}
        <li class="folio-rule" aria-hidden="true"></li>
      </ul>
    </Section>

    <Section label="Operating area" cv>
      <SectionHeader
        index="01" label="OPERATING AREA" datum="MID-ATLANTIC"
        title="The corridor we fly."
        lede="Northern Virginia through the Mid-Atlantic — including the DC Special Flight Rules Area, where most operators can't go. Authorization held, paperwork filed by us."
      />
      <CorridorChart />
    </Section>

    <Section label="Engage" spacing="compact">
      <CTABlock
        title="The window is open."
        body="Q3 2026 founding cohort — locked rate, priority scheduling, direct founder involvement."
        primary={{ label: 'Request Q3 assessment', href: '/#lead-gen', event: 'cta-assessment:status' }}
        secondary={{ label: 'See the sample report', href: '/sample-report', kind: 'secondary', event: 'cta-sample:status' }}
      />
    </Section>

  </main>
  <Footer />
</Base>
