---
/*
  About — the typography manifesto. Founder-led, no fake team carousel.
  Display-size statement, mono margin notes, the founder, the doctrine.
*/
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Nav from '../components/ui/Nav.astro';
import Footer from '../components/ui/Footer.astro';
import Section from '../components/ui/Section.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import Breadcrumb from '../components/ui/Breadcrumb.astro';
import CTABlock from '../components/ui/CTABlock.astro';
import CertSeal from '../components/ui/CertSeal.astro';
import founderImg from '../assets/images/founder-adnan.webp';

const doctrine = [
  { t: 'Intelligence, not footage', d: 'Most aerial providers sell flight hours and hand you a hard drive. Every Jinki engagement ends in a severity-ranked findings report your team can schedule against — the analysis is the product.' },
  { t: 'Security embedded, not bolted on', d: 'The founder spent his career in enterprise security and cyber risk — including as a senior consultant at Deloitte. Mutual NDA before we see your site, AES-256 everywhere, on-premises processing available, chain-of-custody on every dataset.' },
  { t: 'Physics over promises', d: 'Thermal inspection is bound by solar geometry — we fly when thermal contrast is real, not when the calendar says so. Claims on this site carry numbers or they don\'t ship.' },
  { t: 'Small by design, for now', d: 'One founder, enterprise-grade credentials, a deliberately small Q3 cohort. Every founding engagement is planned, reviewed, and presented by the person whose name is on the company.' },
];

// Founder certifications, spelled out, with issuing body. Single source
// for the on-page credentials block and the JSON-LD below.
const credentials = [
  { abbr: 'CISSP', name: 'Certified Information Systems Security Professional', body: 'ISC2' },
  { abbr: 'CCSP', name: 'Certified Cloud Security Professional', body: 'ISC2' },
  { abbr: 'AIGP', name: 'Artificial Intelligence Governance Professional', body: 'IAPP' },
  { abbr: 'AAISM', name: 'Advanced in AI Security Management', body: 'ISACA' },
  { abbr: 'AAIR', name: 'Advanced in AI Risk', body: 'ISACA' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  mainEntity: {
    '@type': 'Organization',
    name: 'Jinki Aerial Intelligence',
    url: 'https://jinki.ai',
    founder: {
      '@type': 'Person',
      name: 'Adnan Abdillahi',
      jobTitle: 'Founder & CEO',
      image: 'https://jinki.ai/images/founder-adnan.jpg',
      hasCredential: credentials.map((c) => ({
        '@type': 'EducationalOccupationalCredential',
        credentialCategory: 'certification',
        name: c.name,
        alternateName: c.abbr,
        recognizedBy: { '@type': 'Organization', name: c.body },
      })),
      alumniOf: { '@type': 'Organization', name: 'Deloitte' },
    },
  },
};
---

<Base
  title="About — Jinki Aerial Intelligence"
  description="Founder-led aerial intelligence for critical infrastructure. Enterprise security discipline applied to radiometric thermal inspection — intelligence, not footage."
  ogImage="/images/og/og-about.png"
  jsonLd={jsonLd}
>
  <Nav />
  <Breadcrumb items={[{ label: 'About' }]} />
  <main id="main-content">

    <!-- MANIFESTO -->
    <section aria-label="About Jinki" class="pt-10 md:pt-16">
      <div class="max-w-brief mx-auto px-5 sm:px-8 lg:px-12 2xl:px-16">
        <div class="folio-rule rule-draw flex items-baseline justify-between gap-4 pt-3 mb-12">
          <span class="mono-label text-ink-3"><span class="text-signal">AB</span>&nbsp;/&nbsp;ABOUT</span>
          <span class="mono-label text-ink-3">MID-ATLANTIC · FOUNDER-LED</span>
        </div>
        <h1 class="text-display font-display font-medium text-ink max-w-[18ch] rise">
          Infrastructure fails quietly. <em class="not-italic text-signal">We listen from above.</em>
        </h1>
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-x-6 mt-10">
          <p class="text-lede text-ink-2 lg:col-span-7 rise">
            Jinki exists because critical-infrastructure operators were drowning in raw aerial
            footage with no reliable way to turn it into decisions. Most providers sell flight
            hours. We sell the moment your maintenance plan changes — a severity-ranked finding,
            geolocated, classified, and ready for Monday's work orders.
          </p>
          <div class="lg:col-span-4 lg:col-start-9 mono-label text-ink-3 flex flex-col gap-3 mt-6 lg:mt-0 rise">
            <span>POSTURE · OPERATOR, NOT VENDOR</span>
            <span>PROOF · THE DELIVERABLE ITSELF</span>
            <span>SCALE · DELIBERATELY SMALL, Q3 COHORT</span>
          </div>
        </div>
      </div>
    </section>

    <!-- FOUNDER -->
    <Section label="Founder" cv>
      <SectionHeader
        index="01" label="FOUNDER" datum="ISC2 · IAPP · ISACA"
        title="The person your request reaches."
      />
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-x-6 gap-y-10 items-start">
        <div class="lg:col-span-4">
          <div class="border border-rule rounded-panel overflow-hidden max-w-sm">
            <Picture
              src={founderImg}
              alt="Adnan Abdillahi, founder and CEO of Jinki Aerial Intelligence"
              formats={['avif', 'webp']}
              widths={[320, 480, 640]}
              sizes="(max-width: 1024px) 90vw, 380px"
              class="w-full"
            />
            <div class="flex items-baseline justify-between gap-2 border-t border-rule px-4 py-2.5">
              <span class="mono-label text-ink-3">ADNAN ABDILLAHI</span>
              <span class="mono-label text-signal">FOUNDER / CEO</span>
            </div>
          </div>
        </div>
        <div class="lg:col-span-7 lg:col-start-6">
          <p class="text-lede text-ink-2">
            Adnan built Jinki at the intersection of enterprise cybersecurity and aerial
            intelligence — discipline he practiced as a cyber risk senior consultant at
            Deloitte. He holds the certifications critical-infrastructure security runs on,
            alongside the AI governance, security, and risk credentials for putting AI
            responsibly to work on sensitive data. That same rigor now goes to finding the
            physical failures those facilities haven't reported yet.
          </p>
          <p class="text-body text-ink-2 mt-5">
            There are no SDRs and no handoffs here. Assessment requests go to his inbox,
            engagement plans carry his review, and findings briefings happen with the
            person who planned the mission. That stops scaling eventually — founding
            clients get it while it lasts.
          </p>
          <!-- Credentials, spelled out — the proof behind the acronyms -->
          <dl class="m-0 mt-8 border-t border-rule pt-6 flex flex-col gap-y-3">
            {credentials.map((c) => (
              <div class="grid grid-cols-[4.5rem_1fr] gap-x-4 items-baseline">
                <dt class="mono-label text-signal tabular">{c.abbr}</dt>
                <dd class="m-0 text-body text-ink leading-snug">
                  {c.name} <span class="text-ink-3 whitespace-nowrap">· {c.body}</span>
                </dd>
              </div>
            ))}
          </dl>
          <p class="mono-label text-ink-3 mt-8 max-w-none">
            DIRECT LINE · <a href="mailto:info@jinki.ai" class="text-ink-2 no-underline hover:text-ink">INFO@JINKI.AI</a>
          </p>
        </div>
      </div>

      <!-- Credential seals — uniform vector marks, one size, any resolution -->
      <div class="mt-12 md:mt-16 folio-rule pt-7">
        <p class="mono-label text-ink-3 mb-6">CREDENTIALS · VERIFIED WITH ISSUER</p>
        <ul class="list-none m-0 p-0 flex flex-wrap items-center gap-x-7 gap-y-6">
          {credentials.map((c) => (
            <li><CertSeal abbr={c.abbr} body={c.body} /></li>
          ))}
        </ul>
      </div>
    </Section>

    <!-- DOCTRINE -->
    <Section label="Operating doctrine" cv>
      <SectionHeader
        index="02" label="DOCTRINE" datum="04 COMMITMENTS"
        title="How we operate."
      />
      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-6">
        {doctrine.map((item, i) => (
          <div class="folio-rule rule-draw pt-5 pb-6">
            <span class="mono-label text-signal tabular">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="text-h3 font-display font-medium text-ink mt-2 mb-2">{item.t}</h3>
            <p class="text-body text-ink-2">{item.d}</p>
          </div>
        ))}
      </div>
    </Section>

    <!-- WHERE THIS GOES -->
    <Section label="Direction" spacing="compact" cv>
      <div class="folio-rule rule-draw pt-4 pb-2">
        <p class="text-body text-ink-2 max-w-prose">
          The perception stack we run aloft — detection, classification, severity ranking —
          is the foundation for broader embodied systems.
          <a href="/embodied-ai" class="text-ink link-draw no-underline">Where we're going →</a>
        </p>
      </div>
    </Section>

    <Section label="Engage" spacing="compact">
      <CTABlock
        title="Talk to the founder."
        body="Two fields, a one-business-day response target, and a mutual NDA before we see your site."
        primary={{ label: 'Request Q3 assessment', href: '/#lead-gen', event: 'cta-assessment:about' }}
        secondary={{ label: 'See the sample report', href: '/sample-report', kind: 'secondary', event: 'cta-sample:about' }}
      />
    </Section>

  </main>
  <Footer />
</Base>
