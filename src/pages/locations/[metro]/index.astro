---
/*
  Metro hub — the airspace story for one metro plus its sector pages.
  Hub pages carry the geographic JSON-LD and internally link every
  metro × vertical page beneath them.
*/
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Nav from '../../../components/ui/Nav.astro';
import Footer from '../../../components/ui/Footer.astro';
import Section from '../../../components/ui/Section.astro';
import SectionHeader from '../../../components/ui/SectionHeader.astro';
import Button from '../../../components/ui/Button.astro';
import Breadcrumb from '../../../components/ui/Breadcrumb.astro';
import LeadForm from '../../../components/ui/LeadForm.astro';

export async function getStaticPaths() {
  const locations = await getCollection('locations');
  return locations.map((loc) => ({ params: { metro: loc.id }, props: { loc } }));
}

const { loc } = Astro.props;
const m = loc.data;

const verticals = await getCollection('verticals');
const titleById = Object.fromEntries(verticals.map((v) => [v.id, v.data.title]));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: m.metaTitle,
  provider: { '@type': 'Organization', name: 'Jinki Aerial Intelligence', url: 'https://jinki.ai' },
  description: m.metaDescription,
  areaServed: m.areaServed.map((a) => ({ '@type': 'Place', name: a })),
  serviceType: 'Aerial Thermal Facility Inspection',
};
---

<Base title={m.metaTitle} description={m.metaDescription} jsonLd={jsonLd}>
  <Nav />
  <Breadcrumb items={[{ label: 'Locations', href: '/locations' }, { label: m.title }]} />
  <main id="main-content">

    <!-- HERO -->
    <section aria-label={m.title} class="pt-8 md:pt-12">
      <div class="max-w-brief mx-auto px-5 sm:px-8 lg:px-12 2xl:px-16">
        <div class="folio-rule rule-draw flex items-baseline justify-between gap-4 pt-3 mb-10">
          <span class="mono-label text-ink-3"><span class="text-signal">{m.short}</span>&nbsp;/&nbsp;{m.hero.kicker}</span>
          <span class="mono-label text-ink-3">{m.hero.datum}</span>
        </div>
        <h1 class="text-h1 font-display font-medium text-ink max-w-[20ch] rise" set:html={m.hero.headline} />
        <p class="text-lede text-ink-2 max-w-[58ch] mt-6 rise">{m.hero.sub}</p>
        <div class="flex flex-wrap items-center gap-3 mt-7 rise">
          <Button href="#lead-gen" event={`cta-assessment:loc-${loc.id}`}>Request Q3 assessment</Button>
          <Button href="/sample-report" kind="secondary" event={`cta-sample:loc-${loc.id}`}>See the sample report</Button>
        </div>
      </div>
    </section>

    <!-- AIRSPACE -->
    <Section label="Airspace" cv class="mt-8">
      <SectionHeader
        index="01" label="AIRSPACE" datum={m.airspace.label}
        title="The airspace, plainly stated."
        lede={m.airspace.body}
      />
      <div class="grid grid-cols-2 md:grid-cols-4 gap-x-6">
        {m.airspace.facts.map((f) => (
          <div class="folio-rule rule-draw pt-4 pb-5">
            <span class="mono-label text-ink-3 block mb-1.5">{f.key}</span>
            <span class="mono-label text-signal-soft">{f.value}</span>
          </div>
        ))}
      </div>
    </Section>

    <!-- COVERAGE -->
    <Section label="Coverage" cv>
      <SectionHeader
        index="02" label="COVERAGE" datum={`${String(m.coverage.areas.length).padStart(2, '0')} NAMED AREAS`}
        title="Where the missions go."
        lede={m.coverage.body}
      />
      <ul class="list-none m-0 p-0 flex flex-wrap gap-2">
        {m.coverage.areas.map((a) => (
          <li class="inline-flex items-center h-10 px-4 rounded-pill border border-rule-strong font-mono text-caption text-ink-2">{a}</li>
        ))}
      </ul>
    </Section>

    <!-- SECTORS IN THIS METRO -->
    <Section label="Sectors" cv>
      <SectionHeader
        index="03" label="SECTORS" datum={`${String(m.verticals.length).padStart(2, '0')} SERVED HERE`}
        title={`What we fly in ${m.title}.`}
      />
      <ul class="list-none m-0 p-0">
        {m.verticals.map((block, i) => (
          <li class="folio-rule rule-draw">
            <a href={`/locations/${loc.id}/${block.slug}`} class="group grid grid-cols-[auto_1fr_auto] items-baseline gap-x-4 md:gap-x-6 py-5 no-underline">
              <span class="mono-label text-ink-3 tabular">{String(i + 1).padStart(2, '0')}</span>
              <span>
                <span class="font-display font-medium text-h3 text-ink group-hover:text-signal transition-colors block">{titleById[block.slug]}</span>
                <span class="text-body text-ink-2 block mt-1 max-w-[64ch]">{block.headline}</span>
              </span>
              <span class="mono-label text-signal-soft">READ&nbsp;→</span>
            </a>
          </li>
        ))}
        <li class="folio-rule" aria-hidden="true"></li>
      </ul>
    </Section>

    <LeadForm context={`/locations/${loc.id}`} />

  </main>
  <Footer />
</Base>
