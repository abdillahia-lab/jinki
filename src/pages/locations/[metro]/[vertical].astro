---
/*
  Metro × vertical page — the local-intent SEO engine.
  One template; uniqueness comes from the locations YAML: real airspace
  content, local failure points, and metro FAQs. Capability depth lives
  on the parent vertical page — these pages answer "do you serve X here,
  and can you even fly here?" then route to it.
*/
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Nav from '../../../components/ui/Nav.astro';
import Footer from '../../../components/ui/Footer.astro';
import Section from '../../../components/ui/Section.astro';
import SectionHeader from '../../../components/ui/SectionHeader.astro';
import Button from '../../../components/ui/Button.astro';
import Breadcrumb from '../../../components/ui/Breadcrumb.astro';
import Accordion from '../../../components/ui/Accordion.astro';
import CTABlock from '../../../components/ui/CTABlock.astro';
import LeadForm from '../../../components/ui/LeadForm.astro';

export async function getStaticPaths() {
  const [locations, verticals] = await Promise.all([
    getCollection('locations'),
    getCollection('verticals'),
  ]);
  const byId = Object.fromEntries(verticals.map((v) => [v.id, v]));
  return locations.flatMap((loc) =>
    loc.data.verticals.map((block) => ({
      params: { metro: loc.id, vertical: block.slug },
      props: { loc, block, vertical: byId[block.slug] },
    }))
  );
}

const { loc, block, vertical } = Astro.props;
const m = loc.data;
const v = vertical.data;

const metaTitle = `${v.title} Aerial Thermal Inspection in ${m.title} — Jinki`;
const metaDescription = `${v.title} aerial thermal inspection across ${m.title} — ${m.airspace.label.toLowerCase()}, full airspace coordination, severity-ranked findings in 48 hours.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: metaTitle,
  provider: { '@type': 'Organization', name: 'Jinki Aerial Intelligence', url: 'https://jinki.ai' },
  description: block.intro,
  areaServed: m.areaServed.map((a) => ({ '@type': 'Place', name: a })),
  serviceType: `${v.serviceType} — ${m.title}`,
};
---

<Base title={metaTitle} description={metaDescription} ogImage={v.ogImage} jsonLd={jsonLd}>
  <Nav />
  <Breadcrumb items={[{ label: 'Locations', href: '/locations' }, { label: m.title, href: `/locations/${loc.id}` }, { label: v.title }]} />
  <main id="main-content">

    <!-- HERO -->
    <section aria-label={`${v.title} in ${m.title}`} class="pt-8 md:pt-12">
      <div class="max-w-brief mx-auto px-5 sm:px-8 lg:px-12 2xl:px-16">
        <div class="folio-rule rule-draw flex items-baseline justify-between gap-4 pt-3 mb-10">
          <span class="mono-label text-ink-3"><span class="text-signal">{m.short}</span>&nbsp;×&nbsp;{v.title.toUpperCase()}</span>
          <span class="mono-label text-ink-3">{m.airspace.label}</span>
        </div>
        <h1 class="text-h1 font-display font-medium text-ink max-w-[20ch] rise" set:html={block.headline} />
        <p class="text-lede text-ink-2 max-w-[58ch] mt-6 rise">{block.intro}</p>
        <div class="flex flex-wrap items-center gap-3 mt-7 rise">
          <Button href="#lead-gen" event={`cta-assessment:loc-${loc.id}-${block.slug}`}>Request Q3 assessment</Button>
          <Button href={`/verticals/${block.slug}`} kind="secondary" event={`cta-vertical:loc-${loc.id}-${block.slug}`}>Full {v.title.toLowerCase()} brief</Button>
        </div>
      </div>
    </section>

    <!-- AIRSPACE — the local moat -->
    <Section label="Airspace" cv>
      <SectionHeader
        index="01" label="AIRSPACE" datum={m.airspace.label}
        title="Can you even fly here? Yes."
        lede={m.airspace.body}
      />
      <div class="grid grid-cols-2 md:grid-cols-4 gap-x-6">
        {m.airspace.facts.map((f) => (
          <div class="folio-rule rule-draw pt-4 pb-5">
            <span class="mono-label text-ink-3 block mb-1.5">{f.key}</span>
            <span class="mono-label text-signal-soft">{f.value}</span>
          </div>
        ))}
      </div>
    </Section>

    <!-- LOCAL POINTS -->
    <Section label="Why here" cv>
      <SectionHeader
        index="02" label={`${v.title.toUpperCase()} · ${m.short}`} datum={`${String(block.points.length).padStart(2, '0')} LOCAL FACTORS`}
        title={`What ${m.title} changes.`}
      />
      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-6">
        {block.points.map((p) => (
          <div class="folio-rule rule-draw pt-5 pb-6">
            <span class="mono-label text-signal block mb-2">{p.tag}</span>
            <p class="text-body text-ink-2">{p.body}</p>
          </div>
        ))}
      </div>
    </Section>

    <!-- ROUTE TO THE FULL BRIEF -->
    <Section label="Engage" spacing="compact">
      <CTABlock
        title={`The full ${v.title.toLowerCase()} capability brief.`}
        body={`Failure modes, capabilities, and the sample deliverable — everything on this page is the ${m.title} layer on top of it.`}
        primary={{ label: `Read the ${v.title} brief`, href: `/verticals/${block.slug}`, event: `cta-vertical:mid-${loc.id}-${block.slug}` }}
        secondary={{ label: 'See the sample report', href: '/sample-report', kind: 'secondary', event: `cta-sample:loc-${loc.id}-${block.slug}` }}
      />
    </Section>

    <!-- LOCAL FAQ -->
    <Section label="Questions" cv>
      <SectionHeader
        index="03" label="QUESTIONS" datum={`${m.short} SPECIFIC`}
        title="Asked about this metro."
      />
      <Accordion items={block.faqs} jsonLd />
    </Section>

    <LeadForm context={`/locations/${loc.id}/${block.slug}`} />

  </main>
  <Footer />
</Base>
