---
/*
  Locations index — the operating area, metro by metro.
  Four metros, each with its own airspace story; the index sells the
  pattern (we fly where coordination is hard) and routes down.
*/
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Nav from '../../components/ui/Nav.astro';
import Footer from '../../components/ui/Footer.astro';
import Section from '../../components/ui/Section.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import Button from '../../components/ui/Button.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import LeadForm from '../../components/ui/LeadForm.astro';

const locations = (await getCollection('locations')).sort((a, b) => a.data.order - b.data.order);
const verticals = await getCollection('verticals');
const titleById = Object.fromEntries(verticals.map((v) => [v.id, v.data.title]));

const metaTitle = 'Operating Area — Jinki Aerial Intelligence';
const metaDescription = 'Aerial thermal inspection across the Mid-Atlantic: Northern Virginia and the DC SFRA, Baltimore, Richmond, and Hampton Roads — each flown with full airspace coordination.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: metaTitle,
  provider: { '@type': 'Organization', name: 'Jinki Aerial Intelligence', url: 'https://jinki.ai' },
  description: metaDescription,
  areaServed: locations.flatMap((l) => l.data.areaServed).map((a) => ({ '@type': 'Place', name: a })),
  serviceType: 'Aerial Thermal Facility Inspection',
};
---

<Base title={metaTitle} description={metaDescription} jsonLd={jsonLd}>
  <Nav />
  <Breadcrumb items={[{ label: 'Locations' }]} />
  <main id="main-content">

    <!-- HERO -->
    <section aria-label="Operating area" class="pt-8 md:pt-12">
      <div class="max-w-brief mx-auto px-5 sm:px-8 lg:px-12 2xl:px-16">
        <div class="folio-rule rule-draw flex items-baseline justify-between gap-4 pt-3 mb-10">
          <span class="mono-label text-ink-3"><span class="text-signal">OPS</span>&nbsp;/&nbsp;OPERATING AREA // MID-ATLANTIC</span>
          <span class="mono-label text-ink-3">04 METROS</span>
        </div>
        <h1 class="text-h1 font-display font-medium text-ink max-w-[20ch] rise">
          We operate where the airspace is <em class="not-italic text-signal">hard</em>.
        </h1>
        <p class="text-lede text-ink-2 max-w-[58ch] mt-6 rise">
          The DC Special Flight Rules Area. BWI's Class B shelf. The military airspace
          stack over Hampton Roads. The coordination most operators decline is the
          coverage gap we built the company on.
        </p>
        <div class="flex flex-wrap items-center gap-3 mt-7 rise">
          <Button href="#lead-gen" event="cta-assessment:locations">Request Q3 assessment</Button>
          <Button href="/sample-report" kind="secondary" event="cta-sample:locations">See the sample report</Button>
        </div>
      </div>
    </section>

    <!-- METROS -->
    <Section label="Metros" cv class="mt-8">
      <SectionHeader
        index="01" label="METROS" datum="04 AIRSPACE PROFILES"
        title="Metro by metro."
      />
      <ul class="list-none m-0 p-0">
        {locations.map((loc) => (
          <li class="folio-rule rule-draw">
            <a href={`/locations/${loc.id}`} class="group grid grid-cols-[auto_1fr] md:grid-cols-12 items-baseline gap-x-4 md:gap-x-6 gap-y-1.5 py-6 no-underline">
              <span class="mono-label text-signal tabular md:col-span-1">{loc.data.short}</span>
              <span class="md:col-span-5">
                <span class="font-display font-medium text-h3 text-ink group-hover:text-signal transition-colors">{loc.data.title}</span>
              </span>
              <span class="text-body text-ink-2 col-start-2 md:col-start-7 md:col-span-4">
                {loc.data.verticals.map((b) => titleById[b.slug]).join(' · ')}
              </span>
              <span class="mono-label text-ink-3 col-start-2 md:col-start-11 md:col-span-2 md:text-right">{loc.data.airspace.label}</span>
            </a>
          </li>
        ))}
        <li class="folio-rule" aria-hidden="true"></li>
      </ul>
    </Section>

    <LeadForm context="/locations" />

  </main>
  <Footer />
</Base>
