---
/*
  Data Security — the control ledger. What is true today, stated as rows:
  encryption, NDA, on-prem, custody, access, retention. SOC 2 demoted to
  one roadmap line. No shields, no glow — the controls are the design.
*/
import Base from '../layouts/Base.astro';
import Nav from '../components/ui/Nav.astro';
import Footer from '../components/ui/Footer.astro';
import Section from '../components/ui/Section.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import Breadcrumb from '../components/ui/Breadcrumb.astro';
import Button from '../components/ui/Button.astro';
import CTABlock from '../components/ui/CTABlock.astro';

const posture = [
  {
    tag: 'ENCRYPTION',
    spec: 'AES-256 · TLS 1.3',
    title: 'Encrypted at rest and in transit',
    d: 'Every dataset is encrypted with AES-256 at rest and TLS 1.3 in transit. Keys rotate on a managed schedule, and decryption requires explicit authorization at every layer.',
  },
  {
    tag: 'NDA',
    spec: 'BEFORE FIRST FLIGHT',
    title: 'Mutual NDA by default',
    d: 'A mutual NDA is executed before we see your site, your schematics, or a single frame of imagery. Not on request — the default for every engagement.',
  },
  {
    tag: 'PROCESSING',
    spec: 'ON-PREM AVAILABLE',
    title: 'Your data can stay on your site',
    d: 'For facilities with data-residency requirements, analysis runs on-premises. Imagery can stay inside your network, and we leave nothing behind when the engagement ends.',
  },
  {
    tag: 'CUSTODY',
    spec: 'LOGGED END-TO-END',
    title: 'Chain of custody on every dataset',
    d: 'From capture to delivery, each dataset carries a documented chain of custody — who handled it, when, and why. The log is available for your review at any point.',
  },
  {
    tag: 'ACCESS',
    spec: 'LEAST PRIVILEGE',
    title: 'Access is scoped, logged, revocable',
    d: 'Role-based access enforced on least privilege. Multi-factor authentication is mandatory with no exceptions, and every action is timestamped and auditable.',
  },
  {
    tag: 'RETENTION',
    spec: 'CLIENT-DEFINED',
    title: 'You set the retention clock',
    d: 'Retention follows your policy, not ours. When your window closes, data is verifiably destroyed and the destruction is documented back to you.',
  },
];

const authority = [
  {
    tag: 'CERTIFICATION',
    title: 'FAA Part 107',
    d: 'Every flight is conducted under FAA Part 107 by a certificated remote pilot. Operations follow written procedures, not improvisation.',
  },
  {
    tag: 'AIRSPACE',
    title: 'Washington, DC SFRA',
    d: 'Authorized to operate inside the DC Special Flight Rules Area — airspace that demands documented clearance for every mission we fly there.',
  },
  {
    tag: 'LIABILITY',
    title: '$5M coverage',
    d: 'Five million dollars in liability coverage stands behind every engagement, sized for critical-infrastructure work.',
  },
  {
    tag: 'PROOF',
    title: 'Insurance proof on request',
    d: 'A certificate of insurance is available before contract signature. Ask, and it arrives with the engagement plan.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Data Security',
  description:
    'Jinki data security: AES-256 at rest, TLS 1.3 in transit, mutual NDA by default, on-premises processing, chain of custody, and NIST 800-53-aligned controls.',
  publisher: { '@type': 'Organization', name: 'Jinki Aerial Intelligence' },
};
---

<Base
  title="Data Security — Jinki Aerial Intelligence"
  description="How Jinki protects client data: AES-256 at rest, TLS 1.3 in transit, mutual NDA before first flight, on-premises processing, client-defined retention, and NIST 800-53-aligned controls."
  ogImage="/images/og-security-page.png"
  jsonLd={jsonLd}
>
  <Nav />
  <Breadcrumb items={[{ label: 'Data security' }]} />
  <main id="main-content">

    <!-- HERO -->
    <section aria-label="Data security" class="pt-10 md:pt-16">
      <div class="max-w-brief mx-auto px-5 sm:px-8 lg:px-12 2xl:px-16">
        <div class="folio-rule rule-draw flex items-baseline justify-between gap-4 pt-3 mb-12">
          <span class="mono-label text-ink-3"><span class="text-signal">DS</span>&nbsp;/&nbsp;DATA SECURITY</span>
          <span class="mono-label text-ink-3">AES-256 · TLS 1.3 · NDA DEFAULT</span>
        </div>
        <h1 class="text-display font-display font-medium text-ink max-w-[18ch] rise">
          Your data is the asset. <em class="not-italic text-signal">We treat it that way.</em>
        </h1>
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-x-6 mt-10">
          <p class="text-lede text-ink-2 lg:col-span-7 rise">
            An aerial survey of your facility is a map of how it fails. Jinki was built by an
            enterprise security and cyber risk practitioner — CISSP, CCSP, and AI-security
            certified (AAISM), formerly at Deloitte — so the controls below aren't a
            compliance afterthought. They are the operating procedure, in force today, on
            every engagement.
          </p>
          <div class="lg:col-span-4 lg:col-start-9 mono-label text-ink-3 flex flex-col gap-3 mt-6 lg:mt-0 rise">
            <span>FOUNDER · CISSP · CCSP · AAISM</span>
            <span>DEFAULT · MUTUAL NDA</span>
            <span>PROCESSING · ON-PREM AVAILABLE</span>
          </div>
        </div>
      </div>
    </section>

    <!-- 01 POSTURE -->
    <Section label="Security posture" cv>
      <SectionHeader
        index="01" label="POSTURE" datum="06 CONTROLS"
        title="The controls, in force today."
        lede="No aspirational language. Each row below describes how client data is handled right now — and each is verifiable in the engagement record."
      />
      <div>
        {posture.map((row) => (
          <div class="folio-rule rule-draw grid grid-cols-1 lg:grid-cols-12 gap-x-6 gap-y-2 pt-5 pb-7">
            <div class="lg:col-span-3 flex flex-col gap-1.5">
              <span class="mono-label text-signal">{row.tag}</span>
              <span class="mono-label text-ink-3">{row.spec}</span>
            </div>
            <div class="lg:col-span-8 lg:col-start-5">
              <h3 class="text-h3 font-display font-medium text-ink mb-2">{row.title}</h3>
              <p class="text-body text-ink-2 max-w-prose">{row.d}</p>
            </div>
          </div>
        ))}
      </div>
    </Section>

    <!-- 02 OPERATING AUTHORITY -->
    <Section label="Operating authority" cv>
      <SectionHeader
        index="02" label="OPERATING AUTHORITY" datum="PART 107 · DC SFRA · $5M"
        title="Licensed, authorized, insured."
      />
      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-6">
        {authority.map((item) => (
          <div class="folio-rule rule-draw pt-5 pb-6">
            <span class="mono-label text-signal">{item.tag}</span>
            <h3 class="text-h3 font-display font-medium text-ink mt-2 mb-2">{item.title}</h3>
            <p class="text-body text-ink-2">{item.d}</p>
          </div>
        ))}
      </div>
    </Section>

    <!-- 03 DISCLOSURE -->
    <Section label="Responsible disclosure" cv>
      <SectionHeader
        index="03" label="DISCLOSURE" datum="SECURITY@JINKI.AI"
        title="Found something? Tell us."
      />
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-x-6 gap-y-8">
        <div class="lg:col-span-7">
          <p class="text-body text-ink-2 max-w-prose">
            We welcome good-faith security research. Report a vulnerability in our systems to
            <a href="mailto:security@jinki.ai" class="text-ink link-draw no-underline">security@jinki.ai</a>
            with steps to reproduce, and we aim to acknowledge within 48 hours, share a remediation
            timeline, and credit you if you want credit. We take no legal action against
            good-faith researchers — allow us reasonable time to remediate before publishing.
          </p>
          <p class="text-body text-ink-2 max-w-prose mt-5">
            Controls built on NIST 800-53. Documented in our security brief. SOC 2 Type I
            audit on our roadmap.
          </p>
        </div>
        <div class="lg:col-span-4 lg:col-start-9">
          <div class="folio-rule rule-draw pt-4 pb-2 flex flex-col gap-3 items-start">
            <span class="mono-label text-ink-3">DOCUMENT · SECURITY BRIEF (PDF)</span>
            <Button href="/docs/jinki-security-brief.pdf" kind="ghost" event="download-security-brief:data-security">
              Download the security brief
            </Button>
          </div>
        </div>
      </div>
    </Section>

    <Section label="Engage" spacing="compact">
      <CTABlock
        title="Security review before signature."
        body="Detailed architecture documentation and data-handling procedures, provided under NDA — before you commit to anything."
        primary={{ label: 'Request security documentation', href: '/#lead-gen', event: 'cta-security-docs:data-security' }}
      />
    </Section>

  </main>
  <Footer />
</Base>
