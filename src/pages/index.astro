---
/*
  Home — the front page of the Intelligence Brief.
  Arc: Hero -> credentials -> the deliverable -> verticals Manifest ->
  two services -> process -> Founding Client Program -> LeadForm.
*/
import Base from '../layouts/Base.astro';
import Nav from '../components/ui/Nav.astro';
import Footer from '../components/ui/Footer.astro';
import Section from '../components/ui/Section.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import Button from '../components/ui/Button.astro';
import TelemetryStrip from '../components/ui/TelemetryStrip.astro';
import StatRow from '../components/ui/StatRow.astro';
import Manifest from '../components/ui/Manifest.astro';
import ProcessTimeline from '../components/ui/ProcessTimeline.astro';
import CTABlock from '../components/ui/CTABlock.astro';
import LeadForm from '../components/ui/LeadForm.astro';
import InspectionInstrument from '../components/ui/InspectionInstrument.astro';
import MissionPlayer from '../components/scenes/MissionPlayer.astro';

import heroVisible from '../assets/images/dc-rooftop-aerial.webp';
import heroThermal from '../assets/images/dc-rooftop-aerial-thermal.webp';
import heroGrid from '../data/thermal/dc-rooftop-aerial.json';
import reportP1 from '../assets/images/report-p1.webp';
import reportP3 from '../assets/images/report-p3.webp';
import thumbDc from '../assets/images/thumb-data-centers.webp';
import thumbEnergy from '../assets/images/thumb-energy-grid.webp';
import thumbSecurity from '../assets/images/thumb-security.webp';
import thumbAg from '../assets/images/thumb-agriculture.webp';
import thumbRe from '../assets/images/thumb-real-estate.webp';
import { Image } from 'astro:assets';

const verticalRows = [
  { index: '01', title: 'Data Centers', description: 'Rooftop HVAC cascade, membrane moisture, NFPA 70B hot spots — found before the outage.', datum: '±0.5°C', href: '/verticals/data-centers', thumb: thumbDc },
  { index: '02', title: 'Energy Grid', description: 'Corridor sweeps for line hardware, vegetation encroachment, and component heat signatures.', datum: '50 MI/DAY', href: '/verticals/energy-grid', thumb: thumbEnergy },
  { index: '03', title: 'Security', description: 'Perimeter thermal surveillance with sub-90-second alert-to-verification.', datum: '<90 S', href: '/verticals/security', thumb: thumbSecurity },
  { index: '04', title: 'Agriculture', description: 'Irrigation anomalies, crop stress, and drainage mapped across full acreage.', datum: '1,000+ AC', href: '/verticals/agriculture', thumb: thumbAg },
  { index: '05', title: 'Real Estate', description: 'Envelope performance, roof condition, and documentation for luxury portfolios.', datum: 'PORTFOLIO', href: '/verticals/real-estate', thumb: thumbRe },
];

const heroFindings = [
  { x: 14, y: 22, w: 17, h: 19, label: 'ANOMALY · ΔT +14.2°C', confidence: 0.94, labelAt: 'top' as const, severity: 'SEV-1' as const, title: 'Rooftop unit thermal anomaly' },
  { x: 58, y: 48, w: 14, h: 15, label: 'CRAH-7 BEARING HEAT', confidence: 0.88, labelAt: 'bottom' as const, severity: 'SEV-2' as const, title: 'CRAH bearing signature' },
  { x: 38, y: 70, w: 19, h: 12, label: 'MEMBRANE MOISTURE PATH', confidence: 0.81, labelAt: 'bottom' as const, severity: 'SEV-2' as const, title: 'Membrane moisture path' },
];

const stats = [
  { value: '0.5', suffix: '°C', label: 'RADIOMETRIC SENSITIVITY', source: 'Thermal sensor class, full-array single pass' },
  { value: '48', suffix: 'HR', label: 'SCAN TO RANKED REPORT', source: 'Severity-ranked findings, work-order ready' },
  { value: '90', suffix: 'S', label: 'ALERT TO VERIFICATION', source: 'Autonomous dock response, persistent deployments' },
  { value: '200', suffix: '/MO', label: 'AUTONOMOUS MISSION CAPACITY', source: 'Per dock station, around the clock' },
];

const process = [
  { title: 'Mutual NDA', sub: 'Before we see your site, your data is protected. Every engagement starts here.', mono: 'T+0' },
  { title: 'Aerial capture', sub: 'One pass: radiometric thermal + HD visual across rooftop, perimeter, and plant.', mono: 'DAY 1' },
  { title: 'AI analysis', sub: 'Detection, classification, severity ranking against NFPA 70B and ASHRAE thresholds.', mono: 'HR 24' },
  { title: 'Ranked report', sub: "Geolocated findings your team puts into Monday's work orders. Briefed by the founder.", mono: 'HR 48' },
];
---

<Base
  title="Jinki — Aerial Intelligence for Critical Infrastructure"
  description="Every anomaly on your facility — found from the air, ranked by severity, delivered in 48 hours. Radiometric thermal inspections that turn into prioritized maintenance work orders."
  ogImage="/images/og-homepage.png"
>
  <Nav />
  <main id="main-content">

    <!-- ============ S1 HERO ============ -->
    <!-- Fold contract (G1): badge + headline + lede + both CTAs inside
         100svh on a 768px-tall laptop. Rhythm is tight by design. -->
    <section aria-label="Jinki aerial intelligence" class="pt-8 md:pt-12">
      <div class="max-w-brief mx-auto px-5 sm:px-8 lg:px-12 2xl:px-16">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-x-6 gap-y-10">
          <div class="lg:col-span-9">
            <p class="mono-label text-ink-3 mb-4 rise">
              <span class="text-signal-soft">●</span>&nbsp; BOOKING Q3 2026 ASSESSMENTS
            </p>
            <h1 class="text-display font-display font-medium text-ink max-w-[20ch] rise">
              Every anomaly on your facility — found, ranked, delivered in <em class="not-italic text-signal">48 hours</em>.
            </h1>
            <p class="text-lede text-ink-2 mt-6 max-w-[58ch] rise">
              Radiometric thermal at 0.5°C sensitivity across your rooftop, perimeter, and
              plant in one aerial pass — delivered as a prioritized findings report your
              team can put into Monday's work orders.
            </p>
            <div class="flex flex-wrap items-center gap-3 mt-7 rise">
              <Button href="#lead-gen" event="cta-assessment:hero">Request Q3 assessment</Button>
              <Button href="/sample-report" kind="secondary" event="cta-sample:hero">See the sample report</Button>
            </div>
            <!-- Self-selection chips: a facilities director finds their
                 door in <3s (was an 11px mono footnote) -->
            <nav aria-label="Built for" class="mt-8 rise">
              <p class="mono-label text-ink-3 mb-3">BUILT FOR</p>
              <ul class="list-none m-0 p-0 flex flex-wrap gap-2">
                {verticalRows.map((v) => (
                  <li>
                    <a
                      href={v.href}
                      class="inline-flex items-center h-10 px-4 rounded-pill border border-rule-strong no-underline font-mono text-caption text-ink-2 transition-colors hover:border-signal hover:text-ink"
                    >{v.title}</a>
                  </li>
                ))}
              </ul>
            </nav>
          </div>
          <div class="hidden lg:flex lg:col-span-3 flex-col justify-end pb-2">
            <TelemetryStrip variant="rail" />
          </div>
        </div>
      </div>

      <!-- The Inspection Instrument: scan reveal -> findings tour -> live lens -->
      <div class="max-w-brief mx-auto px-5 sm:px-8 lg:px-12 2xl:px-16 mt-14 md:mt-20">
        <InspectionInstrument
          image={heroVisible}
          thermalImage={heroThermal}
          alt="Aerial view of a data center rooftop transitioning from visible light to annotated radiometric thermal imagery"
          findings={heroFindings}
          caption="FRAME 0331 · DEMONSTRATION ANALYSIS · DATA CENTER ROOFTOP · 39.02°N 77.45°W"
          grid={heroGrid}
          geo={{ latTop: 39.0226, latBottom: 39.0194, lonLeft: -77.4528, lonRight: -77.4472 }}
          loading="eager"
        />
      </div>
    </section>

    <!-- ============ S2 CREDENTIALS (label pairs, half the caps weight) ============ -->
    <div class="max-w-brief mx-auto px-5 sm:px-8 lg:px-12 2xl:px-16 mt-10">
      <div class="folio-rule rule-draw pt-5 pb-2 flex flex-wrap items-center gap-x-10 gap-y-4">
        {[
          ['FAA', 'Part 107'],
          ['DC SFRA', 'Certified'],
          ['$5M', 'Liability / op'],
          ['NDA', 'By default'],
        ].map(([k, v]) => (
          <span class="flex items-baseline gap-2">
            <span class="mono-label text-signal-soft">{k}</span>
            <span class="text-caption text-ink-2">{v}</span>
          </span>
        ))}
        <a href="https://www.nvidia.com/en-us/startups/" target="_blank" rel="noopener noreferrer" aria-label="NVIDIA Inception Program member" class="ml-auto opacity-75 hover:opacity-100 transition-opacity">
          <img src="/images/nvidia-inception-badge-color.svg" alt="NVIDIA Inception Program" class="cred-badge-dark h-9 w-auto" width="180" height="78" loading="lazy" decoding="async" />
          <img src="/images/nvidia-inception-badge-black.svg" alt="NVIDIA Inception Program" class="cred-badge-light h-9 w-auto" width="180" height="78" loading="lazy" decoding="async" />
        </a>
      </div>
    </div>
    <style>
      .cred-badge-light { display: none; }
      :global([data-theme='light']) .cred-badge-dark { display: none; }
      :global([data-theme='light']) .cred-badge-light { display: block; }
    </style>

    <!-- ============ S3 THE DELIVERABLE + STATS ============ -->
    <Section id="deliverable" label="The deliverable" cv>
      <SectionHeader
        index="01" label="THE DELIVERABLE" datum="WORK-ORDER READY"
        title="The report is the product."
        lede="Not footage. Not a dashboard login. A severity-ranked findings document — every anomaly geolocated, classified against NFPA 70B and ASHRAE thresholds, with a recommended action your team can schedule."
      />
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-x-6 gap-y-12 items-start">
        <div class="lg:col-span-7">
          <StatRow stats={stats} />
          <div class="mt-10 flex flex-wrap gap-3">
            <Button href="/sample-report" kind="secondary" event="cta-sample:deliverable">Download the sample report</Button>
          </div>
        </div>
        <!-- The actual document, rendered from the actual PDF -->
        <a href="/sample-report" class="lg:col-span-4 lg:col-start-9 no-underline group" aria-label="Preview the sample report">
          <div class="relative">
            <div class="border border-rule rounded-panel overflow-hidden rotate-1 translate-x-4 absolute inset-0 opacity-60 transition-transform duration-300 group-hover:rotate-2 group-hover:translate-x-6">
              <Image src={reportP3} alt="" width={360} loading="lazy" class="w-full" />
            </div>
            <div class="relative border border-rule-strong rounded-panel overflow-hidden bg-surface-1 transition-transform duration-300 group-hover:-rotate-1">
              <Image src={reportP1} alt="Cover page of the sample facility intelligence report" width={360} loading="lazy" class="w-full" />
              <span class="absolute bottom-0 left-0 right-0 flex items-center justify-between px-3 py-2 bg-surface-0/90 border-t border-rule mono-label text-ink-3">
                <span>SAMPLE REPORT · 6 PP</span>
                <span class="text-signal-soft">READ →</span>
              </span>
            </div>
          </div>
        </a>
      </div>
    </Section>

    <!-- ============ S4 THE MISSION (live scene) ============ -->
    <MissionPlayer />

    <!-- ============ S5 VERTICALS MANIFEST ============ -->
    <Section id="verticals" label="Verticals" cv>
      <SectionHeader
        index="03" label="VERTICALS" datum="05 SECTORS"
        title="Built for infrastructure that can't go down."
        lede="Each sector has named failure modes. We scan for them specifically — not generically."
      />
      <Manifest rows={verticalRows} />
    </Section>

    <!-- ============ S5 TWO SERVICES ============ -->
    <Section id="services" label="Services" cv>
      <SectionHeader
        index="04" label="SERVICES" datum="02 ENGAGEMENT MODES"
        title="One scan, or a standing watch."
        lede="Most engagements begin with a Scan. Deployments extend it into persistent, autonomous coverage."
      />
      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-10">
        <a href="/services/intelligence-scan" class="group folio-rule rule-draw block pt-6 pb-4 no-underline transition-colors hover:bg-surface-1 px-2 -mx-2">
          <span class="mono-label block mb-3"><span class="text-signal-soft">01 · ONE-TIME</span>&ensp;<span class="text-ink bg-signal-dim px-2 py-0.5 rounded-[2px]">START HERE</span></span>
          <h3 class="text-h2 font-display font-medium text-ink mb-3 transition-transform duration-200 group-hover:translate-x-2">Facility Intelligence Scan</h3>
          <p class="text-body text-ink-2 mb-4">One aerial pass. Full thermal + visual capture, AI analysis, and a severity-ranked report in 48 hours. The entry point.</p>
          <span class="mono-label text-ink-3">48 HR TURNAROUND →</span>
        </a>
        <a href="/services/deployment" class="group folio-rule rule-draw block pt-6 pb-4 no-underline transition-colors hover:bg-surface-1 px-2 -mx-2">
          <span class="mono-label text-signal block mb-3">02 · PERSISTENT</span>
          <h3 class="text-h2 font-display font-medium text-ink mb-3 transition-transform duration-200 group-hover:translate-x-2">Autonomous Deployment</h3>
          <p class="text-body text-ink-2 mb-4">An on-site dock station running 150–200 missions a month. Thermal baselines, degradation velocity, alert verification — no operator required.</p>
          <span class="mono-label text-ink-3">24/7 COVERAGE →</span>
        </a>
      </div>
    </Section>

    <!-- ============ S6 PROCESS ============ -->
    <Section id="process" label="Process" cv>
      <SectionHeader
        index="05" label="PROCESS" datum="NDA → REPORT"
        title="What happens after you submit."
        lede="Four steps, NDA to report. Your data is processed on-premises, encrypted AES-256 in transit and at rest, and never leaves your control."
      />
      <ProcessTimeline steps={process} />
      <p class="text-caption text-ink-3 mt-8">
        Security posture in full: <a href="/data-security" class="text-ink-2 link-draw no-underline">data handling &amp; controls →</a>
      </p>
    </Section>

    <!-- ============ S7 FOUNDING CLIENT PROGRAM ============ -->
    <Section id="founding" label="Founding client program" cv>
      <div class="folio-rule rule-draw flex items-baseline justify-between gap-4 pt-3 mb-10">
        <span class="mono-label text-ink-3"><span class="text-signal">06</span>&nbsp;/&nbsp;FOUNDING CLIENT PROGRAM</span>
        <span class="mono-label text-ink-3">Q3 2026 COHORT</span>
      </div>
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-x-6 gap-y-10">
        <div class="lg:col-span-6">
          <h2 class="text-h2 font-display font-medium text-ink rise">We're a new operator with enterprise-grade credentials — and a small number of Q3 slots.</h2>
          <p class="text-lede text-ink-2 mt-5 rise">Founding clients get terms we won't offer twice.</p>
        </div>
        <div class="lg:col-span-5 lg:col-start-8">
          <ul class="list-none m-0 p-0">
            {[
              { t: 'Founding rate', d: 'Locked engagement pricing for the first cohort.' },
              { t: 'Priority scheduling', d: 'First access to Q3 assessment windows.' },
              { t: 'Direct founder involvement', d: 'The founder plans, reviews, and presents every founding engagement personally.' },
            ].map((item, i) => (
              <li class="folio-rule pt-4 pb-5">
                <span class="mono-label text-signal tabular">{String(i + 1).padStart(2, '0')}</span>
                <h3 class="text-h3 font-display font-medium text-ink mt-2 mb-1">{item.t}</h3>
                <p class="text-body text-ink-2">{item.d}</p>
              </li>
            ))}
          </ul>
        </div>
      </div>
      <CTABlock
        class="mt-14"
        title="Hold a Q3 slot before the cohort closes."
        primary={{ label: 'Request Q3 assessment', href: '#lead-gen', event: 'cta-assessment:founding' }}
        secondary={{ label: 'See the sample report', href: '/sample-report', kind: 'secondary', event: 'cta-sample:founding' }}
      />
    </Section>

    <!-- ============ S8 LEAD FORM ============ -->
    <LeadForm context="/" />

  </main>
  <Footer />
</Base>
