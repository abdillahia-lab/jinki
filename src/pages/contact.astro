---
/*
  Contact — founder-direct routing table. No SDRs, no ticket queue:
  four channels, one inbox, one business day. Ends in the LeadForm.
*/
import Base from '../layouts/Base.astro';
import Nav from '../components/ui/Nav.astro';
import Footer from '../components/ui/Footer.astro';
import Section from '../components/ui/Section.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import Breadcrumb from '../components/ui/Breadcrumb.astro';
import LeadForm from '../components/ui/LeadForm.astro';

const channels = [
  {
    t: 'Assessment requests',
    d: 'Two fields, a one-business-day response target, and a mutual NDA before we see your site. Q3 founding-cohort slots are scoped and confirmed by the founder personally.',
    href: '/#lead-gen',
    route: 'REQUEST FORM',
  },
  {
    t: 'Sample report',
    d: 'See the deliverable before you talk to anyone — a redacted findings report with severity rankings, geolocated anomalies, and repair sequencing.',
    href: '/sample-report',
    route: 'VIEW REPORT',
  },
  {
    t: 'Capabilities brief',
    d: 'A one-page PDF — what we do, the deliverable, the trust posture, and the founding engagement. Built to forward to whoever signs off.',
    href: '/docs/jinki-capabilities-brief.pdf',
    route: 'DOWNLOAD PDF',
  },
  {
    t: 'Direct email',
    d: 'Partnerships, press, procurement paperwork, or anything that doesn’t fit a form. Plain email, read by the person whose name is on the company.',
    href: 'mailto:info@jinki.ai',
    route: 'INFO@JINKI.AI',
  },
  {
    t: 'Security disclosures',
    d: 'Found something in our site, our process, or our data handling? Report it with the subject line pre-set — disclosures get acknowledged first in the queue.',
    href: 'mailto:info@jinki.ai?subject=Security%20disclosure',
    route: 'DISCLOSE',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  mainEntity: {
    '@type': 'Organization',
    name: 'Jinki Aerial Intelligence',
    url: 'https://jinki.ai',
    email: 'info@jinki.ai',
    contactPoint: {
      '@type': 'ContactPoint',
      contactType: 'sales',
      email: 'info@jinki.ai',
      areaServed: 'US',
    },
  },
};
---

<Base
  title="Contact — Jinki Aerial Intelligence"
  description="Founder-direct contact. No SDRs, no ticket queue — assessment requests, sample reports, and security disclosures all reach one inbox — responses targeted within one business day."
  jsonLd={jsonLd}
>
  <Nav />
  <Breadcrumb items={[{ label: 'Contact' }]} />
  <main id="main-content">

    <!-- HERO -->
    <section aria-label="Contact Jinki" class="pt-10 md:pt-16">
      <div class="max-w-brief mx-auto px-5 sm:px-8 lg:px-12 2xl:px-16">
        <div class="folio-rule rule-draw flex items-baseline justify-between gap-4 pt-3 mb-12">
          <span class="mono-label text-ink-3"><span class="text-signal">CT</span>&nbsp;/&nbsp;CONTACT</span>
          <span class="mono-label text-ink-3">FOUNDER-DIRECT · NO SDRS</span>
        </div>
        <h1 class="text-display font-display font-medium text-ink max-w-[18ch] rise">
          One inbox. <em class="not-italic text-signal">A one-business-day target.</em>
        </h1>
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-x-6 mt-10">
          <p class="text-lede text-ink-2 lg:col-span-7 rise">
            There is no sales development team between you and an answer. Every channel
            on this page lands in the founder’s inbox, and he replies within one
            business day — because the person who scopes your engagement is the person
            who plans the mission and presents the findings.
          </p>
          <div class="lg:col-span-4 lg:col-start-9 mono-label text-ink-3 flex flex-col gap-3 mt-6 lg:mt-0 rise">
            <span>RESPONSE TARGET · &lt; 1 BUSINESS DAY</span>
            <span>ROUTING · DIRECT TO FOUNDER</span>
            <span>NDA · MUTUAL, BEFORE SITE DETAILS</span>
          </div>
        </div>
      </div>
    </section>

    <!-- CHANNELS -->
    <Section label="Channels" cv>
      <SectionHeader
        index="01" label="CHANNELS" datum="04 ROUTES · ONE DESTINATION"
        title="Pick the door. Same room behind all of them."
      />
      <div>
        {channels.map((c, i) => (
          <a
            href={c.href}
            class="folio-rule rule-draw group grid grid-cols-1 lg:grid-cols-12 gap-x-6 gap-y-2 pt-5 pb-6 no-underline"
          >
            <div class="lg:col-span-4">
              <span class="mono-label text-signal tabular">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="text-h3 font-display font-medium text-ink mt-2">{c.t}</h3>
            </div>
            <p class="text-body text-ink-2 lg:col-span-5 m-0">{c.d}</p>
            <span class="mono-label text-ink-3 lg:col-span-3 lg:text-right transition-colors group-hover:text-ink">
              {c.route}&nbsp;→
            </span>
          </a>
        ))}
      </div>
    </Section>

    <LeadForm context="/contact" />

  </main>
  <Footer />
</Base>
