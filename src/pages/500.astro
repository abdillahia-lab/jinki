---
/*
  500 — Telemetry fault. Our side, not yours.
  One folio rule, one display line, one way home. Zero JS.
*/
import Base from '../layouts/Base.astro';
import Nav from '../components/ui/Nav.astro';
import Footer from '../components/ui/Footer.astro';
import Button from '../components/ui/Button.astro';
---

<Base
  title="500 — Telemetry Fault | Jinki Aerial Intelligence"
  description="The instrument hit a fault on our side. Retry in a moment."
  noindex
>
  <Nav />
  <main id="main-content">
    <section aria-label="Server error" class="pt-10 md:pt-16 pb-24 md:pb-32 min-h-[60vh]">
      <div class="max-w-brief mx-auto px-5 sm:px-8 lg:px-12 2xl:px-16">
        <div class="folio-rule rule-draw flex items-baseline justify-between gap-4 pt-3 mb-12">
          <span class="mono-label text-ink-3"><span class="text-signal">500</span>&nbsp;/&nbsp;TELEMETRY FAULT</span>
          <span class="mono-label text-ink-3 hidden sm:block">FAULT · SERVER-SIDE</span>
        </div>
        <h1 class="text-display font-display font-medium text-ink max-w-[16ch] rise">
          The instrument hit a fault.
        </h1>
        <p class="mono-label-long text-signal-soft mt-8 rise">
          OUR SIDE, NOT YOURS — RETRY IN A MOMENT
        </p>
        <p class="text-body text-ink-2 mt-4 max-w-prose rise">
          The request reached us and failed in processing. A refresh usually clears it;
          if it persists, the fault is logged on our end.
        </p>
        <div class="mt-10 rise">
          <Button href="/" event="cta-home:500">Back to base</Button>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Base>
