---
/*
  Embodied AI — direction note. Unlinked from nav, noindex, direct URL only.
  Monochrome restraint: ink wireframe hand, one signal fingertip, no promises.
*/
import Base from '../layouts/Base.astro';
import Nav from '../components/ui/Nav.astro';
import Footer from '../components/ui/Footer.astro';
import Section from '../components/ui/Section.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import Breadcrumb from '../components/ui/Breadcrumb.astro';

const threads = [
  {
    t: 'Edge perception without the cloud',
    d: 'Inference that runs on the machine itself, in environments where connectivity is intermittent or absent. The same perception stack we run aloft, moved on-device.',
  },
  {
    t: 'Multi-modal sensor fusion',
    d: 'Thermal, visual, depth, and inertial streams synthesized into a single model of the scene — built on the pipeline we refine across aerial operations.',
  },
  {
    t: 'Autonomy across modalities',
    d: 'The hard part of autonomy is not the platform. It is the decision layer that turns perception into action — and transfers across air, ground, and surface domains.',
  },
];
---

<Base
  title="Embodied AI — Jinki"
  description="Embodied AI research at Jinki. Extending the perception and autonomy stack from aerial platforms into broader embodied systems. In development."
  noindex={true}
>
  <Nav />
  <Breadcrumb items={[{ label: 'Embodied AI' }]} />
  <main id="main-content">

    <!-- HERO -->
    <section aria-label="Embodied AI" class="pt-10 md:pt-16">
      <div class="max-w-brief mx-auto px-5 sm:px-8 lg:px-12 2xl:px-16">
        <div class="folio-rule rule-draw flex items-baseline justify-between gap-4 pt-3 mb-12">
          <span class="mono-label text-ink-3"><span class="text-signal">EA</span>&nbsp;/&nbsp;EMBODIED AI</span>
          <span class="mono-label text-ink-3">IN DEVELOPMENT · NOT YET AVAILABLE</span>
        </div>
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-x-6 gap-y-12 items-center">
          <div class="lg:col-span-7">
            <h1 class="text-display font-display font-medium text-ink max-w-[16ch] rise">
              Aerial intelligence, <em class="not-italic text-signal">brought down to earth.</em>
            </h1>
            <p class="text-lede text-ink-2 mt-8 rise">
              We have spent our time so far teaching machines to see, classify, and rank
              what matters in the physical world from above. That perception stack is the
              foundation for what comes next — embodied systems that do not just observe
              the world, but act in it.
            </p>
            <p class="font-mono text-caption text-ink-3 mt-8 rise">
              We're not ready to share specifics. This page exists so the URL does.
            </p>
          </div>

          <!-- Wireframe hand -->
          <div class="lg:col-span-4 lg:col-start-9 max-w-sm mx-auto w-full" aria-hidden="true">
            <svg viewBox="380 130 540 640" fill="none" preserveAspectRatio="xMidYMid meet" class="w-full h-auto block">
              <defs>
                <radialGradient id="emb-tip-glow" cx="50%" cy="50%" r="50%">
                  <stop offset="0%" stop-color="var(--signal)" stop-opacity="0.9"/>
                  <stop offset="55%" stop-color="var(--signal)" stop-opacity="0.16"/>
                  <stop offset="100%" stop-color="var(--signal)" stop-opacity="0"/>
                </radialGradient>
              </defs>

              <g stroke="var(--rule-strong)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" fill="none">
                <!-- Palm outline -->
                <path d="M 540 720 L 460 480 L 510 450 L 570 440 L 630 450 L 690 460 L 740 520 L 720 720 Z" stroke-width="1.2"/>
                <!-- Wrist band -->
                <line x1="540" y1="720" x2="720" y2="720" stroke-width="1.4"/>
                <line x1="545" y1="735" x2="715" y2="735" stroke-opacity="0.6"/>
                <line x1="550" y1="750" x2="710" y2="750" stroke-opacity="0.35"/>
                <!-- Pinky -->
                <line x1="460" y1="480" x2="445" y2="395"/>
                <line x1="445" y1="395" x2="438" y2="335"/>
                <line x1="438" y1="335" x2="435" y2="290"/>
                <!-- Ring -->
                <line x1="510" y1="450" x2="505" y2="335"/>
                <line x1="505" y1="335" x2="503" y2="260"/>
                <line x1="503" y1="260" x2="503" y2="210"/>
                <!-- Middle -->
                <line x1="570" y1="440" x2="572" y2="315"/>
                <line x1="572" y1="315" x2="575" y2="225"/>
                <line x1="575" y1="225" x2="578" y2="170"/>
                <!-- Index -->
                <line x1="630" y1="450" x2="640" y2="335"/>
                <line x1="640" y1="335" x2="648" y2="260"/>
                <line x1="648" y1="260" x2="654" y2="210"/>
                <!-- Thumb -->
                <line x1="740" y1="520" x2="800" y2="465"/>
                <line x1="800" y1="465" x2="845" y2="425"/>
                <line x1="845" y1="425" x2="880" y2="395"/>
                <!-- Inner palm metacarpals -->
                <g stroke-opacity="0.5" stroke-width="0.9">
                  <line x1="630" y1="700" x2="460" y2="480"/>
                  <line x1="630" y1="700" x2="510" y2="450"/>
                  <line x1="630" y1="700" x2="570" y2="440"/>
                  <line x1="630" y1="700" x2="630" y2="450"/>
                  <line x1="630" y1="700" x2="740" y2="520"/>
                </g>
              </g>

              <!-- Joint nodes -->
              <g fill="var(--ink-1)" fill-opacity="0.45">
                <circle cx="460" cy="480" r="4"/>
                <circle cx="510" cy="450" r="4"/>
                <circle cx="570" cy="440" r="4"/>
                <circle cx="630" cy="450" r="4"/>
                <circle cx="740" cy="520" r="4"/>
                <circle cx="445" cy="395" r="3"/>
                <circle cx="438" cy="335" r="3"/>
                <circle cx="505" cy="335" r="3"/>
                <circle cx="503" cy="260" r="3"/>
                <circle cx="572" cy="315" r="3"/>
                <circle cx="575" cy="225" r="3"/>
                <circle cx="640" cy="335" r="3"/>
                <circle cx="648" cy="260" r="3"/>
                <circle cx="800" cy="465" r="3"/>
                <circle cx="845" cy="425" r="3"/>
                <circle cx="630" cy="720" r="3.5"/>
              </g>

              <!-- Fingertips -->
              <g fill="var(--signal)">
                <circle cx="435" cy="290" r="3.5"/>
                <circle cx="503" cy="210" r="3.5"/>
                <circle cx="578" cy="170" r="3.5"/>
                <circle cx="654" cy="210" r="3.5"/>
                <circle cx="880" cy="395" r="3.5"/>
              </g>

              <!-- Active middle fingertip — pulsing glow -->
              <circle class="hand-motion" cx="578" cy="170" r="16" fill="url(#emb-tip-glow)">
                <animate attributeName="r" values="10;30;10" dur="4s" repeatCount="indefinite"/>
                <animate attributeName="opacity" values="0.9;0.15;0.9" dur="4s" repeatCount="indefinite"/>
              </circle>

              <!-- Signal traveling up middle finger from wrist -->
              <circle class="hand-motion" r="3" fill="var(--signal)">
                <animateMotion dur="3.2s" repeatCount="indefinite" path="M 630 720 L 570 440 L 572 315 L 575 225 L 578 170"/>
                <animate attributeName="opacity" values="0;0.9;0.9;0" keyTimes="0;0.12;0.88;1" dur="3.2s" repeatCount="indefinite"/>
              </circle>

              <!-- Coordinate frame markers at wrist -->
              <g stroke="var(--rule-strong)" stroke-width="0.8" fill="var(--ink-3)" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" font-size="10" letter-spacing="0.05em">
                <line x1="450" y1="765" x2="490" y2="765"/>
                <line x1="450" y1="765" x2="450" y2="745"/>
                <text x="496" y="769">x</text>
                <text x="446" y="738">y</text>
              </g>
            </svg>
          </div>
        </div>
      </div>
    </section>

    <!-- DIRECTION -->
    <Section label="Research direction" cv>
      <SectionHeader
        index="01" label="DIRECTION" datum="03 THREADS"
        title="What we're working toward."
        lede="Three research threads, framed as directions rather than products. Specifics ship when there is something real to show."
      />
      <div>
        {threads.map((item, i) => (
          <div class="folio-rule rule-draw grid grid-cols-1 lg:grid-cols-12 gap-x-6 gap-y-3 pt-5 pb-10">
            <span class="mono-label text-signal tabular lg:col-span-1">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="text-h3 font-display font-medium text-ink lg:col-span-4">{item.t}</h3>
            <p class="text-body text-ink-2 lg:col-span-6 lg:col-start-7">{item.d}</p>
          </div>
        ))}
      </div>
    </Section>

    <!-- CONTACT -->
    <Section label="Contact" spacing="compact" cv>
      <div class="folio-rule rule-draw flex flex-wrap items-baseline justify-between gap-4 pt-4 pb-2">
        <span class="mono-label text-ink-3 max-w-none">WORKING IN EMBODIED SYSTEMS, EDGE INFERENCE, OR AUTONOMY?</span>
        <a href="mailto:info@jinki.ai?subject=Embodied%20AI" class="mono-label text-ink-2 no-underline hover:text-ink max-w-none">INFO@JINKI.AI&nbsp;→</a>
      </div>
    </Section>

  </main>
  <Footer />
</Base>

<style>
  @media (prefers-reduced-motion: reduce) {
    .hand-motion { display: none; }
  }
</style>
