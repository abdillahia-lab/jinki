---
/*
  Real Estate Vertical | Jinki Aerial Intelligence

  Premium aerial photography for luxury homes, condos, and apartment
  developments. Same brand architecture as the other vertical pages
  (Nav + Breadcrumb + hero + capability + use cases + process + LeadGen +
  Footer). Visual language mirrors the Intelligence Scan redesign:
  hairline dividers, generous whitespace, minimal motion.

  Accent: amber gold (#EAB308) — warm, classic luxury, distinct from
  the other four verticals' cool/bright palettes.

  Followup asset need: a dedicated luxury residential aerial hero photo.
  Currently using /images/facility-night-aerial.webp as interim — it reads
  as "illuminated residential complex at dusk" which is acceptable
  placeholder for the luxury-condo / apartment-community segment.
*/
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import LeadGen from '../../components/LeadGen.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Footer from '../../components/Footer.astro';

const stats = [
  { value: '4K + 45MP', label: 'Hi-res stills and cinematic 4K video captured every flight.' },
  { value: 'Golden Hour', label: 'Weather-windowed scheduling for the 30-minute window that makes listings move.' },
  { value: '48 hr', label: 'Edited deliverables returned inside two business days of the flight.' },
  { value: 'FAA 107', label: 'Licensed pilot, $5M liability, and NDA-by-default for pre-market listings.' },
];

const useCases = [
  {
    title: 'Luxury Estates',
    icon: 'villa',
    desc: 'Multi-acre residential properties where a single listing photo cannot carry the story. We fly the surround — treeline, shoreline, approach drive — at the altitude that makes scale legible.',
    crop: '18% 30%',
  },
  {
    title: 'Penthouse & High-Rise Condos',
    icon: 'apartment',
    desc: 'Exterior tower aerials, roof-deck views, and surround context that a ground camera cannot capture. Ideal for marketing pre-sale or for resale of top-floor units.',
    crop: '62% 25%',
  },
  {
    title: 'Luxury Apartment Communities',
    icon: 'location_city',
    desc: 'Full-property aerials for leasing marketing — amenity decks, pool zones, parking structure, pedestrian paths. Delivered as a campaign-ready photo set plus a 30-second edit for social.',
    crop: '40% 55%',
  },
  {
    title: 'New Construction Marketing',
    icon: 'construction',
    desc: 'Pre-listing launch aerials captured during final finishing. Monthly progress flights for developer and lender reporting, with date-stamped chain of custody.',
    crop: '78% 40%',
  },
  {
    title: 'Twilight & Golden Hour',
    icon: 'wb_twilight',
    desc: 'Scheduled sunset and blue-hour flights for the signature hero photo. Weather-windowed with 24-hour rescheduling if conditions do not match the shot list.',
    crop: '30% 70%',
  },
];

const process = [
  { step: '01', title: 'Scope Call', desc: 'Fifteen-minute brief on the property, the shot list, and the listing timeline. We quote within one business day.' },
  { step: '02', title: 'Flight Window', desc: 'Golden hour or twilight slot confirmed 24 hours before the shoot. If the weather window misses, we reschedule at no charge.' },
  { step: '03', title: 'On-Site Flight', desc: 'Typically 45–90 minutes on the property. Multiple altitudes, orbit passes, context shots, and hero angles per a pre-approved shot list.' },
  { step: '04', title: 'Edit & Delivery', desc: 'Edited hi-res stills plus a 4K video master delivered within 48 hours via secure link. Unedited archive retained for 90 days.' },
];
---

<Layout
  ogImage="/images/og-default.png"
  title="Real Estate Aerial Photography — Jinki Aerial Intelligence"
  description="Premium aerial photography for luxury homes, condos, and apartment developments. Golden-hour flights, 4K + hi-res stills, 48-hour delivery. FAA Part 107 certified, NDA by default."
  jsonLd={{
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Real Estate Aerial Photography",
    "provider": { "@type": "Organization", "name": "Jinki Aerial Intelligence" },
    "description": "Luxury residential aerial photography for homes, condos, and apartment developments — golden-hour scheduled, 4K + hi-res stills, 48-hour turnaround.",
    "areaServed": "Mid-Atlantic United States",
    "serviceType": "Real Estate Aerial Photography",
  }}
>
  <Nav />
  <Breadcrumb items={[{ label: "Verticals" }, { label: "Real Estate" }]} />
  <main id="main-content">

    <!-- ============ HERO ============ -->
    <section class="re-hero" aria-label="Real Estate Aerial Photography">
      <div class="re-hero-bg" aria-hidden="true">
        <picture>
          <source srcset="/images/facility-night-aerial.webp" type="image/webp" />
          <img
            src="/images/facility-night-aerial.jpg"
            alt=""
            class="re-hero-img"
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
        </picture>
        <div class="re-hero-scrim"></div>
      </div>

      <div class="re-hero-inner">
        <div class="re-hero-content reveal">
          <span class="re-eyebrow">Real Estate</span>
          <h1 class="re-hero-title">
            Aerial photography for the listings that <span class="re-hero-accent">move.</span>
          </h1>
          <p class="re-hero-subtitle">
            Luxury homes, condos, and apartment developments — captured with the same craft and delivery discipline as our thermal inspection work. Golden-hour scheduled. Delivered inside 48 hours. Never a stock photo in sight.
          </p>
          <div class="re-hero-actions">
            <a href="#lead-gen" class="re-cta-primary">Request a Quote</a>
            <a href="#use-cases" class="re-cta-secondary">See What We Photograph</a>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ CAPABILITY ============ -->
    <section class="re-section" aria-label="Capability">
      <div class="re-inner">
        <div class="re-section-header reveal">
          <span class="re-eyebrow">Capability</span>
          <h2>What a single flight captures.</h2>
        </div>

        <div class="re-stats-grid reveal">
          {stats.map((s) => (
            <div class="re-stat">
              <span class="re-stat-val">{s.value}</span>
              <span class="re-stat-lbl">{s.label}</span>
            </div>
          ))}
        </div>

        <blockquote class="re-pull-quote reveal">
          &ldquo;Real estate listings with aerial photography sell 68% faster than those without.&rdquo;
          <cite>— National Association of Realtors · MLS data analysis</cite>
        </blockquote>
      </div>
    </section>

    <!-- ============ USE CASES ============ -->
    <section id="use-cases" class="re-section re-use-cases" style="background: var(--surface-dim);" aria-label="What we photograph">
      <div class="re-inner">
        <div class="re-section-header reveal">
          <span class="re-eyebrow">What We Photograph</span>
          <h2>Five use cases where aerial wins the listing.</h2>
          <p class="re-section-lede">
            Every engagement is shot-listed ahead of the flight, reviewed by the property owner or listing agent, and delivered edited — not as a raw dump of unretouched stills.
          </p>
        </div>

        <div class="re-use-grid reveal">
          {useCases.map((u) => (
            <article class="re-use-card">
              <div class="re-use-crop" style={`background-position: ${u.crop};`} aria-hidden="true">
                <div class="re-use-gradient"></div>
              </div>
              <div class="re-use-body">
                <span class="material-symbols-outlined re-use-icon" aria-hidden="true">{u.icon}</span>
                <h3 class="re-use-title">{u.title}</h3>
                <p class="re-use-desc">{u.desc}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ PROCESS ============ -->
    <section class="re-section" aria-label="Engagement process">
      <div class="re-inner">
        <div class="re-section-header reveal">
          <span class="re-eyebrow">Engagement</span>
          <h2>Brief to edited delivery. Four steps.</h2>
          <p class="re-section-lede">
            Signed Friday, shot by Tuesday, delivered by Thursday. The flight itself takes less than two hours. The timeline is built so your listing hits MLS the week you planned for it.
          </p>
        </div>

        <ol class="re-process-timeline reveal">
          {process.map((p) => (
            <li class="re-step">
              <span class="re-step-num">{p.step}</span>
              <h3 class="re-step-title">{p.title}</h3>
              <p class="re-step-desc">{p.desc}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- ============ TRUST ============ -->
    <section class="re-section re-trust" aria-label="Compliance and trust">
      <div class="re-inner">
        <div class="re-trust-grid reveal">
          <div class="re-trust-item">
            <span class="re-trust-label">FAA Part 107</span>
            <span class="re-trust-desc">Licensed remote pilot certificate for every flight.</span>
          </div>
          <div class="re-trust-item">
            <span class="re-trust-label">DC SFRA Trained</span>
            <span class="re-trust-desc">Cleared for Washington DC's Special Flight Rules Area airspace.</span>
          </div>
          <div class="re-trust-item">
            <span class="re-trust-label">$5M Liability</span>
            <span class="re-trust-desc">Commercial drone insurance per operation. Proof of coverage available on request.</span>
          </div>
          <div class="re-trust-item">
            <span class="re-trust-label">NDA by Default</span>
            <span class="re-trust-desc">Pre-market listings kept confidential. Mutual NDA available before the first shoot.</span>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ CROSS-LINKS ============ -->
    <section class="reveal" style="max-width: 900px; margin: 0 auto; padding: 0 1.5rem 3rem;" aria-label="Other verticals we serve">
      <p style="text-align: center; font-family: var(--font-label); font-size: 0.75rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-tertiary); margin-bottom: 1rem;">Other Verticals</p>
      <div style="display: flex; gap: 0.75rem; flex-wrap: wrap; justify-content: center;">
        <a href="/verticals/data-centers" style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.6rem 1.25rem; border-radius: 8px; border: 1px solid var(--glass-border); background: var(--glass-bg); color: var(--text-secondary); font-family: var(--font-label); font-size: 0.75rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; text-decoration: none; transition: background 0.25s ease, color 0.25s ease, border-color 0.25s ease, transform 0.25s ease;">Data Centers</a>
        <a href="/verticals/energy-grid" style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.6rem 1.25rem; border-radius: 8px; border: 1px solid var(--glass-border); background: var(--glass-bg); color: var(--text-secondary); font-family: var(--font-label); font-size: 0.75rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; text-decoration: none; transition: background 0.25s ease, color 0.25s ease, border-color 0.25s ease, transform 0.25s ease;">Energy & Grid</a>
        <a href="/verticals/security" style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.6rem 1.25rem; border-radius: 8px; border: 1px solid var(--glass-border); background: var(--glass-bg); color: var(--text-secondary); font-family: var(--font-label); font-size: 0.75rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; text-decoration: none; transition: background 0.25s ease, color 0.25s ease, border-color 0.25s ease, transform 0.25s ease;">Perimeter Security</a>
        <a href="/verticals/agriculture" style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.6rem 1.25rem; border-radius: 8px; border: 1px solid var(--glass-border); background: var(--glass-bg); color: var(--text-secondary); font-family: var(--font-label); font-size: 0.75rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; text-decoration: none; transition: background 0.25s ease, color 0.25s ease, border-color 0.25s ease, transform 0.25s ease;">Agriculture</a>
      </div>
    </section>

    <LeadGen />
  </main>
  <Footer />
</Layout>

<style>
  /* Real Estate vertical — amber-gold accent, premium whitespace, minimal motion.
     Mirrors the .is-* architecture used on the Intelligence Scan page. */

  :root {
    --re-accent: #EAB308;
    --re-accent-soft: color-mix(in srgb, #EAB308 18%, transparent);
  }

  /* ========== HERO ========== */
  .re-hero {
    position: relative;
    min-height: 72vh;
    min-height: 72dvh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    padding: 7rem 0 5rem;
  }
  @media (min-width: 768px)  { .re-hero { padding: 9rem 0 7rem; } }
  @media (min-width: 1024px) { .re-hero { padding: 11rem 0 8rem; } }

  .re-hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .re-hero-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    filter: saturate(0.9);
  }
  .re-hero-scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(4,8,14,0.3) 0%, rgba(4,8,14,0.65) 55%, rgba(4,8,14,0.92) 100%),
      radial-gradient(ellipse 80% 70% at 30% 60%, color-mix(in srgb, var(--re-accent) 8%, transparent), transparent 60%);
  }

  .re-hero-inner {
    position: relative;
    z-index: 1;
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 1.5rem;
    width: 100%;
  }
  @media (min-width: 768px) { .re-hero-inner { padding: 0 2.5rem; } }

  .re-hero-content { max-width: 780px; }

  .re-hero-title {
    font-family: var(--font-headline);
    font-size: clamp(2.25rem, 5vw + 0.5rem, 4.25rem);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--text-primary);
    margin: 0;
  }
  .re-hero-accent {
    color: var(--re-accent);
    font-style: italic;
  }

  .re-hero-subtitle {
    margin-top: 1.75rem;
    font-family: var(--font-body);
    font-size: clamp(1rem, 1vw + 0.625rem, 1.1875rem);
    line-height: 1.6;
    color: var(--text-secondary);
    max-width: 640px;
  }

  .re-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.875rem;
    margin-top: 2.5rem;
  }

  .re-cta-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.95rem 2rem;
    border-radius: 12px;
    background: var(--re-accent);
    color: #1a1200;
    font-family: var(--font-headline);
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    text-decoration: none;
    border: none;
    box-shadow: 0 4px 16px color-mix(in srgb, var(--re-accent) 30%, transparent);
    transition: transform 0.25s ease, filter 0.25s ease, box-shadow 0.25s ease;
  }
  .re-cta-primary:hover {
    transform: translateY(-1px);
    filter: brightness(1.08);
    box-shadow: 0 8px 28px color-mix(in srgb, var(--re-accent) 42%, transparent);
  }
  .re-cta-primary:active { transform: translateY(0); filter: brightness(1); }

  .re-cta-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.9rem 1.75rem;
    border-radius: 12px;
    border: 1px solid color-mix(in srgb, var(--re-accent) 35%, transparent);
    background: transparent;
    color: var(--text-primary);
    font-family: var(--font-headline);
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    text-decoration: none;
    transition: background 0.25s ease, border-color 0.25s ease, color 0.25s ease, transform 0.25s ease;
  }
  .re-cta-secondary:hover {
    background: color-mix(in srgb, var(--re-accent) 10%, transparent);
    border-color: var(--re-accent);
    color: var(--re-accent);
    transform: translateY(-1px);
  }

  /* ========== SHARED SECTION SCAFFOLD ========== */
  .re-section { padding: 5rem 0; }
  @media (min-width: 768px)  { .re-section { padding: 7rem 0; } }
  @media (min-width: 1024px) { .re-section { padding: 8rem 0; } }

  .re-inner {
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }
  @media (min-width: 768px) { .re-inner { padding: 0 2.5rem; } }

  .re-eyebrow {
    display: inline-block;
    font-family: var(--font-label);
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--re-accent);
    margin-bottom: 1.25rem;
  }

  .re-section-header {
    margin-bottom: 3.5rem;
    max-width: 720px;
  }
  @media (min-width: 768px) { .re-section-header { margin-bottom: 4.5rem; } }

  .re-section-header h2 {
    font-family: var(--font-headline);
    font-size: clamp(1.875rem, 3vw + 0.5rem, 2.75rem);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.025em;
    color: var(--text-primary);
    margin: 0;
  }

  .re-section-lede {
    margin: 1.5rem 0 0;
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.65;
    color: var(--text-secondary);
    max-width: 620px;
  }

  /* ========== CAPABILITY ========== */
  .re-stats-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    margin-bottom: 4rem;
  }
  @media (min-width: 640px)  { .re-stats-grid { grid-template-columns: repeat(2, 1fr); gap: 2.5rem 3rem; } }
  @media (min-width: 1024px) { .re-stats-grid { grid-template-columns: repeat(4, 1fr); gap: 3rem; margin-bottom: 5rem; } }

  .re-stat {
    padding-top: 1.25rem;
    border-top: 1px solid var(--glass-border);
  }
  .re-stat-val {
    display: block;
    font-family: var(--font-headline);
    font-size: clamp(1.875rem, 2.5vw + 0.5rem, 2.5rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    color: var(--text-primary);
    line-height: 1;
    margin-bottom: 0.85rem;
  }
  .re-stat-lbl {
    display: block;
    font-family: var(--font-body);
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--text-secondary);
  }

  .re-pull-quote {
    max-width: 760px;
    margin: 0;
    padding: 2rem 0 0;
    border-top: 1px solid var(--glass-border);
    font-family: var(--font-body);
    font-style: italic;
    font-size: clamp(1.0625rem, 1vw + 0.75rem, 1.3125rem);
    line-height: 1.55;
    color: var(--text-secondary);
  }
  .re-pull-quote cite {
    display: block;
    margin-top: 1rem;
    font-family: var(--font-mono);
    font-style: normal;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    color: var(--text-tertiary);
  }

  /* ========== USE CASES ========== */
  .re-use-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }
  @media (min-width: 640px)  { .re-use-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .re-use-grid { grid-template-columns: repeat(3, 1fr); gap: 2.5rem 2rem; } }

  .re-use-card {
    position: relative;
    border-radius: 14px;
    overflow: hidden;
    background: var(--surface-container-low);
    border: 1px solid var(--glass-border);
    transition: transform 0.35s ease, border-color 0.35s ease, box-shadow 0.35s ease;
  }
  .re-use-card:hover {
    transform: translateY(-3px);
    border-color: color-mix(in srgb, var(--re-accent) 30%, transparent);
    box-shadow:
      0 10px 32px rgba(0, 0, 0, 0.25),
      0 0 24px color-mix(in srgb, var(--re-accent) 8%, transparent);
  }

  .re-use-crop {
    position: relative;
    aspect-ratio: 4 / 3;
    background-image: url('/images/facility-night-aerial.webp');
    background-size: 200%;
    background-repeat: no-repeat;
    /* background-position set inline per-card */
  }
  .re-use-gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(4, 8, 14, 0.1) 0%, rgba(4, 8, 14, 0.55) 100%);
  }

  .re-use-body {
    padding: 1.5rem 1.75rem 1.75rem;
  }
  .re-use-icon {
    display: block;
    font-size: 1.5rem;
    color: var(--re-accent);
    margin-bottom: 0.875rem;
    font-variation-settings: 'FILL' 1;
  }
  .re-use-title {
    font-family: var(--font-headline);
    font-size: 1.1875rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    color: var(--text-primary);
    margin: 0 0 0.5rem;
  }
  .re-use-desc {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--text-secondary);
    margin: 0;
  }

  /* ========== PROCESS ========== */
  .re-process-timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }
  @media (min-width: 640px)  { .re-process-timeline { grid-template-columns: repeat(2, 1fr); gap: 3rem 2.5rem; } }
  @media (min-width: 1024px) { .re-process-timeline { grid-template-columns: repeat(4, 1fr); gap: 3.5rem 2.5rem; } }

  .re-step {
    padding-top: 1.25rem;
    border-top: 1px solid var(--glass-border);
  }
  .re-step-num {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    color: var(--re-accent);
    margin-bottom: 0.75rem;
  }
  .re-step-title {
    font-family: var(--font-headline);
    font-size: 1.1875rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    color: var(--text-primary);
    margin: 0 0 0.65rem;
  }
  .re-step-desc {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--text-secondary);
    margin: 0;
  }

  /* ========== TRUST ========== */
  .re-trust {
    padding: 4rem 0;
  }
  @media (min-width: 768px) { .re-trust { padding: 5rem 0; } }

  .re-trust-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    padding: 2rem;
    border: 1px solid var(--glass-border);
    border-radius: 16px;
    background: color-mix(in srgb, var(--re-accent) 3%, transparent);
  }
  @media (min-width: 640px)  { .re-trust-grid { grid-template-columns: repeat(2, 1fr); gap: 1.75rem 3rem; padding: 2.25rem 2.5rem; } }
  @media (min-width: 1024px) { .re-trust-grid { grid-template-columns: repeat(4, 1fr); gap: 2rem; padding: 2.5rem 3rem; } }

  .re-trust-label {
    display: block;
    font-family: var(--font-label);
    font-size: 0.75rem;
    font-weight: 700;
