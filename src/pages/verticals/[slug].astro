---
/*
  Vertical brief template — one template, five sectors.
  Uniqueness comes from data (copy, annotations), imagery (visible/thermal
  pairs per slug), and theme (agriculture runs on paper). Never forks.
*/
import type { ImageMetadata } from 'astro';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Nav from '../../components/ui/Nav.astro';
import Footer from '../../components/ui/Footer.astro';
import Section from '../../components/ui/Section.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import Button from '../../components/ui/Button.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import StatRow from '../../components/ui/StatRow.astro';
import Accordion from '../../components/ui/Accordion.astro';
import CTABlock from '../../components/ui/CTABlock.astro';
import LeadForm from '../../components/ui/LeadForm.astro';
import InspectionInstrument from '../../components/ui/InspectionInstrument.astro';
import AisleHeat from '../../components/scenes/AisleHeat.astro';
import HarborChart from '../../components/scenes/HarborChart.astro';
import CorridorRuler from '../../components/scenes/CorridorRuler.astro';
import PerimeterRadar from '../../components/scenes/PerimeterRadar.astro';
import NdviSweep from '../../components/scenes/NdviSweep.astro';
import LightStudy from '../../components/scenes/LightStudy.astro';

import dcVisible from '../../assets/images/dc-rooftop-aerial.webp';
import dcThermal from '../../assets/images/dc-rooftop-aerial-thermal.webp';
import energyVisible from '../../assets/images/powerline-aerial.webp';
import energyThermal from '../../assets/images/powerline-aerial-thermal.webp';
import securityVisible from '../../assets/images/facility-night-aerial.webp';
import securityThermal from '../../assets/images/facility-night-aerial-thermal.webp';
import agVisible from '../../assets/images/agriculture-fields.jpg';
import agThermal from '../../assets/images/agriculture-fields-thermal.webp';
import reVisible from '../../assets/images/luxury-lobby.webp';
import reThermal from '../../assets/images/luxury-lobby-thermal.webp';

import dcGrid from '../../data/thermal/dc-rooftop-aerial.json';
import energyGrid from '../../data/thermal/powerline-aerial.json';
import securityGrid from '../../data/thermal/facility-night-aerial.json';
import agGrid from '../../data/thermal/agriculture-fields.json';
import reGrid from '../../data/thermal/luxury-lobby.json';

export async function getStaticPaths() {
  const verticals = await getCollection('verticals');
  return verticals.map((v) => ({ params: { slug: v.id }, props: { vertical: v } }));
}

const { vertical } = Astro.props;
const d = vertical.data;

const FRAMES: Record<string, { visible: ImageMetadata; thermal: ImageMetadata; grid: any }> = {
  'data-centers': { visible: dcVisible, thermal: dcThermal, grid: dcGrid },
  'energy-grid': { visible: energyVisible, thermal: energyThermal, grid: energyGrid },
  'security': { visible: securityVisible, thermal: securityThermal, grid: securityGrid },
  'agriculture': { visible: agVisible, thermal: agThermal, grid: agGrid },
  'real-estate': { visible: reVisible, thermal: reThermal, grid: reGrid },
};
const frame = FRAMES[vertical.id];

// Dock chips: severity from finding order, title from the label's lead segment.
// Verticals without aerial photography yet (maritime) have no frame — the
// hero falls back to a drawn chart and findings stay empty.
const SEVS = ['SEV-1', 'SEV-2', 'SEV-2', 'SEV-3'] as const;
const findings = (d.frame?.annotations ?? []).map((a, i) => ({
  ...a,
  severity: SEVS[Math.min(i, SEVS.length - 1)],
  title: a.label.split('·')[0].trim(),
}));

const SCENES: Record<string, { component: any; lede: string }> = {
  'data-centers': { component: AisleHeat, lede: 'What continuous aisle-level thermal watch looks like inside your hall.' },
  'energy-grid': { component: CorridorRuler, lede: 'How a 50-mile corridor gets captured — structure by structure, one pass.' },
  'security': { component: PerimeterRadar, lede: 'What persistent watch looks like for a perimeter.' },
  'agriculture': { component: NdviSweep, lede: 'How zone-level crop health paints in across a full operation, weekly.' },
  'real-estate': { component: LightStudy, lede: 'How we plan the shot window around the light your property deserves.' },
};
const scene = SCENES[vertical.id];
const Scene = scene?.component;

// Metro pages serving this vertical — the internal-link mesh down to
// the local-intent pages (and their airspace stories).
const locations = (await getCollection('locations'))
  .filter((loc) => loc.data.verticals.some((b) => b.slug === vertical.id))
  .sort((a, b) => a.data.order - b.data.order);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: d.metaTitle,
  provider: { '@type': 'Organization', name: 'Jinki Aerial Intelligence' },
  description: d.metaDescription,
  areaServed: 'Mid-Atlantic United States',
  serviceType: d.serviceType,
};
---

<Base title={d.metaTitle} description={d.metaDescription} ogImage={d.ogImage} jsonLd={jsonLd} theme={d.theme}>
  <Nav />
  <Breadcrumb items={[{ label: 'Verticals', href: '/#verticals' }, { label: d.title }]} />
  <main id="main-content">

    <!-- HERO -->
    <section aria-label={d.title} class="pt-8 md:pt-12">
      <div class="max-w-brief mx-auto px-5 sm:px-8 lg:px-12 2xl:px-16">
        <div class="folio-rule rule-draw flex items-baseline justify-between gap-4 pt-3 mb-10">
          <span class="mono-label text-ink-3"><span class="text-signal" style={`view-transition-name: folio-${vertical.id}`}>{d.index}</span>&nbsp;/&nbsp;{d.hero.kicker}</span>
          <span class="mono-label text-ink-3">{d.hero.datum}</span>
        </div>
        <h1 class="text-h1 font-display font-medium text-ink max-w-[18ch] rise" set:html={d.hero.headline} />
        <!-- CTA lives under the pitch, not orphaned right (C3) -->
        <p class="text-lede text-ink-2 max-w-[58ch] mt-6 rise">{d.hero.sub}</p>
        <div class="flex flex-wrap items-center gap-3 mt-7 rise">
          <Button href="#lead-gen" event={`cta-assessment:hero-${vertical.id}`}>Request Q3 assessment</Button>
          <Button href="/sample-report" kind="secondary" event={`cta-sample:hero-${vertical.id}`}>See the sample report</Button>
        </div>
        <div class="mt-12 md:mt-16">
          {frame && d.frame ? (
            <InspectionInstrument
              image={frame.visible}
              thermalImage={frame.thermal}
              alt={d.frame.alt}
              findings={findings}
              caption={d.frame.caption}
              grid={frame.grid}
              loading="eager"
            />
          ) : (
            <HarborChart />
          )}
        </div>
      </div>
    </section>

    <!-- STATS -->
    <Section label="Key figures" spacing="compact" class="mt-8">
      <StatRow stats={d.stats} />
    </Section>

    <!-- SECTOR SCENE -->
    {Scene && (
      <Section label="Sector telemetry" spacing="compact" cv>
        <p class="text-lede text-ink-2 max-w-prose mb-6">{scene.lede}</p>
        <Scene />
      </Section>
    )}

    <!-- PROBLEMS -->
    <Section label="Failure modes" cv>
      <SectionHeader
        index="01" label="FAILURE MODES" datum={`${String(d.problems.length).padStart(2, '0')} NAMED`}
        title="What goes wrong here."
        lede="Every sector fails in specific, nameable ways. These are the ones we scan for."
      />
      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-6">
        {d.problems.map((p) => (
          <div class="folio-rule rule-draw pt-5 pb-6">
            <span class="mono-label text-signal block mb-2">{p.tag}</span>
            <h3 class="text-h3 font-display font-medium text-ink mb-2">{p.title}</h3>
            <p class="text-body text-ink-2">{p.body}</p>
          </div>
        ))}
      </div>
    </Section>

    <!-- CAPABILITIES -->
    <Section label="Capabilities" cv>
      <SectionHeader
        index="02" label="CAPABILITIES" datum="WHAT WE DELIVER"
        title="What the scan finds."
      />
      <ul class="list-none m-0 p-0">
        {d.capabilities.map((c, i) => (
          <li class="folio-rule rule-draw">
            <!-- xl: single row; below xl: title+datum line then body (C3:
                 the 4-col grid wrapped awkwardly in the 768-1024 band) -->
            <div class="grid grid-cols-[auto_1fr] xl:grid-cols-12 items-baseline gap-x-4 xl:gap-x-6 gap-y-1.5 py-5">
              <span class="mono-label text-ink-3 tabular xl:col-span-1">{String(i + 1).padStart(2, '0')}</span>
              <span class="flex flex-wrap items-baseline justify-between gap-x-4 xl:contents">
                <span class="font-display font-medium text-h3 text-ink xl:col-span-4">{c.title}</span>
                {c.datum && <span class="mono-label text-ink-3 xl:col-start-11 xl:col-span-2 xl:text-right xl:order-last">{c.datum}</span>}
              </span>
              <span class="text-body text-ink-2 col-start-2 xl:col-start-6 xl:col-span-5">{c.body}</span>
            </div>
          </li>
        ))}
        <li class="folio-rule" aria-hidden="true"></li>
      </ul>
    </Section>

    <!-- MID CTA -->
    <Section label="Engage" spacing="compact">
      <CTABlock
        title={d.midCta.title}
        body={d.midCta.body}
        primary={{ label: 'Request Q3 assessment', href: '#lead-gen', event: `cta-assessment:mid-${vertical.id}` }}
        secondary={{ label: 'See the sample report', href: '/sample-report', kind: 'secondary', event: `cta-sample:mid-${vertical.id}` }}
      />
    </Section>

    <!-- FAQ -->
    <Section label="Questions" cv>
      <SectionHeader
        index="03" label="QUESTIONS" datum={`${String(d.faqs.length).padStart(2, '0')} ANSWERED`}
        title="Asked before engaging."
      />
      <Accordion items={d.faqs} jsonLd />
    </Section>

    <!-- METROS SERVING THIS VERTICAL -->
    {locations.length > 0 && (
      <Section label="Where we fly this" spacing="compact" cv>
        <div class="folio-rule rule-draw flex flex-wrap items-baseline gap-x-6 gap-y-3 pt-5 pb-2">
          <span class="mono-label text-ink-3">{d.title.toUpperCase()} BY METRO</span>
          {locations.map((loc) => (
            <a href={`/locations/${loc.id}/${vertical.id}`} class="mono-label text-signal-soft no-underline hover:text-signal transition-colors">
              {loc.data.title.toUpperCase()}&nbsp;→
            </a>
          ))}
        </div>
      </Section>
    )}

    <LeadForm context={`/verticals/${vertical.id}`} />

  </main>
  <Footer />
</Base>
