---
/*
  Terms of Service — Intelligence Brief shell. Quiet utility page:
  folio line, mono TOC jump row, numbered clause sections.
  Legal text carried over verbatim from the previous build.
*/
import Base from '../layouts/Base.astro';
import Nav from '../components/ui/Nav.astro';
import Footer from '../components/ui/Footer.astro';
import Section from '../components/ui/Section.astro';
import Breadcrumb from '../components/ui/Breadcrumb.astro';

const lastUpdated = 'MARCH 15, 2026';

const sections = [
  {
    id: 'acceptance',
    title: 'Acceptance of Terms',
    content: [
      'By accessing or using the services provided by Jinki Aerial Intelligence ("Jinki," "we," "us," or "our"), including the website at jinki.ai and all related aerial intelligence services, you agree to be bound by these Terms of Service. If you do not agree to these terms, you must not access or use our services.',
    ],
  },
  {
    id: 'services',
    title: 'Description of Services',
    content: [
      'Jinki provides aerial intelligence services for critical infrastructure, including but not limited to: infrastructure inspection, thermal imaging and analysis, data center monitoring, perimeter security assessment, and agricultural surveying. Our deliverables consist of data products, analytical reports, and actionable recommendations derived from aerial operations. Jinki is an aerial intelligence firm — we provide data-driven insights, not hardware.',
    ],
  },
  {
    id: 'responsibilities',
    title: 'User Responsibilities',
    content: [
      'You agree to: (a) provide accurate and complete information when engaging our services; (b) comply with all applicable local, state, and federal laws and regulations; (c) not interfere with or disrupt the integrity or performance of our services; (d) not attempt to gain unauthorized access to our systems or data; and (e) use all deliverables, reports, and data products solely for their intended lawful purpose.',
    ],
  },
  {
    id: 'ip',
    title: 'Intellectual Property',
    content: [
      'All content, methodologies, software, analytical frameworks, reports, and materials provided by Jinki are protected by intellectual property laws. Jinki retains all rights, title, and interest in its proprietary technology, processes, and analytical methods. Clients receive a limited, non-exclusive, non-transferable license to use deliverables for their internal business purposes only. You may not reproduce, distribute, or create derivative works from our proprietary materials without prior written consent.',
    ],
  },
  {
    id: 'confidentiality',
    title: 'Confidentiality',
    content: [
      'Both parties agree to maintain the confidentiality of any proprietary or sensitive information exchanged during the course of engagement. This includes, but is not limited to, facility data, inspection findings, security assessments, and infrastructure details. Confidential information shall not be disclosed to third parties without prior written consent, except as required by law. This obligation survives the termination of any service agreement.',
    ],
  },
  {
    id: 'liability',
    title: 'Limitation of Liability',
    content: [
      'To the maximum extent permitted by applicable law, Jinki shall not be liable for any indirect, incidental, special, consequential, or punitive damages, including but not limited to loss of profits, data, or business opportunities, arising out of or related to your use of our services. Our total liability for any claim arising from these terms or our services shall not exceed the fees paid by you for the specific service giving rise to the claim. Our services provide intelligence and recommendations — operational decisions remain the sole responsibility of the client.',
    ],
  },
  {
    id: 'indemnification',
    title: 'Indemnification',
    content: [
      'You agree to indemnify, defend, and hold harmless Jinki Aerial Intelligence, its officers, directors, employees, and agents from and against any claims, liabilities, damages, losses, and expenses (including reasonable attorneys\' fees) arising out of or in any way connected with: (a) your use of our services; (b) your violation of these terms; (c) your violation of any third-party rights; or (d) any operational decisions made based on our deliverables or recommendations.',
    ],
  },
  {
    id: 'governing-law',
    title: 'Governing Law',
    content: [
      'These Terms of Service shall be governed by and construed in accordance with the laws of the Commonwealth of Virginia, United States, without regard to its conflict of law provisions. Any disputes arising under or in connection with these terms shall be subject to the exclusive jurisdiction of the state and federal courts located in Virginia.',
    ],
  },
  {
    id: 'termination',
    title: 'Termination',
    content: [
      'Jinki reserves the right to suspend or terminate your access to our services at any time, with or without cause, upon reasonable notice. Upon termination, your right to use our services ceases immediately. Provisions that by their nature should survive termination — including intellectual property, confidentiality, limitation of liability, indemnification, and governing law — shall remain in effect.',
    ],
  },
  {
    id: 'changes',
    title: 'Changes to Terms',
    content: [
      'We reserve the right to modify these Terms of Service at any time. Material changes will be communicated through our website or via direct notice to active clients. Your continued use of our services following any modifications constitutes acceptance of the revised terms. We encourage you to review these terms periodically.',
    ],
  },
  {
    id: 'contact',
    title: 'Contact',
    content: [
      'If you have questions about these Terms of Service, please contact us:',
    ],
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Terms of Service',
  description: 'Terms of Service for Jinki Aerial Intelligence services and website.',
  publisher: { '@type': 'Organization', name: 'Jinki Aerial Intelligence' },
};
---

<Base
  title="Terms of Service — Jinki Aerial Intelligence"
  description="Terms of Service governing the use of Jinki Aerial Intelligence services and website."
  jsonLd={jsonLd}
>
  <Nav />
  <Breadcrumb items={[{ label: 'Terms of Service' }]} />
  <main id="main-content">

    <Section width="prose" label="Terms of Service" class="pt-10 md:pt-14">
      <div class="folio-rule rule-draw flex flex-wrap items-baseline justify-between gap-x-4 gap-y-2 pt-3 mb-10">
        <span class="mono-label text-ink-3"><span class="text-signal">TM</span>&nbsp;/&nbsp;TERMS OF SERVICE</span>
        <span class="mono-label text-ink-3">LAST UPDATED · {lastUpdated}</span>
      </div>

      <h1 class="text-h2 font-display font-medium text-ink rise">Terms of Service</h1>
      <p class="text-body text-ink-2 mt-4 max-w-[58ch] rise">
        These terms govern your use of Jinki Aerial Intelligence services.
      </p>

      <nav aria-label="On this page" class="mt-8 rise">
        <ol class="flex flex-wrap gap-x-5 gap-y-2.5 list-none p-0 m-0">
          {sections.map((s, i) => (
            <li>
              <a href={`#${s.id}`} class="mono-label text-ink-3 no-underline hover:text-ink">
                <span class="text-signal-soft tabular">{String(i + 1).padStart(2, '0')}</span>
                &nbsp;{s.title}
              </a>
            </li>
          ))}
        </ol>
      </nav>

      <div class="mt-12">
        {sections.map((s, i) => (
          <section id={s.id} class="folio-rule rule-draw pt-5 pb-10 scroll-mt-24">
            <span class="mono-label text-signal-soft tabular">{String(i + 1).padStart(2, '0')}</span>
            <h2 class="text-h3 font-display font-medium text-ink mt-2 mb-3">{s.title}</h2>
            {s.content.map((para) => (
              <p class="text-body text-ink-2 mt-4 first-of-type:mt-0">{para}</p>
            ))}
            {s.id === 'contact' && (
              <div class="mt-6">
                <a href="mailto:info@jinki.ai" class="mono-label text-ink no-underline link-draw">INFO@JINKI.AI</a>
                <p class="text-caption text-ink-3 mt-4">Jinki Aerial Intelligence<br />Virginia, United States</p>
              </div>
            )}
          </section>
        ))}
      </div>
    </Section>

  </main>
  <Footer />
</Base>
